---
import companyRaw from '@data/global/company.json';
import type { CompanyConfig } from '@/types/config';

const company = companyRaw as CompanyConfig;

interface Props {
	variant?: "light" | "dark" | "inherit";
	showText?: boolean;
	className?: string;
	/** `compact`, mniejsza ikona i typografia pod pasek nav */
	density?: "default" | "compact";
}

const { variant = "dark", showText = true, className = "", density = "default" } = Astro.props;

/** Temporarily disabled — for tagline / company.branding.tagline */
const showTagline = false;

// Why: logo is always an image (client uploads own file via CMS).
// Fallback is default /logo.svg generated from icon at build time.
const logoPath = company.branding.logoImage || '/logo.svg';
---

<div class={`flex items-center ${density === "compact" ? "gap-2" : "gap-3"} ${className}`}>
  <img
    src={logoPath}
    alt={`${company.name} ${company.branding.logoSuffix || ""}`}
    width="512"
    height="512"
    loading="eager"
    class={density === "compact" ? "h-9 w-auto object-contain lg:h-11" : "h-10 lg:h-12 w-auto object-contain"}
  />
</div>
