---
import headerData from "@data/navigation/header.json";

interface Props {
	mobileOnly?: boolean;
}

const { mobileOnly = true } = Astro.props;
---

<button
	type="button"
	data-navbar-toggle
	class:list={["ui-nav-menu-toggle", mobileOnly && "lg:hidden"]}
	aria-controls="site-nav-drawer"
	aria-expanded="false"
	aria-label={headerData.aria.menuOpen}
>
	<span class="ui-nav-menu-toggle__bar" aria-hidden="true"></span>
	<span class="ui-nav-menu-toggle__bar" aria-hidden="true"></span>
	<span class="ui-nav-menu-toggle__bar" aria-hidden="true"></span>
</button>
