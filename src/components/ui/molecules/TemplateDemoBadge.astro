---
interface Props {
  name: string;
  slug: string;
  locale?: "pl" | "en";
}

const { name, slug, locale = "pl" } = Astro.props as Props;

const copy = {
  pl: {
    label: `Szablon ${name} od WebScale`,
    codeLabel: "Kod źródłowy",
    codeHref: `https://webscale.pl/szablony-astro/${slug}/`,
    setupLabel: "Wdrożymy ją dla Twojej firmy",
    setupHref: `https://webscale.pl/gotowe-strony/${slug}/`,
    closeLabel: "Zamknij",
  },
  en: {
    label: `${name} template by WebScale`,
    codeLabel: "Source code",
    codeHref: `https://webscale.pl/en/astro-templates/${slug}/`,
    setupLabel: "We'll set it up for your business",
    setupHref: `https://webscale.pl/en/ready-made-websites/${slug}/`,
    closeLabel: "Close",
  },
}[locale];

const utm = `?utm_source=${slug}-demo&utm_medium=demo-badge&utm_campaign=template-demo`;
---

<aside
  data-template-demo-badge
  aria-label={copy.label}
  class="fixed bottom-4 left-4 z-[1900] hidden items-center gap-1 rounded-full bg-brand-dark p-1.5 text-xs ring-1 ring-brand-light/15 text-brand-light shadow-[0_12px_32px_rgba(0,0,0,0.22)] sm:bottom-5 sm:left-1/2 sm:-translate-x-1/2 sm:pl-4"
>
  <p class="hidden whitespace-nowrap pr-2 text-brand-light/70 sm:block">{copy.label}</p>
  <a
    href={copy.codeHref + utm}
    target="_blank"
    rel="noreferrer"
    data-analytics-event="template_github_click"
    data-analytics-location="template_demo_badge"
    class="hidden whitespace-nowrap rounded-full px-3 py-2 text-brand-light/85 transition-colors hover:bg-brand-light/10 hover:text-brand-light sm:inline-flex"
  >{copy.codeLabel}</a>
  <a
    href={copy.setupHref + utm}
    target="_blank"
    rel="noreferrer"
    data-analytics-event="template_customization_click"
    data-analytics-location="template_demo_badge"
    class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-brand-accent px-3.5 py-2 font-semibold text-brand-dark transition-colors hover:bg-brand-light"
  >
    {copy.setupLabel}
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>
  <button
    type="button"
    data-template-demo-badge-close
    aria-label={copy.closeLabel}
    class="inline-flex size-8 shrink-0 items-center justify-center rounded-full text-brand-light/60 transition-colors hover:bg-brand-light/10 hover:text-brand-light"
  >
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
  </button>
</aside>

<script is:inline>
  (() => {
    const badge = document.querySelector("[data-template-demo-badge]");
    if (!badge) return;
    // Dlaczego: w podglądzie na webscale.pl demo siedzi w iframe i pigułka dublowałaby CTA strony nadrzędnej.
    let framed = true;
    try { framed = window.self !== window.top; } catch { framed = true; }
    const storageKey = "template-demo-badge-closed";
    let closed = false;
    try { closed = sessionStorage.getItem(storageKey) === "1"; } catch {}
    if (framed || closed) return;
    badge.classList.replace("hidden", "flex");
    badge.querySelector("[data-template-demo-badge-close]")?.addEventListener("click", () => {
      badge.classList.replace("flex", "hidden");
      try { sessionStorage.setItem(storageKey, "1"); } catch {}
    });
  })();
</script>
