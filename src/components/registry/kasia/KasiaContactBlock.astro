---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import FormStatus from "@components/ui/patterns/FormStatus.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import jsonData from "@data/sections/kasia-contact.json";

export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string; }
const { data: overrideData, sectionId = "kasia-kontakt", class: className = "" } = Astro.props as Props;
const t = overrideData ?? jsonData;
---
<Section id={sectionId} tone="base" class={className}><Container><div class="grid items-center gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16"><div class="relative flex min-h-80 items-end justify-center overflow-hidden rounded-2xl bg-brand-primary/5"><SmartImage src={t.image.src} alt={t.image.alt} width={720} height={900} class="h-full w-full object-contain object-bottom drop-shadow-2xl" /></div><div class="rounded-2xl border border-brand-dark/10 bg-white/80 p-7 shadow-[var(--ui-elevation-soft)] md:p-10"><Text variant="accent-label" class="mb-4 text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-lg" class="text-brand-dark">{t.title} <span class="text-brand-primary">{t.titleAccent}</span></Heading><Text variant="lead" class="mt-4 text-brand-dark/65">{t.description}</Text><form data-kasia-contact data-contact-form action="/send-form.php" method="POST" data-form-msg-original={t.fields.submit} data-form-msg-loading={t.fields.loading} data-form-msg-success={t.fields.success} data-form-msg-error={t.fields.error} class="mt-8 space-y-5"><label class="block"><span class="ui-type-accent-label mb-2 block text-brand-dark/55">{t.fields.name}</span><input required name="name" class="ui-form-input" /></label><label class="block"><span class="ui-type-accent-label mb-2 block text-brand-dark/55">{t.fields.email}</span><input required type="email" name="email" class="ui-form-input" /></label><label class="block"><span class="ui-type-accent-label mb-2 block text-brand-dark/55">{t.fields.message}</span><textarea required name="message" rows="4" class="ui-form-textarea"></textarea></label><button type="submit" class="ui-button ui-button-primary ui-type-cta-label font-semibold text-sm sm:text-base w-full">{t.fields.submit}</button><div class="hidden" data-form-feedback="success" tabindex="-1"><FormStatus type="success" title={t.fields.successTitle} description={t.fields.success} /></div><div class="hidden" data-form-feedback="error" tabindex="-1"><FormStatus type="error" title={t.fields.errorTitle} description={t.fields.error} /></div><div class="hidden" data-form-feedback="loading" tabindex="-1"><FormStatus type="loading" title={t.fields.loadingTitle} description={t.fields.loading} /></div></form></div></div></Container></Section>
