---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import jsonData from "@data/sections/kasia-results-slider.json";

export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string; }
const { data: overrideData, sectionId = "kasia-rezultaty", class: className = "" } = Astro.props as Props;
const t = overrideData ?? jsonData;
---
<Section id={sectionId} tone="base" class={className}><Container><div class="mx-auto mb-10 max-w-2xl text-center"><Text variant="accent-label" class="mb-4 text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-lg" class="text-brand-dark">{t.title} <span class="text-brand-primary">{t.titleAccent}</span></Heading><Text variant="lead" class="mt-4 text-brand-dark/65">{t.description}</Text></div><div data-kasia-results-slider class="relative mx-auto aspect-[16/10] max-w-4xl overflow-hidden rounded-2xl bg-brand-dark/5 shadow-[var(--ui-elevation-strong)]"><SmartImage src={t.before.src} alt={t.before.alt} width={1200} height={750} class="absolute inset-0 h-full w-full object-cover" /><div data-kasia-results-after class="absolute inset-y-0 left-0 w-1/2 overflow-hidden border-r-2 border-white"><SmartImage src={t.after.src} alt={t.after.alt} width={1200} height={750} class="h-full w-[200%] max-w-none object-cover" /></div><input data-kasia-results-input type="range" min="0" max="100" value="50" aria-label="Porównaj rezultat" class="absolute inset-x-5 bottom-5 z-10 h-2 w-[calc(100%-2.5rem)] accent-brand-primary" /><div class="absolute bottom-16 left-5 rounded-full bg-brand-dark/70 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-white">{t.before.label}</div><div class="absolute bottom-16 right-5 rounded-full bg-brand-primary/80 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-white">{t.after.label}</div></div></Container></Section>
<script is:inline data-astro-rerun src="/js/kasia-results-slider.js"></script>
