---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import jsonData from "@data/sections/kasia-offer.json";
import { formatInternalLink } from "@utils/url";
export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string; }
const { data: overrideData, sectionId = "kasia-oferta", class: className = "" } = Astro.props as Props;
const t = overrideData ?? jsonData;
---
<Section id={sectionId} tone="page" class:list={["relative", className]}><Container><div class="mx-auto mb-12 max-w-3xl text-center"><Text variant="accent-label" class="mb-4 text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-lg" class="text-brand-dark">{t.title} <span class="text-brand-primary">{t.titleAccent}</span></Heading><Text variant="lead" class="mx-auto mt-4 max-w-2xl text-brand-dark/65">{t.description}</Text></div><div class="mx-auto grid max-w-6xl items-stretch gap-6 md:grid-cols-3">{t.items.map((item, index) => <article class:list={["group relative flex w-full flex-col overflow-hidden rounded-[2.5rem] border p-8", item.featured ? "scale-[1.02] border-brand-dark bg-brand-dark text-white shadow-[var(--ui-elevation-strong)]" : "ui-card-interactive border-brand-primary/10 bg-white"]}><div class="relative z-10 mb-6"><Heading tag="h3" level={3} variant="section-heading-lg" class:list={["mt-2 text-3xl", item.featured ? "text-white" : "text-brand-dark"]}>{item.name}</Heading><Text variant="accent-label" class:list={["mt-2", item.featured ? "text-white/70" : "text-brand-dark/55"]}>{item.subtitle}</Text></div><Text variant="body" class:list={["relative z-10 mb-8", item.featured ? "text-white/80" : "text-brand-dark/65"]}>{item.description}</Text><ul class="relative z-10 mb-4 flex-1 space-y-4">{item.features.map((feature) => <li class="flex items-start gap-3 text-sm"><span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand-primary"></span><span class:list={[item.featured ? "text-white/90" : "text-brand-dark/80"]}>{feature}</span></li>)}</ul><div class="relative z-10 mt-8 border-t border-brand-primary/15 pt-6"><Button href={formatInternalLink(item.href)} variant={item.featured ? "accent" : "outline"} class="w-full rounded-full py-5 text-xs uppercase tracking-[0.2em]">{item.cta}</Button></div>{item.featured && <div class="pointer-events-none absolute inset-0"><div class="absolute -right-20 -top-20 size-64 rounded-full bg-brand-primary/15 blur-3xl"></div><div class="absolute -bottom-20 -left-20 size-64 rounded-full bg-brand-primary/10 blur-3xl"></div></div>}</article>)}</div><Text tag="p" variant="disclaimer" class="mx-auto mt-16 max-w-2xl text-center italic text-brand-dark/55">{t.note}</Text></Container></Section>
