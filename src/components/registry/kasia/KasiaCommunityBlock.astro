---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import jsonData from "@data/sections/kasia-community.json";
export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string; }
const { data: overrideData, sectionId = "kasia-spolecznosc", class: className = "" } = Astro.props as Props;
const t = overrideData ?? jsonData;
---
<Section id={sectionId} tone="base" class:list={["relative overflow-hidden bg-white/30", className]}><Container><div class="mx-auto mb-12 max-w-3xl text-center"><Text variant="accent-label" class="mb-4 text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-lg" class="text-brand-dark">{t.title} <span class="text-brand-primary">{t.titleAccent}</span></Heading><Text variant="lead" class="mx-auto mt-4 max-w-2xl text-brand-dark/65">{t.description}</Text></div><div class="mx-auto grid max-w-6xl grid-cols-1 gap-4 md:h-[31rem] md:grid-cols-3 md:gap-6">{t.items.map((item, index) => <article class:list={["group relative min-h-72 overflow-hidden rounded-[2rem] shadow-[var(--ui-elevation-strong)] md:min-h-0", item.span]}><SmartImage src={item.src} alt={item.alt} width={1200} height={800} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" /><div class="absolute inset-0 bg-gradient-to-t from-brand-dark/85 via-brand-dark/20 to-transparent opacity-80 transition-opacity duration-500 group-hover:opacity-95"></div><div class="absolute bottom-0 left-0 p-8 text-white"><Text variant="accent-label" class="mb-2 text-brand-primary">{item.label}</Text><Heading tag="h3" level={3} variant="feature-heading-md" class="text-white">{item.title}</Heading></div></article>)}</div></Container></Section>
