---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import jsonData from "@data/sections/kasia-hero.json";
import { formatInternalLink } from "@utils/url";

export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string; }
const { data: overrideData, sectionId = "kasia-hero", class: className = "" } = Astro.props as Props;
const t = overrideData ?? jsonData;
---
<Section id={sectionId} tone="page" class:list={["relative min-h-[85vh] overflow-hidden !pt-0", className]}>
  <div class="absolute inset-0 -z-0 flex items-center justify-center" aria-hidden="true"><div class="size-[36rem] rounded-full bg-brand-primary/10 blur-[7rem]"></div></div>
  <div class="relative z-0 mt-24 flex max-h-[72vh] w-full flex-col items-center md:hidden"><img src={t.watermark} alt="" width="700" height="700" class="absolute left-1/2 top-[40%] h-auto w-[140%] -translate-x-1/2 -translate-y-1/2 opacity-30" aria-hidden="true" /><SmartImage src={t.mobileImage?.src ?? t.image.src} alt={t.mobileImage?.alt ?? t.image.alt} width={720} height={900} class="hero-mask-mobile h-full w-full object-cover object-top drop-shadow-xl" loading="eager" /></div>
  <Container class="relative z-10 w-full">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="order-2 -mt-10 space-y-6 text-center md:order-1 md:mt-0 md:space-y-8 md:text-left">
        <Text variant="accent-label" class="hidden text-brand-primary md:block">{t.eyebrow}</Text> <!-- mobile-audit-ignore -->
        <Heading tag="h1" level={1} variant="hero" class="relative z-10 mx-4 text-balance text-brand-dark md:mx-0">{t.titleBefore} <span class="italic text-brand-primary">{t.titleAccent}</span> {t.titleMiddle} <span class="relative inline-block">{t.titleAfter}<span class="absolute bottom-1 left-0 -z-10 h-2 w-full bg-brand-primary/10"></span></span></Heading>
        <Text variant="lead" tag="p" class="hidden font-heading text-xl italic text-brand-dark/70 md:block">{t.motto}</Text> <!-- mobile-audit-ignore -->
        <Text variant="lead" class="relative z-20 mx-auto max-w-xl px-4 italic text-brand-dark/75 md:mx-0 md:px-0">{t.description}</Text>
        <div class="relative z-20 flex flex-col items-center justify-center gap-4 px-4 sm:flex-row md:justify-start md:px-0"><Button href={formatInternalLink(t.primaryCta.href)} variant="primary" size="lg" class="w-full sm:w-auto">{t.primaryCta.label}</Button><Button href={formatInternalLink(t.secondaryCta.href)} variant="outline" size="lg" class="hidden w-full sm:w-auto md:inline-flex">{t.secondaryCta.label}</Button></div> <!-- mobile-audit-ignore -->
        <div class="hidden items-center gap-4 text-left md:flex"><div class="flex -space-x-3">{[1,2,3].map(() => <img src="/assets/placeholders/image-square.svg" alt="" width="40" height="40" class="size-10 rounded-full border-2 border-white object-cover shadow-md" aria-hidden="true" />)}<span class="flex size-10 items-center justify-center rounded-full border-2 border-white bg-brand-primary text-xs font-bold text-white">★</span></div><div><div class="flex gap-0.5 text-brand-primary" aria-label="5 na 5 gwiazdek">{[1,2,3,4,5].map(() => <span aria-hidden="true">★</span>)}</div><Text variant="feature-body-sm" class="text-brand-dark/60"><strong class="text-brand-dark">{t.socialProof.strong}</strong> {t.socialProof.text}</Text></div></div> <!-- mobile-audit-ignore -->
        <div class="space-y-2 pt-8 md:hidden"><Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text><Text variant="lead" tag="p" class="font-heading italic text-brand-dark/70">{t.motto}</Text></div>
      </div>
      <div class="relative order-1 hidden justify-end md:flex"><div class="absolute left-1/2 top-1/2 size-[90%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-primary/15 blur-[5rem]" aria-hidden="true"></div><div class="relative flex h-[38rem] w-full max-w-[34rem] items-end justify-center"><img src={t.watermark} alt="" width="700" height="700" class="absolute left-[70%] top-1/2 h-auto w-[90%] max-w-[25rem] -translate-x-1/2 -translate-y-1/2 opacity-25" aria-hidden="true" /><SmartImage src={t.image.src} alt={t.image.alt} width={720} height={900} class="hero-mask-desktop h-full w-full object-contain object-top drop-shadow-2xl" loading="eager" /></div></div> <!-- mobile-audit-ignore -->
    </div>
  </Container>
</Section>
<style>
  .hero-mask-mobile,.hero-mask-desktop { mask-image: linear-gradient(to bottom, black 88%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 88%, transparent 100%); }
</style>
