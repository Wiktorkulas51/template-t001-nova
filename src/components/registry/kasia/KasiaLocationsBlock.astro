---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import jsonData from "@data/sections/kasia-locations.json";

export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string; }
const { data: overrideData, sectionId = "kasia-lokalizacje", class: className = "" } = Astro.props as Props;
const t = overrideData ?? jsonData;
---
<Section id={sectionId} tone="page" class={className}><Container><div class="mx-auto mb-10 max-w-2xl text-center"><Text variant="accent-label" class="mb-4 text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-lg" class="text-brand-dark">{t.title} <span class="text-brand-primary">{t.titleAccent}</span></Heading><Text variant="lead" class="mt-4 text-brand-dark/65">{t.description}</Text></div><div class="grid gap-5 md:grid-cols-2">{t.items.map((item) => <article class="rounded-2xl border border-brand-dark/10 bg-white/80 p-7 shadow-[var(--ui-elevation-soft)]"><div class="mb-6 flex size-12 items-center justify-center rounded-xl bg-brand-primary/10 text-brand-primary"><Icon name="map-pin" size="1.35rem" /></div><Heading tag="h3" level={3} variant="feature-title" class="text-brand-dark">{item.name}</Heading><Text tag="p" variant="feature-body-sm" class="mt-3 font-semibold text-brand-dark/75">{item.address}</Text><Text variant="feature-body-sm" class="mt-2 text-brand-dark/55">{item.details}</Text><a href={item.href} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex min-h-[44px] items-center text-sm font-bold uppercase tracking-[0.12em] text-brand-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-primary">{t.mapLabel}</a></article>)}</div></Container></Section>
