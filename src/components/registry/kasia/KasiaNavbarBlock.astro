---
// Why: The layout retains the client's floating glass navbar, but the content and logo
// are neutral and the colors use only Starter Kit tokens.
import Button from "@components/ui/atoms/Button.astro";
import { formatInternalLink } from "@utils/url";
import data from "@data/sections/kasia-navbar.json";

type NavData = (typeof data)["pl"];

export interface Props {
  data?: NavData;
  locale?: "pl" | "en";
  class?: string;
}

const { data: overrideData, locale = "pl", class: className = "" } = Astro.props as Props;
const t = overrideData ?? data[locale] ?? data.pl;
---

<header
  data-kasia-navbar
  class:list={["fixed inset-x-0 top-0 z-[100] py-3 transition-[padding] duration-300 md:py-6", className]}
>
  <div class="ui-container relative z-[110] px-4">
    <div class="mx-auto max-w-6xl rounded-full border border-white/40 bg-white/70 px-5 py-2 shadow-[var(--ui-elevation-strong)] backdrop-blur-xl md:px-8 md:py-3">
        <div class="hidden w-full items-center justify-between lg:flex"> <!-- mobile-audit-ignore -->
        <a href={formatInternalLink("/")} class="flex shrink-0 items-center gap-3 transition-transform hover:scale-105" aria-label={t.logoAlt}>
          <img src={t.logoSrc} alt={t.logoAlt} width="180" height="48" class="h-10 w-auto object-contain" loading="eager" />
          <span class="ui-type-cta-label uppercase tracking-[0.16em] text-brand-dark">{t.brandName} <span class="text-brand-primary">{t.brandAccent}</span></span>
        </a>

        <nav aria-label={t.navLabel} class="flex items-center gap-8 xl:gap-10">
          {t.links.map((link) => (
            <a href={formatInternalLink(link.href)} class="ui-type-nav-link text-brand-dark/70 transition-colors hover:text-brand-accent">{link.label}</a>
          ))}
        </nav>

        <Button href={t.cta.href} variant="accent" size="sm" class="rounded-full px-6 uppercase tracking-wider">{t.cta.label}</Button>
      </div>

      <div class="grid grid-cols-3 items-center lg:hidden">
        <div></div>
        <a href={formatInternalLink("/")} class="mx-auto flex items-center justify-center transition-transform hover:scale-105" aria-label={t.logoAlt}>
          <img src={t.logoSrc} alt={t.logoAlt} width="180" height="48" class="h-9 w-auto object-contain" loading="eager" />
        </a>
        <button data-kasia-navbar-toggle type="button" class="ml-auto flex size-11 items-center justify-center rounded-full text-brand-dark transition-colors hover:bg-brand-dark/10 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/50" aria-label={t.menuToggleLabel} aria-controls="kasia-navbar-drawer" aria-expanded="false">
          <span class="flex w-5 flex-col gap-1.5" aria-hidden="true"><span data-kasia-line="1" class="h-px w-full rounded-full bg-current transition-transform duration-300"></span><span data-kasia-line="2" class="h-px w-full rounded-full bg-current transition-transform duration-300"></span></span>
        </button>
      </div>
    </div>
  </div>

  <div id="kasia-navbar-drawer" data-kasia-navbar-drawer class="invisible fixed inset-0 z-[90] translate-x-full bg-brand-light/95 px-6 pt-32 opacity-0 backdrop-blur-md transition-[transform,opacity,visibility] duration-500 lg:hidden" aria-hidden="true">
    <nav aria-label={t.navLabel} class="flex flex-col items-center gap-6 text-center">
      {t.links.map((link) => (
        <a data-kasia-navbar-link href={formatInternalLink(link.href)} class="ui-type-cta-label text-brand-dark transition-colors hover:text-brand-accent">{link.label}</a>
      ))}
      <Button data-kasia-navbar-link href={t.cta.href} variant="accent" size="lg" class="rounded-full uppercase tracking-wider">{t.cta.label}</Button>
    </nav>
  </div>
</header>

<script is:inline data-astro-rerun src="/js/kasia-navbar.js"></script>

<style>
  /* Why: A separate class allows the script to reduce the spacing without changing it
     global navbar rules in the Starter Kit.*/
  [data-kasia-navbar].is-compact { padding-top: 0.25rem; padding-bottom: 0.25rem; }
  @media (min-width: 768px) {
    [data-kasia-navbar].is-compact { padding-top: 0.75rem; padding-bottom: 0.75rem; }
  }
  [data-kasia-navbar-drawer].is-open { visibility: visible; transform: translateX(0); opacity: 1; pointer-events: auto; }
  [data-kasia-navbar-drawer] { pointer-events: none; }
  [data-kasia-navbar] [data-kasia-line="1"].is-open { transform: translateY(4px) rotate(45deg); }
  [data-kasia-navbar] [data-kasia-line="2"].is-open { transform: translateY(-4px) rotate(-45deg); }
</style>
