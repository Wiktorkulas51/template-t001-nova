---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import jsonData from "@data/sections/kasia-first-step.json";
export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string; }
const { data: overrideData, sectionId = "kasia-pierwszy-krok", class: className = "" } = Astro.props as Props;
const t = overrideData ?? jsonData;
---
<Section id={sectionId} tone="base" class:list={["relative overflow-hidden !pt-0 md:!py-20", className]}><Container class="relative z-10"><div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2 lg:gap-16"><div class="relative order-1"><div class="absolute left-1/2 top-1/2 size-[75%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-primary/15 blur-[5rem]" aria-hidden="true"></div><div class="relative mx-auto mt-4 h-[37rem] w-full max-w-[27rem] md:mt-0"><SmartImage src={t.image.src} alt={t.image.alt} width={720} height={900} class="first-step-mask h-full w-full object-contain object-top drop-shadow-2xl" /></div></div><div class="order-2 space-y-8 text-center md:text-left"><Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-lg" class="text-brand-dark">{t.title} <span class="text-brand-primary">{t.titleAccent}</span></Heading><div class="space-y-6 text-brand-dark/70">{t.paragraphs.map((paragraph, index) => <Text variant={index === 1 ? "lead" : "body"} class:list={[index === 1 && "font-semibold italic text-brand-dark"]}>{paragraph}</Text>)}</div><ul class="space-y-4 pt-2">{t.checks.map((check) => <li class="flex items-start gap-3 text-left text-sm font-semibold text-brand-dark/75"><span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-primary/10 text-brand-primary"><Icon name="check" size="0.9rem" /></span>{check}</li>)}</ul></div></div></Container></Section>
<style>.first-step-mask { mask-image: linear-gradient(to bottom, black 0%, black 70%, transparent 92%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 70%, transparent 92%); }</style>
