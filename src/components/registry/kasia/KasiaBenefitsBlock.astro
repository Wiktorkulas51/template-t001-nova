---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import jsonData from "@data/sections/kasia-benefits.json";
export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string; }
const { data: overrideData, sectionId = "kasia-korzysci", class: className = "" } = Astro.props as Props;
const t = overrideData ?? jsonData;
---
<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}><Container><div class="mx-auto mb-12 max-w-3xl text-center"><Text variant="accent-label" class="mb-4 italic text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-lg" class="text-brand-dark">{t.title} <span class="text-brand-primary">{t.titleAccent}</span></Heading></div><div class="mx-auto grid max-w-5xl items-stretch gap-6 md:grid-cols-2 md:gap-8">{t.items.map((item, index) => <article class="group relative flex min-h-56 flex-col overflow-hidden rounded-[2rem] border border-brand-primary/10 bg-white/70 p-8 shadow-[var(--ui-elevation-soft)] ui-card-interactive"><div class="absolute -right-12 -top-12 size-40 rounded-full bg-brand-primary/5 blur-2xl transition-transform duration-500 group-hover:scale-125" aria-hidden="true"></div><div class="relative z-10 mb-7 flex size-12 items-center justify-center rounded-xl bg-brand-primary/10 text-brand-primary transition-colors duration-500 group-hover:bg-brand-primary group-hover:text-white"><Icon name={item.icon} size="1.35rem" /></div><Heading tag="h3" level={3} variant="feature-title" class="relative z-10 text-brand-dark">{item.title}</Heading><Text variant="feature-body-sm" class="relative z-10 mt-3 max-w-md leading-relaxed text-brand-dark/65">{item.description}</Text></article>)}</div></Container></Section>
