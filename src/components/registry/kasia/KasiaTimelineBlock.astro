---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/kasia-timeline.json";
export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string; }
const { data: overrideData, sectionId = "kasia-proces", class: className = "" } = Astro.props as Props;
const t = overrideData ?? jsonData;
---
<Section id={sectionId} tone="page" class:list={["relative overflow-hidden", className]}><Container><div class="mx-auto mb-16 max-w-3xl space-y-4 text-center"><Text variant="accent-label" class="italic text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-lg" class="text-brand-dark">{t.title} <span class="text-brand-primary">{t.titleAccent}</span></Heading><Text variant="lead" class="mx-auto max-w-xl text-brand-dark/65">{t.description}</Text></div><div data-kasia-timeline class="ui-card mx-auto max-w-4xl p-6 md:p-12"><Heading tag="h3" level={3} variant="feature-heading-md" class="mb-12 text-center text-brand-dark">{t.cardTitle}</Heading><div class="relative"><div class="absolute bottom-4 left-5 top-4 w-0.5 rounded-full bg-brand-primary/10 md:left-8"></div><div data-kasia-timeline-progress class="absolute left-5 top-5 w-0.5 origin-top rounded-full bg-brand-primary transition-[height] duration-500 md:left-8" style="height:0"></div><div class="space-y-12 md:space-y-16">{t.steps.map((step, index) => <article class="relative flex items-start" data-kasia-timeline-step><div class="z-10 flex w-10 shrink-0 justify-center pt-1 md:w-16"><div data-kasia-timeline-node class="flex size-10 items-center justify-center rounded-full border-4 border-brand-light bg-brand-primary/10 text-sm font-bold text-brand-primary shadow-sm transition-all duration-500 md:size-12">{step.number}</div></div><div class="ml-4 transition-all duration-700 md:ml-6" data-kasia-timeline-content><div data-kasia-timeline-pill class:list={["mb-4 inline-block rounded-full px-5 py-2 text-sm font-bold transition-colors duration-500 md:text-base", index === 0 ? "bg-brand-primary text-white shadow-sm" : "bg-brand-primary/10 text-brand-primary"]}>{step.title}</div><Text variant="feature-body-sm" class="leading-relaxed text-brand-dark/65">{step.description}</Text></div></article>)}</div></div></div></Container></Section>
<script is:inline data-astro-rerun src="/js/kasia-timeline.js"></script>
