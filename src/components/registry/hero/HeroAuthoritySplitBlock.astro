---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import ContactForm from "@components/ui/molecules/ContactForm.astro";
import jsonData from "@data/sections/hero-authority-split.json";

type Benefit = { title: string; description: string };
type Stat = { value: string; label: string };
type Field = {
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "number" | "url" | "password" | "date" | "textarea" | "select" | "checkbox";
  required?: boolean;
  placeholder?: string;
  rows?: number;
  autoComplete?: string;
};

export interface Props {
  data?: typeof jsonData;
  locale?: "pl" | "en";
  sectionId?: string;
  class?: string;
}

const { data, locale = "pl", sectionId = "hero-authority-split", class: className = "" } = Astro.props as Props;
const source = data ?? jsonData;
const t = source[locale] ?? source.pl;
const benefits = (t.benefits ?? []) as Benefit[];
const stats = (t.stats ?? []) as Stat[];
const fields = (((t as typeof t & { formFields?: Field[] }).formFields) ?? []) as Field[];
---

<Section id={sectionId} tone="base" class:list={["relative overflow-hidden py-12 md:py-24", className]}>
  <Container>
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-6">
        <div class="flex max-w-3xl flex-col items-start">
          <div class="mb-6 flex items-center gap-4">
            <img
              src={source.image.src}
              alt={source.image.alt}
              width="64"
              height="64"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="size-16 rounded-full object-cover ring-4 ring-brand-primary/10"
            />
            <span class="h-px w-12 bg-brand-primary/30" aria-hidden="true"></span>
            <div class="flex flex-col">
              <Text variant="accent-label" class="text-brand-primary/70">{t.authorLabel}</Text>
              <Text variant="disclaimer" class="mt-1 hidden uppercase tracking-[0.18em] text-brand-dark/45 md:block">{t.authorSupport}</Text>
            </div>
          </div>

          <Heading tag="h1" variant="hero" class="max-w-2xl text-balance">
            <span class="font-light text-brand-dark">{t.titleLight} </span>
            <strong class="font-black tracking-tight text-brand-primary">{t.titleBold}</strong>
          </Heading>

          <Text variant="lead" class="mt-6 max-w-xl text-brand-dark/70">{t.description}</Text>

          <ul class="mt-10 space-y-5">
            {benefits.map((benefit) => (
              <li class="flex items-start gap-4">
                <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-xl bg-brand-primary/10 text-brand-primary" aria-hidden="true">
                  <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                </span>
                <span>
                  <strong class="block text-lg text-brand-dark">{benefit.title}</strong>
                  <Text variant="body" class="text-brand-dark/65">{benefit.description}</Text>
                </span>
              </li>
            ))}
          </ul>

          <div class="mt-12 border-t border-brand-dark/10 pt-8">
            <div class="flex flex-row flex-wrap items-center justify-start gap-x-8 gap-y-6 sm:gap-x-16">
              {stats.map((stat, index) => (
                <div class:list={["relative pr-4 last:pr-0 sm:pr-6", index === 2 && "hidden sm:block"]}>
                  {index > 0 && <span class="absolute top-0 -left-4 h-full w-px origin-top bg-brand-primary/20 sm:-left-8" aria-hidden="true"></span>}
                  <span class="block text-2xl font-black leading-none tracking-tight text-brand-primary sm:text-3xl">{stat.value}</span>
                  <Text variant="disclaimer" class="mt-1 max-w-[110px] uppercase tracking-[0.16em] text-brand-dark/55">{stat.label}</Text>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="relative mt-12 w-full lg:col-span-6 lg:mt-0">
        <div class="relative mx-auto w-full max-w-[540px] lg:ml-auto">
          <div class="absolute inset-0 rounded-2xl bg-brand-primary/10 blur-2xl" aria-hidden="true"></div>
          <div class="relative z-10 overflow-hidden rounded-2xl border border-brand-dark/10 bg-white p-6 shadow-soft sm:p-10">
            <div>
              <Heading tag="h2" variant="section-heading-lg" class="text-brand-dark"><Fragment set:html={t.formHeading} /></Heading>
              <Text variant="body" class="mt-3 text-brand-dark/65">{t.formSubheading}</Text>
            </div>
            <ContactForm
              formId={`${sectionId}-form`}
              fieldIdPrefix={`${sectionId}-field`}
              fields={fields}
              showHeader={false}
              includeRodoConsent={true}
              class="mt-8"
            />
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>
