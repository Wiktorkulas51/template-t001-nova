---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Button from "@components/ui/atoms/Button.astro";
import data from "@data/sections/hero-cinematic.json";

// Why: texts and media are in props (SSOT - Single Source of Truth) with
// fallback to JSON (src/data/sections/hero-cinematic.json). JSON holds content
// en/pl as at the source (HeinrichHeroBlock from filip-halucha), and PL is the language
// main (default lang). Props from CMS overwrite JSON.
type Cta = { label: string; href: string };
type Video = { sources: string[]; poster?: string; grayscale?: boolean };

export interface Props {
  sectionId?: string;
  /** Content language with JSON. PL is the main language (default).*/
  lang?: "pl" | "en";
  title?: string;
  /** Page title from page config - overwrites title (h1 = page heading, pattern from HeroBlock).*/
  pageHeading?: string;
  /** Company data injected by PageBuilder; hero does not render them (required only for type compatibility).*/
  company?: { phone?: string; email?: string; address?: string };
  cta?: Cta;
  cta2?: Cta;
  video?: Video;
}

const {
  sectionId = "hero-cinematic",
  lang = "pl",
  title,
  pageHeading,
  cta,
  cta2,
  video,
} = Astro.props as Props;

const t = data[lang] ?? data.pl;

// Dlaczego: pageHeading z page config nadpisuje title (wzorzec z HeroBlock),
// and props overwrite JSON. Thanks to this, h1 = page heading for SEO.
const resolvedTitle = pageHeading || title || t.title;
const primaryCta = cta || t.cta;
const secondaryCta = cta2 || t.cta2;

// Why: video is a media asset, so it lives outside the en/pl structure in JSON
// (there is no point in duplicating paths per language). Props take precedence.
const videoData = video || data.video;
const videoSources = Array.isArray(videoData?.sources) ? videoData.sources : [];
const hasVideo = videoSources.length > 0;
const poster = videoData?.poster;
const grayscale = videoData?.grayscale === true;

// Why: the MIME type is determined by the file extension, so the CMS editor only provides
// path (sources: string[]), and the component itself selects the type attribute to <source>.
const mimeForSource = (src: string): string => {
  const ext = src.split(".").pop()?.toLowerCase();
  const mime: Record<string, string> = { mp4: "video/mp4", webm: "video/webm", ogg: "video/ogg" };
  return mime[ext ?? ""] ?? "video/mp4";
};
---

<!-- Dlaczego: Section (tone="page" + bg-black) i Container to layout atomics.
     min-h taking into account the height of the sticky navbar makes the video fill
     the entire first screen (visual copy of HeinrichHeroBlock).-->
<Section
  id={sectionId}
  tone="page"
  class="relative flex min-h-[calc(100svh-var(--site-header-height,5.75rem))] flex-col overflow-hidden bg-black"
>
  <!-- Background media layer (absolute inset-0). aria-hidden, because it's decoration, not content.-->
  <div class="absolute inset-0" aria-hidden="true">
    <!-- Dlaczego: poster jako osobny <img> dla mobile. Do 767px wideo jest ukryte
         (saving transfer and battery), and the image is visible instead.
         Ukrywanie/pokazywanie pilnuje style is:inline (ochrona FOUC), nie klasy
         Tailwind. Wzorzec z HeroVideoBlock. -->
    {poster && (
      <img
        id="hero-cinematic-poster-mobile"
        src={poster}
        alt=""
        width="1600"
        height="900"
        class="absolute inset-0 size-full object-cover"
        loading="eager"
      />
    )}

    <!-- Why: video has preload="none" and sources in data-src (not in src) -
         the browser does NOT start downloading the video at page start. Script
         below replaces src only after requestIdleCallback and calls load().
         Until then, you can see the poster. Pattern from HeroVideoBlock.-->
    {hasVideo && (
      <video
        id="hero-cinematic-media"
        class:list={["absolute inset-0 size-full object-cover", { grayscale }]}
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster={poster}
        data-hero-video
        style={grayscale ? "filter: grayscale(1);" : undefined}
      >
        {videoSources.map((src) => (
          <source data-src={src} type={mimeForSource(src)} />
        ))}
      </video>
    )}

    <!-- Why: a dark gradient under the content ensures the readability of the white one
         text regardless of the brightness of the video frames (copy from HeinrichHeroBlock).
         Wzmocniony (zamiast from-black/20 via-black/10 to-black/55), bo
         the video placeholder is bright and without further darkening the text loses legibility.-->
    <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/20 to-black/70"></div>

    <!-- Dlaczego: siatka kropek jak patchbay (kopia z HeinrichHeroBlock).
         The ui-console-grid/ui-console-grid--dark classes are in core.css, opacity-18
         to utility Tailwind v4 (any numeric value).-->
    <div class="absolute inset-0 ui-console-grid ui-console-grid--dark opacity-18"></div>
  </div>

  <Container class="relative z-10 flex flex-1 flex-col justify-center">
    <div class="mx-auto flex w-full max-w-3xl flex-col items-center py-16 text-center md:py-24">
      <!-- Why: set:html allows <br /> and underscores in the title (SSOT
           from JSON). Typography classes copy HeinrichHeroBlock: font-light,
           szerokie tracking, uppercase, progresywne skalowanie sm/lg. -->
      <Heading
        tag="h1"
        variant="hero"
        class="max-w-3xl text-lg font-light uppercase tracking-[0.18em] text-white sm:text-xl md:text-2xl lg:text-3xl"
        set:html={resolvedTitle}
      />

      <div class="mt-16 flex flex-col gap-4 sm:flex-row">
        {primaryCta && (
          <Button href={primaryCta.href} variant="primary" size="lg" class="min-h-11 bg-white text-neutral-900 shadow-none hover:bg-neutral-200">
            {primaryCta.label}
          </Button>
        )}
        {secondaryCta && (
          <Button href={secondaryCta.href} variant="outline" size="lg" class="min-h-11 border-white/25 text-white/60 hover:border-white hover:bg-white/10 hover:text-white">
            {secondaryCta.label}
          </Button>
        )}
      </div>
    </div>
  </Container>
</Section>

<script>
  // Why: the normal <script> in Astro is the TS module where declare merging
  // for global Window doesn't work. The one-time registration flag is landing
  // na rozszerzonym globalThis. Wzorzec z HeroVideoBlock.
  const globalScope = globalThis as typeof globalThis & { __heroCinematicVideoBound?: boolean };

  // Why: video hero is the site's heaviest resource. We are only loading them
  // when the browser is idle (requestIdleCallback), and not immediately at
  // clash. Until then, the poster (static image) is visible - thanks to this
  // LCP nie czeka na wideo, a transfer na mobile jest minimalny.
  const initHeroVideo = () => {
    if (document.documentElement.classList.contains('component-frame-thumbnail')) return;

    const video = document.querySelector("[data-hero-video]");
    if (!(video instanceof HTMLVideoElement) || video.dataset.loaded === "1") return;

    // Mobile: the video is hidden by CSS (FOUC protection), so we don't start
    // it at all - only the poster remains on small screens. We check the condition after
    // possible rotation of the device by the matchMedia listener in the init section.
    if (window.matchMedia("(max-width: 767px)").matches) return;

    const startVideo = () => {
      if (video.dataset.loaded === "1") return;
      video.dataset.loaded = "1";
      // We change the sources from data-src to src only now so that the browser
      // did not start downloading earlier (preload="none" + no src = zero transfer).
      video.querySelectorAll("source[data-src]").forEach((source) => {
        const src = source.getAttribute("data-src");
        if (src) source.setAttribute("src", src);
      });
      video.load();
      // play() returns Promise - we ignore the error (e.g. when the video is out of view),
      // bo autoplay to jedynie ulepszenie, a nie funkcja krytyczna.
      void video.play().catch(() => {});
    };

    const deferStart = () => {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(startVideo, { timeout: 900 });
        return;
      }
      // Fallback for browsers without requestIdleCallback (older Safari/WebView).
      // Note: we do not use window.setTimeout here because the "in" operator narrows the window
      // do never in the else branch, which TypeScript reports as an error.
      setTimeout(startVideo, 650);
    };

    if (document.readyState === "complete") {
      deferStart();
    } else {
      window.addEventListener("load", deferStart, { once: true });
    }
  };

  // We register the handler once per session. When navigating SPA (astro:page-load)
  // the function checks dataset.loaded, so the video will not start a second time.
  if (!globalScope.__heroCinematicVideoBound) {
    globalScope.__heroCinematicVideoBound = true;
    document.addEventListener("astro:page-load", initHeroVideo);
    window.matchMedia("(min-width: 768px)").addEventListener("change", initHeroVideo);
  }

  initHeroVideo();
</script>

<!-- Why: inline style prevents FOUC - video and poster are appropriate
     hidden/showed immediately before the full Tailwind CSS is loaded.
     Wzorzec z HeroVideoBlock. -->
<style is:inline>
  #hero-cinematic-media { display: none; }
  #hero-cinematic-poster-mobile { display: none; }
  @media (min-width: 768px) {
    #hero-cinematic-media { display: block; }
  }
  @media (max-width: 767px) {
    #hero-cinematic-poster-mobile { display: block; }
  }
</style>
