---
// Dlaczego: HeroCountdownBlock to reimplementacja sekcji hero
// from the recruitment landing page of the Pomeranian University in Slupsk
// (projekt aleksandra-klisik, index.html linie 105-219 + style.css).
// The characteristic layout has been retained: uppercase H1 with clamp, countdown
// in octagonal panel with calendar icon, 4 units (days/hour/min/sec)
// separated by vertical lines and the end date. Client signature
// (neon lime #D9FF18, navy #09155C/#253B78) jest zmapowana na tokeny
// brand starter-kit (brand-primary/brand-dark), and slide buttons replaced
// atomem Button z text swap (hoverText), zgodnie z DESIGN_RULES.
// Deadline is configured in JSON via the countdown.deadline field
// (ISO 8601 format with zone, e.g. "2030-01-01T00:00:00+02:00").
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import jsonData from "@data/sections/hero-countdown.json";

type Cta = {
  label: string;
  href: string;
  /** Tekst zamiany po najechaniu (hover), opcjonalny. */
  hoverLabel?: string;
};

type Countdown = {
  title: string;
  subtitle: string;
  deadline: string;
  units: { days: string; hours: string; minutes: string; seconds: string };
  dateValue: string;
  dateLabel: string;
};

type LocaleData = (typeof jsonData)["pl"] & {
  ctas: Cta[];
  countdown: Countdown;
};

export interface Props {
  /** Full section details; when missing, the block reads the fallback from the JSON.*/
  data?: LocaleData;
  /** JSON content language: "pl" (default) or "en".*/
  locale?: "pl" | "en";
  /** Section anchor id (default "recruitment").*/
  id?: string;
  /** Header tag: 'h1' (first section of the page) or 'h2'.*/
  headingTag?: "h1" | "h2";
  /** Additional classes per section (e.g. with PageBuilder).*/
  class?: string;
}

const { data, locale = "pl", id = "rekrutacja", headingTag = "h1", class: className = "" } =
  Astro.props as Props;

// Dlaczego: wzorzec "props.data || jsonData[locale]" (jak w HeroStatsBlock),
// so that the block works independently from the section data, and PageBuilder or CMS can
// overwrite content. Fallback to pl protects against bad places.
const t = (data ?? jsonData[locale] ?? jsonData.pl) as LocaleData;
const countdown = t.countdown;
const ctas = t.ctas ?? [];
---

<Section tone="base" class:list={["up-hero relative overflow-clip bg-white", className]} id={id}>
  <Container>
    <div class="up-hero-grid grid items-start gap-6 md:gap-10">
      <div class="up-hero-content flex flex-col">
        <Text tag="p" class="up-eyebrow">{t.eyebrow}</Text>
        <Heading
          tag={headingTag}
          class="up-h1 max-w-[11em] text-[clamp(2.05rem,8.5vw,3.4rem)] uppercase leading-[0.94] tracking-normal md:text-[clamp(3rem,3.7vw,4.1rem)]"
        >
          {t.heading}
        </Heading>
        <Text tag="p" class="up-lead max-w-[40rem] text-[clamp(1rem,2vw,1.18rem)] text-wrap-pretty md:max-w-[34rem] md:text-[clamp(1rem,1.2vw,1.1rem)]">
          {t.description}
        </Text>

        {/* Why: the original shows separate graphics in mobile content,
            and the desktop variant renders it in the right column of the grid.*/}
        <div class="up-hero-visual up-hero-visual--mobile" aria-hidden="true">
          <picture>
            <source srcset="/assets/images/up/hero-banner-400w.webp 400w, /assets/images/up/hero-banner-800w.webp 800w" type="image/webp" sizes="90vw" />
            <source srcset="/assets/images/up/hero-banner-800w.jpg" type="image/jpeg" />
            <img
              class="up-hero-art h-auto w-full"
              src="/assets/images/up/hero-banner-800w.jpg"
              alt=""
              width="800"
              height="472"
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
          </picture>
        </div>

        <div class="up-actions mt-[clamp(1.2rem,2.5vw,1.75rem)] flex flex-wrap gap-4">
          {ctas.map((cta, i) => {
            const isPrimary = i === 0;
            return (
              <Button
                href={cta.href}
                variant={isPrimary ? "primary" : "outline"}
                size="lg"
                hoverText={cta.hoverLabel ?? cta.label}
              >
                {cta.label}
              </Button>
            );
          })}
        </div>

      </div>

      {/* Why: hero photo in the right column from the desktop breakpoint,
          exactly as in the original: grid of 2 columns with the image stretched on
          2 rows (object-fit: contain, glued to lower left corner).*/}
      <div class="up-hero-visual up-hero-visual--desktop" aria-hidden="true">
        <picture>
          <source srcset="/assets/images/up/hero-banner-800w.webp 800w" type="image/webp" sizes="40vw" />
          <source srcset="/assets/images/up/hero-banner-800w.jpg" type="image/jpeg" />
          <img
            class="up-hero-art h-auto w-full"
            src="/assets/images/up/hero-banner-800w.jpg"
            alt=""
            width="800"
            height="472"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </picture>
      </div>

      {/* Dlaczego: kalendarz jest trzecim elementem grida, aby na desktopie
          go below the content and keep the label | layout values ​​| date from the original.*/}
      <div class="up-countdown">
        <div class="up-countdown__label">
          <span class="up-countdown__icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z" />
              <path d="M16 3v4" />
              <path d="M8 3v4" />
              <path d="M4 11h16" />
              <path d="M11 15h1" />
              <path d="M12 15v3" />
            </svg>
          </span>
          <div class="min-w-0">
            <Heading tag="h2" class="up-countdown__title">{countdown.title}</Heading>
            <Text tag="p" class="up-countdown__subtitle">{countdown.subtitle}</Text>
          </div>
        </div>

        <dl data-countdown data-deadline={countdown.deadline} class="up-countdown__values">
          <div>
            <dd data-countdown-days>00</dd>
            <dt>{countdown.units.days}</dt>
          </div>
          <div>
            <dd data-countdown-hours>00</dd>
            <dt>{countdown.units.hours}</dt>
          </div>
          <div>
            <dd data-countdown-minutes>00</dd>
            <dt>{countdown.units.minutes}</dt>
          </div>
          <div>
            <dd data-countdown-seconds>00</dd>
            <dt>{countdown.units.seconds}</dt>
          </div>
        </dl>

        <div class="up-countdown__date">
          <strong>{countdown.dateValue}</strong>
          <span>{countdown.dateLabel}</span>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  /* Why: UP (Pomeranian University in Slupsk) signature as your own
     klasy bloku (wzorzec jak AboutExpertBlock .lc-btn-*), ale kolory
     klienckie (neon lime, navy, cyan) zmapowane na tokeny brand
     starter-kita (brand-primary, brand-dark, brand-light). */

  .up-eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-brand-dark);
    font-weight: 900;
    text-transform: uppercase;
  }

  .up-h1 {
    color: var(--color-brand-dark);
    letter-spacing: 0;
  }

  .up-lead {
    margin: clamp(0.9rem, 2vw, 1.25rem) 0 0;
    color: var(--color-brand-dark);
  }

  .up-hero-grid {
    /* Why: the three hero elements must remain separate grid elements,
       so that the calendar can be placed under the content and the image on the right side.*/
    grid-template-columns: minmax(0, 1fr);
  }

  .up-hero-visual {
    position: relative;
    overflow: visible;
    min-height: auto;
    width: 100%;
  }

  .up-hero-visual--mobile {
    display: block;
    padding-top: 1.25rem;
  }

  .up-hero-visual--desktop {
    display: none;
  }

  .up-hero-art {
    position: static;
    display: block;
    width: 100%;
    height: auto;
    object-position: center;
  }

  @media (min-width: 48rem) {
    .up-hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .up-hero-content {
      grid-column: 1;
      grid-row: 1;
    }

    .up-hero-visual--mobile {
      display: none;
    }

    .up-hero-visual--desktop {
      display: block;
      grid-column: 1;
      grid-row: 2;
      align-self: stretch;
      min-height: 24rem;
      aspect-ratio: 16 / 9;
    }

    .up-countdown {
      grid-column: 1;
      grid-row: 3;
    }
  }

  @media (min-width: 64rem) {
    .up-hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
      grid-template-rows: auto auto;
      column-gap: clamp(1.25rem, 1.8vw, 2rem);
    }
    .up-hero-content {
      grid-column: 1;
      grid-row: 1;
      align-self: end;
    }

    .up-hero-visual--desktop {
      display: block;
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: stretch;
      justify-self: stretch;
      width: 100%;
      min-height: 0;
      aspect-ratio: auto;
    }

    .up-countdown {
      grid-column: 1;
      grid-row: 2;
      display: grid;
      grid-template-columns: minmax(9.5rem, 0.7fr) minmax(0, 1.4fr) minmax(9rem, 0.6fr);
      align-items: center;
      gap: 0.7rem;
      width: 100%;
    }

    .up-countdown .up-countdown__values dd {
      /* Why: This breakpoint is used by the component preview with a width of 1280 px.*/
      font-size: clamp(1.35rem, 1.8vw, 1.85rem);
    }

    .up-hero-art {
      object-fit: contain;
      object-position: left bottom;
    }
  }

  @media (min-width: 90rem) {
    .up-hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: min(32rem, calc(100dvh - 5.85rem));
    }

    .up-countdown {
      grid-template-columns: minmax(11.5rem, 0.85fr) minmax(18.5rem, 1.35fr) minmax(7.75rem, 0.58fr);
      gap: 1rem;
      max-width: 100%;
      padding: 1.35rem 1.35rem 1.35rem 1.5rem;
    }

    .up-countdown__label {
      align-self: center;
    }

    .up-countdown__title {
      font-size: 1rem;
      line-height: 1.3;
    }

    .up-countdown__subtitle {
      max-width: 11rem;
      font-size: 1rem;
      line-height: 1.35;
    }

    .up-countdown__values {
      align-self: center;
      gap: 0;
    }

    .up-countdown__values dt {
      font-size: 0.72rem;
    }

    .up-countdown .up-countdown__values dd {
      /* Why: the numbers should remain legible, but cannot dominate the panel description.*/
      font-size: clamp(1.35rem, 1.6vw, 1.85rem);
    }

    .up-countdown__date {
      align-self: center;
    }
  }

  /* ---- Countdown (pattern .countdown + .hero__countdown from the original) ----*/
  .up-countdown {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1rem;
    min-height: 8rem;
    margin-top: 1.25rem;
    padding: 1.25rem 1rem 1.25rem 1.25rem;
    background: transparent;
    color: var(--color-brand-dark);
  }

  .up-countdown::before {
    /* Why: octagonal panel background (clip-path), exactly as in the original.*/
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-brand-light);
    clip-path: polygon(0.75rem 0, calc(100% - 0.75rem) 0, 100% 0.75rem, 100% calc(100% - 0.75rem), calc(100% - 0.75rem) 100%, 0.75rem 100%, 0 calc(100% - 0.75rem), 0 0.75rem);
    pointer-events: none;
    z-index: -1;
  }

  .up-countdown__label {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-width: 0;
  }

  .up-countdown__icon {
    width: clamp(2.5rem, 5vw, 4rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    background: var(--color-brand-primary);
    clip-path: polygon(22% 0, 78% 0, 100% 22%, 100% 78%, 78% 100%, 22% 100%, 0 78%, 0 22%);
    color: var(--color-on-primary);
  }

  .up-countdown__title {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.15;
    text-transform: uppercase;
    font-weight: 800;
  }

  .up-countdown__subtitle {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-brand-dark);
    opacity: 0.8;
  }

  .up-countdown__values {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.1rem, 0.5vw, 0.4rem);
    align-items: center;
    width: min(100%, 39rem);
    margin-inline: auto;
    margin-block: 0;
  }

  .up-countdown__values div {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding-inline: clamp(0.35rem, 0.8vw, 1rem);
  }

  .up-countdown__values div + div {
    border-left: 1px solid var(--color-outline-variant);
  }

  .up-countdown__values dd {
    order: 0;
    margin: 0;
    color: var(--color-brand-dark);
    font-size: clamp(1.4rem, 2.5vw, 3rem);
    font-weight: 900;
    line-height: 1;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .up-countdown__values dt {
    order: 1;
    margin-top: 0.15rem;
    color: var(--color-on-surface-variant);
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    text-align: center;
  }

  .up-countdown__date {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    justify-self: end;
    font-weight: 900;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .up-countdown__date strong {
    color: var(--color-brand-primary);
    font-size: 0.95rem;
  }

  .up-countdown__date span {
    color: var(--color-brand-dark);
    font-size: 0.74rem;
  }

  /* Why: the tablet keeps three columns inside a separate panel,
     while his position in hero remains below the graphic.*/
  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .up-countdown {
      display: grid;
      grid-template-columns: minmax(9rem, 0.8fr) minmax(0, 1.4fr) minmax(7rem, 0.6fr);
      align-items: center;
      gap: 0.7rem;
      width: 100%;
    }
    .up-countdown__values {
      margin-inline: 0;
      min-width: 0;
    }
    .up-countdown__date {
      justify-content: center;
      justify-self: end;
    }
  }
</style>

<script>
  let countdownIntervals: number[] = [];

  function setupCountdowns(): void {
    countdownIntervals.forEach((intervalId) => window.clearInterval(intervalId));
    countdownIntervals = [];

    document.querySelectorAll<HTMLElement>("[data-countdown]").forEach((root) => {
      const deadline = new Date(root.dataset.deadline ?? "").getTime();
      const parts = {
        days: root.querySelector<HTMLElement>("[data-countdown-days]"),
        hours: root.querySelector<HTMLElement>("[data-countdown-hours]"),
        minutes: root.querySelector<HTMLElement>("[data-countdown-minutes]"),
        seconds: root.querySelector<HTMLElement>("[data-countdown-seconds]"),
      };
      const pad = (value: number) => String(value).padStart(2, "0");

      function updateCountdown(): void {
        const distance = Math.max(0, (Number.isNaN(deadline) ? 0 : deadline) - Date.now());
        const days = Math.floor(distance / 86_400_000);
        const hours = Math.floor((distance / 3_600_000) % 24);
        const minutes = Math.floor((distance / 60_000) % 60);
        const seconds = Math.floor((distance / 1_000) % 60);

        if (parts.days) parts.days.textContent = pad(days);
        if (parts.hours) parts.hours.textContent = pad(hours);
        if (parts.minutes) parts.minutes.textContent = pad(minutes);
        if (parts.seconds) parts.seconds.textContent = pad(seconds);
      }

      updateCountdown();
      countdownIntervals.push(window.setInterval(updateCountdown, 1_000));
    });
  }

  document.addEventListener("astro:page-load", setupCountdowns);
  setupCountdowns();
</script>
