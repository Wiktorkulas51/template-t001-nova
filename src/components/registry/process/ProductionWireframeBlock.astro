---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import SectionHeader from "@components/ui/molecules/SectionHeader.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";

// Dane sekcji przekazywane z PageBuilder (src/data/sections/production.json)
interface Product {
  image: string;
  alt: string;
  label: string;
  title: string;
  desc: string;
  features: string[];
}

interface Props {
  tagline?: string;
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  products?: Product[];
}

const {
  tagline = "Produkcja",
  title = "Sauny, balie i deska elewacyjna na wymiar",
  description = "Produkujemy sauny i balie ogrodowe z drewna. Sauny typu beczka i sauny w stylu nowoczesnej stodoły. Balie z wkładem z włókna szklanego i akrylowym. Z hydromasażem i aeromasażem. Każdy produkt przygotowujemy z dbałością o wygodę użytkowania, estetyczny wygląd i trwałość.",
  ctaLabel = "Zapytaj o wycenę",
  ctaHref = "/#dcontact",
  products = [],
} = Astro.props;
---

<Section tone="page" id="production">
  <Container>
    <SectionHeader
      tagline={tagline}
      title={title}
      description={description}
      align="center"
      class="max-w-4xl"
    />

    <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-8">
      {products.map((p) => (
        <div class="group flex flex-col bg-white rounded-2xl border border-brand-dark/5 overflow-hidden hover:border-brand-accent/30 transition-all duration-500">
          <div class="relative aspect-[4/3] overflow-hidden bg-brand-cream">
            <img
              src={p.image}
              alt={p.alt}
              width="1400"
              height="1050"
              class="size-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-dark/70 to-transparent h-1/3" />
            <span class="absolute bottom-4 left-4 inline-flex items-center px-3 py-1 rounded-lg bg-brand-accent/20 backdrop-blur-sm text-xs font-semibold uppercase tracking-widest text-brand-light">
              {p.label}
            </span>
          </div>

          <div class="flex flex-col flex-1 p-6 md:p-7">
            <Heading level={3} variant="feature-title" class="text-brand-dark mb-3">
              {p.title}
            </Heading>

            <Text variant="body" class="text-brand-dark/60 text-sm leading-relaxed mb-5">
              {p.desc}
            </Text>

            <ul class="space-y-2.5 mb-6 flex-1">
              {p.features.map((f) => (
                <li class="flex items-start gap-3 text-sm text-brand-dark/60">
                  <svg class="w-4 h-4 text-brand-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            <div class="pt-5 border-t border-brand-dark/5">
              <Button href={ctaHref} variant="primary" size="md" class="w-full sm:w-auto">
                {ctaLabel}
              </Button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>
