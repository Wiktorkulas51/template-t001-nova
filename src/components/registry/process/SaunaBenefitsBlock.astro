---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import SectionHeader from "@components/ui/molecules/SectionHeader.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";

// Dane sekcji przekazywane z PageBuilder (src/data/sections/sauna-benefits.json)
// Icons assigned automatically in the order of the cards, the customer does not have to set them.
interface BenefitItem {
  title: string;
  desc: string;
}

interface Props {
  tagline?: string;
  title?: string;
  description?: string;
  benefits?: BenefitItem[];
}

const BENEFIT_ICONS = ["sparkle", "snowflake", "users", "truck", "leaf", "calendar"];

const {
  tagline = "Dlaczego my",
  title = "Zalety korzystania z sauny i balii",
  description = "Sprawdź, dlaczego warto wybrać tę ofertę wynajmu.",
  benefits = [],
} = Astro.props;

// Icon cyclically from the list, depending on the position of the card in the list.
const benefitIcon = (index: number) => BENEFIT_ICONS[index % BENEFIT_ICONS.length];
---

<Section tone="page" id="sauna-benefits">
  <Container>
    <SectionHeader
      tagline={tagline}
      title={title}
      description={description}
      align="center"
    />

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {benefits.map((b, i) => (
        <div
          class="flex-col lg:flex-row flex gap-4 lg:gap-5 p-6 bg-white rounded-2xl border border-brand-dark/10 hover:border-brand-primary/20 transition-all duration-300 lg:text-left text-center"
        >
          <div class="w-12 h-12 rounded-xl bg-brand-primary/5 border border-brand-primary/10 flex items-center justify-center shrink-0 lg:mt-1 self-center lg:self-start">
            {benefitIcon(i) === "sparkle" && (
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
            {benefitIcon(i) === "snowflake" && (
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="2" x2="12" y2="22"/>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                <line x1="19.07" y1="4.93" x2="4.93" y2="19.07"/>
                <line x1="12" y1="5.5" x2="9.5" y2="3"/>
                <line x1="12" y1="5.5" x2="14.5" y2="3"/>
                <line x1="12" y1="18.5" x2="9.5" y2="21"/>
                <line x1="12" y1="18.5" x2="14.5" y2="21"/>
                <line x1="5.64" y1="8.27" x2="3" y2="6.64"/>
                <line x1="5.64" y1="8.27" x2="3.36" y2="10"/>
                <line x1="18.36" y1="15.73" x2="21" y2="17.36"/>
                <line x1="18.36" y1="15.73" x2="20.64" y2="14"/>
                <line x1="18.36" y1="8.27" x2="21" y2="6.64"/>
                <line x1="18.36" y1="8.27" x2="20.64" y2="10"/>
                <line x1="5.64" y1="15.73" x2="3" y2="17.36"/>
                <line x1="5.64" y1="15.73" x2="3.36" y2="14"/>
              </svg>
            )}
            {benefitIcon(i) === "users" && (
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zm12 10v-2a4 4 0 00-3-3.87m-4-12a4 4 0 010 7.75" stroke-width="2" stroke-linecap="round"/>
              </svg>
            )}
            {benefitIcon(i) === "truck" && (
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="5.5" cy="18.5" r="2.5" stroke-width="2"/>
                <circle cx="18.5" cy="18.5" r="2.5" stroke-width="2"/>
              </svg>
            )}
            {benefitIcon(i) === "leaf" && (
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
            {benefitIcon(i) === "calendar" && (
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-width="2" stroke-linecap="round"/>
              </svg>
            )}
          </div>
          <div class="flex-1 min-w-0">
            <Heading level={4} variant="feature-title" class="text-brand-dark mb-1">
              {b.title}
            </Heading>
            <Text variant="body" class="text-brand-dark/60 text-sm leading-relaxed">
              {b.desc}
            </Text>
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>
