---
// Why: ProcessRecruitmentBlock recreates the "3 Steps to Study" section of Aleksandra Klisik's
// project, but uses only tokens and Starter Kit atoms. The data is separated from the presentation
// so that the block can work both in the library preview and in PageBuilder.
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import PatternOverlay from "@components/decorations/PatternOverlay.astro";
import jsonData from "@data/sections/process-recruitment.json";

const ICON_PATHS = {
  fileText: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>',
  fileCheck: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 16l2 2 5-5"/>',
  bellPlus: '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4M19 12v6M16 15h6"/>',
} as const;

type IconName = keyof typeof ICON_PATHS;
type Step = { num: string; icon: IconName; title: string; description: string };
type Copy = {
  eyebrow: string;
  heading: string;
  ariaLabel: string;
  steps: Step[];
  cta: { label: string; hoverLabel: string; href: string };
};

export interface Props {
  data?: typeof jsonData;
  locale?: "pl" | "en";
  id?: string;
  headingTag?: "h1" | "h2";
  class?: string;
}

const { data, locale = "pl", id = "kroki", headingTag = "h2", class: className = "" } = Astro.props as Props;
const t = ((data ?? jsonData)[locale] ?? jsonData.pl) as Copy;
const steps = t.steps ?? [];
---

<Section id={id} tone="page" class:list={["relative isolate overflow-clip", className]}>
  <PatternOverlay variant="dots" opacity="0.09" color="var(--color-brand-dark)" />
  <Container class="relative z-10">
    <div class="mx-auto max-w-[52rem] text-center">
      <Text tag="p" class="!m-0 !text-brand-dark text-xs font-black uppercase tracking-[0.02em]">{t.eyebrow}</Text>
      <Heading tag={headingTag} class="mt-5 !m-0 !text-brand-dark !text-[clamp(1.8rem,4vw,3rem)] !font-black !leading-[1.05] uppercase">{t.heading}</Heading>
    </div>

    <div class="mt-[clamp(2.5rem,5vw,4rem)] grid grid-cols-1 gap-4 min-[48rem]:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)] min-[48rem]:gap-2" aria-label={t.ariaLabel}>
      {steps.map((step, index) => (
        <Fragment>
          <article class="up-process__card relative flex min-h-56 flex-col items-center gap-1 px-5 pb-6 pt-14 text-center min-[48rem]:px-6">
            <span class:list={["up-process__badge absolute top-[0.65rem] z-[1] grid size-10 place-items-center text-[0.85rem] font-black text-on-primary", `up-process__badge--${index + 1}`]}>{step.num}</span>
            <svg
              class="relative z-[1] block size-[3.25rem] shrink-0 text-brand-dark"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <Fragment set:html={ICON_PATHS[step.icon] ?? ""} />
            </svg>
            <Heading tag="h3" class="relative z-[1] !m-0 !text-brand-dark text-[1.05rem] !font-black !leading-[1.2] uppercase">{step.title}</Heading>
            <Text tag="p" class="relative z-[1] !m-0 max-w-[20rem] !text-on-surface-variant text-[0.88rem] leading-[1.5]">{step.description}</Text>
          </article>

          {index < steps.length - 1 && (
            <div class="hidden self-center text-outline min-[48rem]:block" aria-hidden="true">
                <svg class="block w-12" viewBox="0 0 48 24" fill="none">
                <line x1="4" y1="12" x2="36" y2="12" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" />
                <polyline points="36,6 44,12 36,18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          )}
        </Fragment>
      ))}
    </div>

    <div class="mt-7 flex justify-center">
      <Button href={t.cta.href} variant="outline" size="lg" hoverText={t.cta.hoverLabel}>
        {t.cta.label}
        <svg slot="icon-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" />
        </svg>
      </Button>
    </div>
  </Container>
</Section>

<style>
  .up-process__card {
    --step-cut: 1.15rem;
    background: var(--color-outline-variant);
    clip-path: polygon(var(--step-cut) 0, calc(100% - var(--step-cut)) 0, 100% var(--step-cut), 100% calc(100% - var(--step-cut)), calc(100% - var(--step-cut)) 100%, var(--step-cut) 100%, 0 calc(100% - var(--step-cut)), 0 var(--step-cut));
  }

  .up-process__card::after {
    position: absolute;
    inset: 1.5px;
    z-index: -1;
    background: var(--color-surface);
    clip-path: polygon(calc(var(--step-cut) + 1.5px) 1.5px, calc(100% - var(--step-cut) - 1.5px) 1.5px, calc(100% - 1.5px) calc(var(--step-cut) + 1.5px), calc(100% - 1.5px) calc(100% - var(--step-cut) - 1.5px), calc(100% - var(--step-cut) - 1.5px) calc(100% - 1.5px), calc(var(--step-cut) + 1.5px) calc(100% - 1.5px), 1.5px calc(100% - var(--step-cut) - 1.5px), 1.5px calc(var(--step-cut) + 1.5px));
    content: "";
  }

  .up-process__badge {
    clip-path: polygon(20% 0, 80% 0, 100% 20%, 100% 80%, 80% 100%, 20% 100%, 0 80%, 0 20%);
  }

  .up-process__badge--1 { background: var(--color-brand-dark); }
  .up-process__badge--2 { background: var(--color-brand-primary); }
  .up-process__badge--3 { background: var(--color-brand-accent); }

</style>
