---
import ui from '@data/sections/piekary9-navigator-ui.json';
---
<div class="apartments-filter-bar mb-6 flex flex-col gap-6 rounded-2xl border border-brand-dark/10 bg-brand-light p-6 lg:flex-row lg:items-center lg:justify-between shadow-sm">
  
  <!-- Show-->
  <div class="filter-group">
    <span class="mb-2 block text-xs font-bold text-brand-dark/60">{ui.show}</span>
    <div class="flex items-center gap-0 overflow-hidden rounded-lg border border-brand-dark/15 bg-white">
      <button class="filter-btn cursor-pointer active w-full px-4 py-2 text-sm font-bold transition hover:bg-brand-cream/50 lg:w-auto" data-filter="status" data-value="available">{ui.available}</button>
      <div class="h-6 w-px bg-brand-dark/10"></div>
      <button class="filter-btn cursor-pointer w-full px-4 py-2 text-sm font-bold text-brand-dark/50 transition hover:bg-brand-cream/50 hover:text-brand-dark lg:w-auto" data-filter="status" data-value="all">{ui.all}</button>
    </div>
  </div>

  <!-- Pokoje -->
  <div class="filter-group">
    <span class="mb-2 block text-xs font-bold text-brand-dark/60">{ui.rooms}</span>
    <div class="flex items-center gap-2">
      <button class="filter-btn cursor-pointer filter-btn-box active rounded-lg border border-brand-dark/15 bg-white px-4 py-2 text-sm font-bold transition hover:border-brand-accent hover:text-brand-accent" data-filter="rooms" data-value="1">1</button>
      <button class="filter-btn cursor-pointer filter-btn-box rounded-lg border border-brand-dark/15 bg-white px-4 py-2 text-sm font-bold transition hover:border-brand-accent hover:text-brand-accent" data-filter="rooms" data-value="2">2</button>
      <button class="filter-btn cursor-pointer filter-btn-box rounded-lg border border-brand-dark/15 bg-white px-4 py-2 text-sm font-bold transition hover:border-brand-accent hover:text-brand-accent" data-filter="rooms" data-value="3">3</button>
      <button class="filter-btn cursor-pointer filter-btn-box rounded-lg border border-brand-dark/15 bg-white px-4 py-2 text-sm font-bold transition hover:border-brand-accent hover:text-brand-accent" data-filter="rooms" data-value="4">4</button>
    </div>
  </div>

  <!-- Square footage-->
  <div class="filter-group flex-1 max-w-[300px]">
    <span class="mb-2 block text-xs font-bold text-brand-dark/60">{ui.area}</span>
    <div class="flex items-center gap-4">
      <span class="text-sm font-bold text-brand-dark">25 m²</span>
      <input type="range" min="25" max="100" value="100" class="filter-slider flex-1" id="area-slider">
      <span class="text-sm font-bold text-brand-dark"><span id="area-val">100</span> m²</span>
    </div>
  </div>

  <!-- Floor-->
  <div class="filter-group">
    <span class="mb-2 block text-xs font-bold text-brand-dark/60">{ui.floor}</span>
    <div class="flex items-center gap-2">
      <button class="filter-btn cursor-pointer filter-btn-box rounded-lg border border-brand-dark/15 bg-white px-3 py-2 text-sm font-bold transition hover:border-brand-accent hover:text-brand-accent" data-filter="floor" data-value="0">0</button>
      <button class="filter-btn cursor-pointer filter-btn-box rounded-lg border border-brand-dark/15 bg-white px-3 py-2 text-sm font-bold transition hover:border-brand-accent hover:text-brand-accent" data-filter="floor" data-value="1">1</button>
      <button class="filter-btn cursor-pointer filter-btn-box rounded-lg border border-brand-dark/15 bg-white px-3 py-2 text-sm font-bold transition hover:border-brand-accent hover:text-brand-accent" data-filter="floor" data-value="2">2</button>
      <button class="filter-btn cursor-pointer filter-btn-box rounded-lg border border-brand-dark/15 bg-white px-3 py-2 text-sm font-bold transition hover:border-brand-accent hover:text-brand-accent" data-filter="floor" data-value="3">3</button>
      <button class="filter-btn cursor-pointer filter-btn-box rounded-lg border border-brand-dark/15 bg-white px-3 py-2 text-sm font-bold transition hover:border-brand-accent hover:text-brand-accent" data-filter="floor" data-value="4">4</button>
    </div>
  </div>
</div>

<style>
  .filter-btn.active {
    color: var(--color-brand-accent, var(--color-brand-accent));
  }
  .filter-btn-box.active {
    border-color: var(--color-brand-accent, var(--color-brand-accent));
  }

  .filter-slider {
    -webkit-appearance: none;
    appearance: none;
    height: 6px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 999px;
    outline: none;
  }

  .filter-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-brand-accent, var(--color-brand-accent));
    cursor: pointer;
  }
  
  .filter-slider::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-brand-accent, var(--color-brand-accent));
    cursor: pointer;
    border: none;
  }
</style>

<script>
  // Simple logic to mock filtering
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const areaSlider = document.getElementById('area-slider') as HTMLInputElement;
    const areaVal = document.getElementById('area-val');

    if(areaSlider && areaVal) {
      areaSlider.addEventListener('input', (e) => {
        areaVal.textContent = (e.target as HTMLInputElement).value;
        window.dispatchEvent(new CustomEvent('filter-apartments', { detail: { type: 'area', value: areaSlider.value }}));
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const filterType = target.getAttribute('data-filter');
        
        if (filterType === 'status') {
          document.querySelectorAll('.filter-btn[data-filter="status"]').forEach(b => {
            b.classList.remove('active', 'text-brand-dark');
            b.classList.add('text-brand-dark/50');
          });
          target.classList.add('active');
          target.classList.remove('text-brand-dark/50');
          
          window.dispatchEvent(new CustomEvent('filter-apartments', { 
            detail: { type: filterType, value: target.getAttribute('data-value'), isActive: true }
          }));
        } else {
          // Single-select toggle behavior for rooms and floors
          const wasActive = target.classList.contains('active');
          
          // Remove active from all siblings
          document.querySelectorAll(`.filter-btn[data-filter="${filterType}"]`).forEach(b => {
            b.classList.remove('active');
          });

          // Toggle current
          if (!wasActive) {
            target.classList.add('active');
          }

          window.dispatchEvent(new CustomEvent('filter-apartments', { 
            detail: { 
              type: filterType, 
              value: target.getAttribute('data-value'), 
              isActive: !wasActive,
              singleSelect: true
            }
          }));
        }
      });
    });
  });
</script>



