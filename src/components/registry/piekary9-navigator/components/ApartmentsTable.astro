---
import ui from '@data/sections/piekary9-navigator-ui.json';
import type { Apartment } from "@components/registry/piekary9-navigator/scripts/types";

interface Props {
	apartments: Apartment[];
}

const { apartments } = Astro.props;

type StatusKey = "available" | "reservation" | "sold";

const statusConfig: Record<StatusKey, { label: string; dot: string; text: string }> = {
	available: { label: "DOSTĘPNE", dot: "bg-emerald-500", text: "text-brand-dark" },
	reservation: { label: "REZERWACJA", dot: "bg-amber-500", text: "text-brand-dark" },
	sold: { label: "SPRZEDANE", dot: "bg-red-600", text: "text-brand-dark" },
};

function formatPrice(price?: number | null) {
	if (price === undefined || price === null || price === 0) return "-";
	return price.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ") + " zł";
}

// Default finish if not specified
const DEFAULT_FINISH = ui.renovation;
---

<div id="apartments-anchor" class="scroll-mt-32"></div>
<div id="table-expand-container" class="apartments-table-wrapper relative overflow-hidden rounded-2xl border border-brand-dark/10 bg-brand-light shadow-sm is-collapsed" style="max-height: 520px;">
	<div class="overflow-x-auto">
		<table class="w-full min-w-[900px] text-left text-sm" id="apartments-table">
			<thead>
				<tr class="border-b border-brand-dark/10 bg-brand-cream/60">
					<th class="px-4 py-4 font-bold text-brand-dark">{ui.local}</th>
					<th class="px-4 py-4 font-bold text-brand-dark cursor-pointer group/sort select-none" data-sort-key="rooms">
						<div class="flex items-center justify-center gap-1.5 transition-colors group-hover/sort:text-brand-accent">
							{ui.rooms} <i class="ph ph-sort-ascending text-brand-dark/40" aria-hidden="true"></i>
						</div>
					</th>
					<th class="px-4 py-4 font-bold text-brand-dark cursor-pointer group/sort select-none" data-sort-key="area">
						<div class="flex items-center justify-center gap-1.5 transition-colors group-hover/sort:text-brand-accent">
							{ui.area} <i class="ph ph-sort-ascending text-brand-dark/40" aria-hidden="true"></i>
						</div>
					</th>
					<th class="px-4 py-4 font-bold text-brand-dark cursor-pointer group/sort select-none" data-sort-key="floor">
						<div class="flex items-center justify-center gap-1.5 transition-colors group-hover/sort:text-brand-accent">
							{ui.floorLabel} <i class="ph ph-sort-ascending text-brand-dark/40" aria-hidden="true"></i>
						</div>
					</th>
					<th class="px-4 py-4 font-bold text-brand-dark text-center">{ui.finish}</th>
					<th class="px-4 py-4 font-bold text-brand-dark cursor-pointer group/sort select-none" data-sort-key="price">
						<div class="flex items-center justify-end gap-1.5 transition-colors group-hover/sort:text-brand-accent">
							{ui.price} <i class="ph ph-sort-ascending text-brand-dark/40" aria-hidden="true"></i>
						</div>
					</th>
					<th class="px-4 py-4 font-bold text-brand-dark cursor-pointer group/sort select-none" data-sort-key="price-m2">
						<div class="flex items-center justify-end gap-1.5 transition-colors group-hover/sort:text-brand-accent">
							{ui.pricePerM2} <i class="ph ph-sort-ascending text-brand-dark/40" aria-hidden="true"></i>
						</div>
					</th>
					<th class="px-4 py-4 font-bold text-brand-dark text-center">PDF</th>
					<th class="px-4 py-4 text-right"></th>
				</tr>
			</thead>
			<tbody class="divide-y divide-brand-dark/5">
				{apartments.map((item) => {
					const status = statusConfig[item.status as StatusKey] || statusConfig.available;
					const finish = item.finish || DEFAULT_FINISH;
					const pricePerM2 = item.price_per_m2 ?? (item.price && item.area ? Math.round(item.price / item.area) : null);
					const firstImage = item.images?.[0];
					const mainImage = (typeof firstImage === 'string' ? firstImage : firstImage?.url) || "/images/piekary9/placeholder-plan.jpg";
					const pdfHref = typeof item.pdf === 'string' ? item.pdf : item.pdf?.url;
					
					return (
						<tr class="apartment-row group cursor-pointer transition-colors hover:bg-brand-accent/5" data-id={item.id} data-rooms={item.rooms} data-floor={item.floor} data-area={item.area} data-status={item.status} data-price={item.price || 0} data-price-m2={pricePerM2 || 0}>
							<td class="px-4 py-4">
								<div class="flex items-center gap-3">
									<span class="font-heading text-lg font-bold text-brand-accent w-8">M{item.id}</span>
									<div class="h-10 w-14 overflow-hidden rounded bg-brand-dark/5 shrink-0">
										<img src={mainImage} alt={`Rzut lokalu ${item.label}`} class="h-full w-full object-cover mix-blend-multiply" loading="lazy" />
									</div>
									<div class="flex items-center gap-2">
										<span class={`h-2.5 w-2.5 rounded-full ${status.dot} shrink-0`}></span>
										<span class={`text-[10px] font-bold uppercase tracking-wider ${status.text} whitespace-nowrap`}>{status.label}</span>
									</div>
								</div>
							</td>
							<td class="px-4 py-4 font-bold text-brand-primary text-center">{item.rooms}</td>
							<td class="px-4 py-4 text-brand-dark text-center">{item.area} m²</td>
							<td class="px-4 py-4 text-brand-dark text-center">{item.floor}</td>
							<td class="px-4 py-4 text-brand-dark/60 text-center text-xs">{finish}</td>
							<td class="px-4 py-4 font-bold text-brand-dark text-right whitespace-nowrap">{formatPrice(item.price)}</td>
							<td class="px-4 py-4 text-brand-dark/60 text-right whitespace-nowrap">{formatPrice(pricePerM2)}</td>
							<td class="px-4 py-4 text-center">
								{pdfHref ? (
									<a 
										href={pdfHref}
										target="_blank" 
										class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-dark/60 hover:text-brand-accent transition-colors cursor-pointer"
										title="Pobierz PDF"
									>
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
										PDF
									</a>
								) : "-"}
							</td>
							<td class="px-4 py-4 text-right">
								<button 
									type="button"
									class="js-open-card inline-flex items-center justify-center rounded border border-brand-dark/20 px-3 py-1.5 text-xs font-bold text-brand-dark transition hover:border-brand-accent hover:text-brand-accent whitespace-nowrap cursor-pointer"
									data-id={item.id}
								>
									Karta lokalu
								</button>
							</td>
						</tr>
					);
				})}
			</tbody>
		</table>
		
		<div id="no-results-msg" class="hidden py-12 text-center text-brand-dark/50">
			Brak lokali spełniających kryteria filtrowania.
		</div>
	</div>

	<!-- Expand Overlay -->
	<div id="table-expand-overlay" class="absolute inset-x-0 bottom-0 flex h-64 items-end justify-center pointer-events-none z-20">
		<!-- Gradient & Blur Layer -->
		<div class="absolute inset-0 bg-gradient-to-t from-brand-light via-brand-light/95 to-transparent backdrop-blur-[3px] [mask-image:linear-gradient(to_top,black_40%,transparent)] pointer-events-none"></div>
		
		<!-- Button Layer -->
		<button 
			id="table-expand-btn"
			type="button" 
			class="group pointer-events-auto relative mb-8 overflow-hidden rounded-lg bg-brand-accent px-8 py-3.5 text-[11px] font-black uppercase tracking-widest text-brand-dark shadow-[0_10px_30px_rgba(197,168,107,0.3)] transition-all hover:shadow-[0_15px_40px_rgba(197,168,107,0.5)] active:scale-95 cursor-pointer"
		>
			<span class="absolute inset-0 translate-y-full bg-brand-dark transition-transform duration-300 ease-out group-hover:translate-y-0"></span>
			<span class="relative z-10 flex items-center gap-3 transition-colors duration-300 group-hover:text-white">
				<span>{ui.showAll}</span>
				<i class="ph ph-caret-down text-base transition-transform duration-300 group-hover:translate-y-0.5"></i>
			</span>
		</button>
	</div>

	<!-- Collapse Button (Bottom) -->
	<div id="table-collapse-container" class="hidden justify-center py-12 bg-brand-cream/10 border-t border-brand-dark/5 relative z-30">
		<button 
			id="table-collapse-btn"
			type="button" 
			class="group pointer-events-auto relative overflow-hidden rounded-lg bg-brand-accent px-8 py-3.5 text-[11px] font-black uppercase tracking-widest text-brand-dark shadow-lg transition-all hover:shadow-xl active:scale-95 cursor-pointer"
		>
			<span class="absolute inset-0 translate-y-full bg-brand-dark transition-transform duration-300 ease-out group-hover:translate-y-0"></span>
			<span class="relative z-10 flex items-center gap-3 transition-colors duration-300 group-hover:text-white">
				<span>{ui.collapse}</span>
				<i class="ph ph-caret-up text-base transition-transform duration-300 group-hover:-translate-y-0.5"></i>
			</span>
		</button>
	</div>
</div>

<script>
	// Simple filtering logic based on events from ApartmentsFilterBar
	document.addEventListener('DOMContentLoaded', () => {
		const rows = document.querySelectorAll('.apartment-row') as NodeListOf<HTMLElement>;

		// Add click listener to the entire row
		rows.forEach(row => {
			row.addEventListener('click', (e) => {
				// Don't trigger if clicked on a button or link inside the row
				const target = e.target as HTMLElement;
				if (target.closest('button') || target.closest('a')) return;

				const aptId = row.getAttribute('data-id');
				if (aptId) {
					// Use the same logic as the button click
					const apartmentsJson = (document.getElementById('building-canvas') as HTMLElement)?.dataset.apartments;
					if (apartmentsJson) {
						const apartments = JSON.parse(apartmentsJson);
						const apt = apartments.find((a: any) => a.id === aptId);
						if (apt) {
							import("../scripts/modal").then((m) => m.openModal(apt));
						}
					}
				}
			});
		});

		const noResultsMsg = document.getElementById('no-results-msg');
		const table = document.getElementById('apartments-table');
		
		// Active filters state
		const filters = {
			status: 'available' as string,
			rooms: new Set<string>(),
			floor: new Set<string>(),
			area: 100 as number
		};

		window.addEventListener('filter-apartments', (e: Event) => {
			const detail = (e as CustomEvent).detail;
			
			if (detail.type === 'status') {
				filters.status = detail.value;
			} else if (detail.type === 'rooms' || detail.type === 'floor') {
				const filterType = detail.type as 'rooms' | 'floor';
				const filterSet = filters[filterType];
				if (detail.singleSelect) {
					filterSet.clear();
				}
				if (detail.isActive) {
					filterSet.add(detail.value);
				} else {
					filterSet.delete(detail.value);
				}
			} else if (detail.type === 'area') {
				filters.area = parseFloat(detail.value);
			}

			applyFilters();
		});

		// ── Expand/Collapse functionality ──────────────────────────────────
		const container = document.getElementById('table-expand-container');
		const overlay = document.getElementById('table-expand-overlay');
		const expandBtn = document.getElementById('table-expand-btn');
		const collapseBtn = document.getElementById('table-collapse-btn');
		const collapseContainer = document.getElementById('table-collapse-container');

		const expand = () => {
			if (!container || !overlay || !collapseContainer) return;
			container.style.maxHeight = 'none';
			container.classList.remove('is-collapsed');
			overlay.style.display = 'none';
			collapseContainer.style.display = 'flex';
		};

		const collapse = () => {
			if (!container || !overlay || !collapseContainer) return;
			
			const anchor = document.getElementById('apartments-anchor');
			
			// 1. Shrink table
			container.style.maxHeight = '520px';
			container.classList.add('is-collapsed');
			
			// 2. Reset UI overlay bits
			overlay.style.display = 'flex';
			collapseContainer.style.display = 'none';

			// 3. Scrolling to anchor using the Lenis engine
			// We use a global instance (defined in Layout.astro) to avoid
			// conflicts with smooth page scrolling.
			if (anchor) {
				const lenis = (window as any).lenis;
				if (lenis) {
					lenis.scrollTo(anchor, {
						offset: -120,
						duration: 1.2,
						lock: true // Ensure scroll is not interrupted
					});
				} else {
					// Fallback for native scroll
					setTimeout(() => {
						anchor.scrollIntoView({
							behavior: 'smooth',
							block: 'start'
						});
					}, 50);
				}
			}
		};

		if (expandBtn) expandBtn.addEventListener('click', expand);
		if (collapseBtn) collapseBtn.addEventListener('click', collapse);

		function applyFilters() {
			let visibleCount = 0;

			rows.forEach(row => {
				const status = row.getAttribute('data-status');
				const rooms = row.getAttribute('data-rooms');
				const floor = row.getAttribute('data-floor');
				const area = parseFloat(row.getAttribute('data-area') || '0');

				let match = true;

				if (filters.status === 'available' && status !== 'available') match = false;
				if (filters.rooms.size > 0 && !filters.rooms.has(rooms || '')) match = false;
				if (filters.floor.size > 0 && !filters.floor.has(floor || '')) match = false;
				if (area > filters.area) match = false;

				if (match) {
					row.style.display = '';
					visibleCount++;
				} else {
					row.style.display = 'none';
				}
			});

			// Update expand visibility
			if (container?.classList.contains('is-collapsed')) {
				if (visibleCount <= 4) {
					if (overlay) overlay.style.display = 'none';
					container.style.maxHeight = 'none';
				} else {
					if (overlay) overlay.style.display = 'flex';
					container.style.maxHeight = '520px';
				}
			} else {
				// If not collapsed, ensure overlay stays hidden and collapse shows if results > 4
				if (overlay) overlay.style.display = 'none';
				if (collapseContainer) {
					collapseContainer.style.display = visibleCount > 4 ? 'flex' : 'none';
				}
			}

			if (visibleCount === 0) {
				table!.style.display = 'none';
				noResultsMsg!.classList.remove('hidden');
			} else {
				table!.style.display = '';
				noResultsMsg!.classList.add('hidden');
			}
		}
		
		// ── Sorting logic ──────────────────────────────────────────────────
		const tableBody = table?.querySelector('tbody');
		const sortHeaders = document.querySelectorAll('th[data-sort-key]') as NodeListOf<HTMLElement>;
		
		let currentSort = { key: '' as string, order: 'asc' as 'asc' | 'desc' };

		sortHeaders.forEach(header => {
			header.addEventListener('click', () => {
				const key = header.getAttribute('data-sort-key')!;
				const isAsc = currentSort.key === key && currentSort.order === 'asc';
				currentSort.order = isAsc ? 'desc' : 'asc';
				currentSort.key = key;

				// Reset icons
				sortHeaders.forEach(h => {
					const icon = h.querySelector('i');
					if (icon) {
						icon.className = 'ph ph-sort-ascending text-brand-dark/40';
					}
					h.classList.remove('text-brand-accent');
				});

				// Update current header
				const icon = header.querySelector('i');
				if (icon) {
          icon.className = currentSort.order === 'asc'
            ? 'ph ph-sort-ascending text-brand-accent'
            : 'ph ph-sort-descending text-brand-accent';
				}
				header.classList.add('text-brand-accent');

				sortRows(key, currentSort.order);
			});
		});

		function sortRows(key: string, order: 'asc' | 'desc') {
			if (!tableBody) return;
			const rowsArray = Array.from(rows);
			const sortedRows = rowsArray.sort((a, b) => {
				const valA = a.getAttribute(`data-${key}`) || '0';
				const valB = b.getAttribute(`data-${key}`) || '0';
				
				const numA = parseFloat(valA);
				const numB = parseFloat(valB);
				
				if (!isNaN(numA) && !isNaN(numB)) {
					return order === 'asc' ? numA - numB : numB - numA;
				}
				
				return order === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
			});

			sortedRows.forEach(row => tableBody.appendChild(row));
		}
		
		// Apply initial filters
		applyFilters();
	});
</script>


