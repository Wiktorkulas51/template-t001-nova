---
import ui from '@data/sections/piekary9-navigator-ui.json';
// PurchaseDrawer.astro - Slide-over drawer for finalizing purchase/reservation
import company from "@data/global/company.json";
---

<div id="purchase-drawer-overlay" class="fixed inset-0 z-[60] flex justify-end opacity-0 pointer-events-none transition-opacity duration-300 bg-slate-900/60 backdrop-blur-sm" aria-hidden="true">
  
  <aside 
    id="purchase-drawer" 
    class="relative w-full max-w-md h-full bg-white shadow-2xl flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] translate-x-full"
    role="dialog" 
    aria-modal="true" 
    aria-labelledby="drawer-title"
  >
    <!-- Header -->
    <div class="flex items-center justify-between p-5 border-b border-slate-100 shrink-0">
      <h2 id="drawer-title" class="text-lg font-black text-slate-900 tracking-tight">{ui.formTitle}</h2>
      <button id="drawer-close-btn" class="w-8 h-8 flex items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-900 transition-colors cursor-pointer" aria-label="Zamknij">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Body - Scrollable -->
    <div class="flex-1 overflow-y-auto custom-scrollbar p-5 flex flex-col gap-6">
      
      <!-- Selected Apartment Summary -->
      <div class="flex items-center gap-4 p-3 rounded-xl bg-slate-50 border border-slate-100">
        <div class="w-16 h-16 rounded-lg bg-white overflow-hidden shadow-sm shrink-0">
          <img id="drawer-apt-image" src="/images/piekary9/placeholder-plan.jpg" alt="Rzut" class="w-full h-full object-cover"/>
        </div>
        <div class="flex flex-col">
          <span class="text-[0.65rem] font-bold uppercase tracking-widest text-slate-400 mb-0.5">{ui.selectedLocal}</span>
          <h3 id="drawer-apt-title" class="text-lg font-bold text-slate-900 leading-none mb-1">{ui.local20}</h3>
          <div class="flex items-baseline gap-2 mt-1">
            <span id="drawer-apt-area" class="text-xs font-semibold text-slate-500">48.6 m²</span>
            <span class="text-slate-300">•</span>
            <span id="drawer-apt-price" class="text-sm font-black text-slate-900">505 000 zł</span>
          </div>
        </div>
      </div>

      <!-- Form Instructions -->
      <div>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">
          Zostaw swoje dane. Nasz doradca skontaktuje się z Tobą w ciągu 24h, aby odpowiedzieć na pytania lub potwierdzić rezerwację.
        </p>
      </div>

      <!-- Form Fields -->
      <form id="purchase-form" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1.5">
          <label for="form-name" class="text-xs font-bold text-slate-700">Imię i nazwisko <span class="text-red-500">*</span></label>
          <input type="text" id="form-name" name="name" required placeholder="Jan Kowalski" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition-colors" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="form-phone" class="text-xs font-bold text-slate-700">Numer telefonu <span class="text-red-500">*</span></label>
          <input type="tel" id="form-phone" name="phone" required placeholder="+48 000 000 000" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition-colors" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="form-email" class="text-xs font-bold text-slate-700">Adres e-mail <span class="text-red-500">*</span></label>
          <input type="email" id="form-email" name="email" required placeholder="jan@example.com" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition-colors" />
        </div>

        <div class="flex flex-col gap-1.5 mt-2">
          <label for="form-message" class="text-xs font-bold text-slate-700">{ui.optionalMessage}</label>
          <textarea id="form-message" name="message" rows="3" placeholder="Chcę zapytać o..." class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition-colors resize-none"></textarea>
        </div>
      </form>
      
      <!-- Success State (Hidden initially) -->
      <div id="drawer-success-state" class="hidden flex w-full flex-col items-center justify-center text-center py-10">
        <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center text-green-600 mb-4">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <h3 class="text-xl font-black text-slate-900 mb-2">{ui.thankYou}</h3>
        <p class="text-sm text-slate-600">
          Twoje zapytanie zostało wysłane. Skontaktujemy się z Tobą najszybciej jak to możliwe.
        </p>
      </div>

      <!-- Error state (Hidden initially) -->
      <div id="drawer-error-state" class="hidden flex w-full flex-col items-center justify-center text-center py-6">
        <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center text-red-600 mb-4">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <h3 class="text-lg font-black text-slate-900 mb-1">{ui.error}</h3>
        <p class="text-sm text-slate-600">
          Nie udało się wysłać formularza. Sprawdź dane i spróbuj ponownie.
        </p>
      </div>

    </div>

    <!-- Footer / Sticky CTA -->
    <div id="drawer-footer" class="p-5 border-t border-slate-100 bg-white shrink-0">
      <div class="mb-4 text-center">
        <p class="text-[10px] leading-relaxed text-slate-400">
          Wysyłając formularz, wyrażasz zgodę na przetwarzanie danych osobowych w celu obsługi zapytania przez {company.name} zgodnie z naszą 
          <a href="/polityka-prywatnosci/" class="text-slate-900 font-bold hover:underline">{ui.privacy}</a> 
          oraz polityką <a href="/cookies/" class="text-slate-900 font-bold hover:underline">{ui.cookies}</a>.
        </p>
      </div>
      <button id="submit-purchase-btn" type="button" class="flex items-center justify-center w-full py-3.5 px-6 bg-slate-900 text-white font-bold text-sm rounded-xl hover:bg-slate-800 transition-colors shadow-md shadow-slate-900/10 cursor-pointer">
        <span id="submit-btn-text">{ui.send}</span>
        <svg id="submit-btn-loader" class="hidden w-5 h-5 ml-2 text-white animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
      </button>
    </div>
  </aside>
</div>





