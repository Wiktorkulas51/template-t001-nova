---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import jsonData from "@data/sections/about-bento-home.json";

type Stat = { value: string; label: string; tone?: "light" | "dark" };
export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string }

const { data, locale = "pl", sectionId = "about-hero-bento", class: className = "" } = Astro.props as Props;
const source = data ?? jsonData;
const t = source[locale] ?? source.pl;
const stats = (t.stats ?? []) as Stat[];
---

<Section id={sectionId} tone="base" class:list={["relative overflow-hidden py-10 md:py-[72px]", className]}>
  <Container>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-6 lg:gap-12">
      <article class="ui-card-interactive group flex flex-col justify-between rounded-[3rem] border border-brand-dark/10 bg-white p-10 shadow-soft md:p-16 lg:col-span-4">
        <div>
          <Text variant="accent-label" tag="p" class="mb-6 text-brand-primary">{t.eyebrow}</Text>
          <Heading tag="h2" variant="section-heading-xl" class="mb-8 text-brand-dark">{t.heading}</Heading>
          <Text variant="lead" class="mb-8 max-w-2xl text-brand-dark/70">{t.paragraphOne}</Text>
          <Text variant="body" class="max-w-2xl text-brand-dark/60">{t.paragraphTwo}</Text>
        </div>
        <Button href={t.cta.href} variant="ghost" size="md" class="mt-12 w-fit px-0 text-brand-primary" hoverText={t.cta.hoverText}>
          {t.cta.label}<span aria-hidden="true">↗</span>
        </Button>
      </article>

      <div class="flex flex-col gap-8 lg:col-span-2">
        {stats.map((stat, index) => (
          <div
            class:list={[
              "group flex flex-1 flex-col items-center justify-center rounded-[3rem] border p-10 text-center transition duration-500",
              stat.tone === "dark" ? "border-brand-primary bg-brand-primary text-white shadow-soft hover:bg-brand-primary/90" : "border-brand-dark/10 bg-brand-primary/[0.04] text-brand-dark hover:bg-white hover:shadow-soft",
            ]}
          >
            <span class:list={["mb-2 text-6xl font-black", stat.tone === "dark" ? "text-white" : "text-brand-primary"]}>{stat.value}</span>
            <Text variant="disclaimer" class:list={["font-bold uppercase tracking-[0.2em]", stat.tone === "dark" ? "text-white/70" : "text-brand-dark/55"]}>{stat.label}</Text>
          </div>
        ))}
      </div>
    </div>
  </Container>
</Section>
