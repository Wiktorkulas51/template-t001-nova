---
// Why: AboutTomRosBlock is a visual copy of the "About me" section from the tom-ros project:
// split text + video with full controls (play/pause, mute, volume), stats,
// categories and joinTeam panel. "props || json" pattern as in AboutMarqueeSplitBlock,
// so PageBuilder can override any field, and the rest comes from section data.
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import aboutData from "@data/sections/about-tomros.json";

type Stat = { value?: string; label?: string };
type JoinTeam = { title?: string; intro?: string; paragraphs?: string[]; cta?: string; ctaHover?: string };

export interface Props {
  sectionId?: string;
  eyebrow?: string;
  title?: string;
  accentTitle?: string;
  intro?: string;
  bio?: string[];
  stats?: Stat[];
  categories?: string[];
  /** Category list heading label, editable from JSON. */
  categoriesLabel?: string;
  image?: string;
  imageAlt?: string;
  /** Optional video instead of image (autoplay, muted, loop) or YouTube embed via youtubeId. */
  video?: {
    poster?: string;
    sources?: { src: string; type?: string }[];
    /** Accessibility labels for video controls, editable from JSON. */
    ariaPlay?: string;
    ariaMute?: string;
    ariaVolume?: string;
    /** When set, renders youtube-nocookie iframe instead of video file. */
    youtubeId?: string;
  };
  /** Mini CTA "Join us" - welcome text + button to form. */
  joinTeam?: JoinTeam;
  /** Section heading tag: 'h2' on homepage, 'h1' on subpages (SEO). */
  headingTag?: string;
}

const {
  sectionId = "o-nas",
  eyebrow = "",
  title = "",
  accentTitle = "",
  intro = "",
  bio = [],
  stats = [],
  categories = [],
  categoriesLabel = "",
  image,
  imageAlt = "",
  video,
  joinTeam,
  headingTag = "h2",
} = Astro.props as Props;

// Why: "props || json" pattern from starter-kit - props override section data,
// so one block serves many pages without duplicating components.
const resolvedEyebrow = eyebrow || aboutData.eyebrow;
const resolvedTitle = title || aboutData.title;
const resolvedAccentTitle = accentTitle || aboutData.accentTitle;
const resolvedIntro = intro || aboutData.intro;
const resolvedBio = bio.length > 0 ? bio : aboutData.bio;
const resolvedStats = stats.length > 0 ? stats : aboutData.stats;
const resolvedCategories = categories.length > 0 ? categories : aboutData.categories;
const resolvedCategoriesLabel = categoriesLabel || aboutData.categoriesLabel;
const resolvedImage = image || undefined;
const resolvedImageAlt = imageAlt || "Zdjęcie zespołu";
const resolvedVideo = video || aboutData.video;
const resolvedJoinTeam = joinTeam || aboutData.joinTeam;

const videoSources = Array.isArray(resolvedVideo?.sources) ? resolvedVideo.sources : [];
---

<Section id={sectionId} tone="page" class="overflow-x-clip">
  <Container>
    <div class="relative grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="space-y-6">
        {resolvedEyebrow && <p class="ui-type-accent-label text-brand-primary">{resolvedEyebrow}</p>}

        <div class="space-y-3">
          <!-- Why: title in Anton (font-heading + font-[Anton]) with accent
               Italic on brand-primary, exactly as in original tom-ros. -->
          <Heading tag={headingTag} class="font-[Anton] text-5xl uppercase leading-[0.95] tracking-[-0.02em] text-brand-dark md:text-6xl">
            {resolvedTitle}
          </Heading>
          {resolvedAccentTitle && (
            <p class="font-bold italic uppercase text-brand-primary text-3xl md:text-4xl">
              {resolvedAccentTitle}
            </p>
          )}
        </div>

        {resolvedIntro && (
          <Text variant="lead" class="text-brand-dark/80">
            {resolvedIntro}
          </Text>
        )}

        <div class="space-y-4">
          {resolvedBio.map((paragraph) => (
            <Text variant="body" class="text-on-surface-variant">
              {paragraph}
            </Text>
          ))}
        </div>
      </div>

      <div class="relative self-start">
        {resolvedVideo?.youtubeId ? (
          <>
            <div class="ui-glow ui-glow-about-video" aria-hidden="true"></div>
            <!-- Why: YouTube embed without cookies (nocookie), aspect 16:9,
                 lazy loading - used when client provides youtubeId in data. -->
            <div class="ui-glow-frame relative aspect-video w-full overflow-hidden rounded-2xl bg-black ring-1 ring-white/10">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${resolvedVideo.youtubeId}`}
                title={resolvedImageAlt}
                class="absolute inset-0 h-full w-full border-0"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
          </>
        ) : resolvedVideo && videoSources.length > 0 ? (
          <>
            <!-- Why: we anchor glow under video to illuminate the footage,
                 not the adjacent text. -->
            <div class="ui-glow ui-glow-about-video" aria-hidden="true"></div>
            <div class="ui-glow-frame relative overflow-hidden rounded-2xl bg-black ring-1 ring-white/10" data-video-shell>
              <video
                class="aspect-[8/5] w-full object-contain"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={resolvedImageAlt}
                data-video
              >
                {videoSources.map((source) => (
                  <source src={source.src} type={source.type || "video/mp4"} />
                ))}
              </video>

              <!-- Why: scrim (gradient) at bottom ensures button readability
                   on every video frame; buttons are always visible. -->
              <div class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-3 bg-gradient-to-t from-black/75 via-black/35 to-transparent px-4 pb-3 pt-12">
                <button
                  type="button"
                  class="flex size-11 cursor-pointer items-center justify-center rounded-full bg-brand-primary text-white shadow-lg transition-all duration-200 hover:scale-105 hover:bg-brand-accent focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/50"
                  aria-label={resolvedVideo?.ariaPlay || "Odtwarzaj lub zatrzymaj wideo"}
                  data-action="play"
                >
                  <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-play>
                    <path d="M8 5.14v13.72L19 12 8 5.14z" />
                  </svg>
                  <svg class="hidden size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-pause>
                    <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
                  </svg>
                </button>

                <div class="group relative">
                  <!-- Why: invisible "hotspot" above mute button allows
                       hovering it before the vertical volume slider slides out. -->
                  <span
                    aria-hidden="true"
                    class="absolute bottom-full left-1/2 h-32 w-16 -translate-x-1/2"
                  ></span>
                  <input
                    type="range"
                    min="0"
                    max="1"
                    step="0.05"
                    value="0.5"
                    class="pointer-events-none absolute bottom-full left-1/2 mb-3 h-24 w-1.5 origin-bottom -translate-x-1/2 cursor-pointer accent-brand-primary opacity-0 [direction:rtl] [writing-mode:vertical-lr] transition-all delay-300 duration-300 group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100 group-hover:delay-0 group-focus-within:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:opacity-100 group-focus-within:delay-0 sm:h-28"
                    aria-label={resolvedVideo?.ariaVolume || "Regulacja głośności"}
                    data-action="volume"
                  />

                  <button
                    type="button"
                    class="flex size-11 cursor-pointer items-center justify-center rounded-full border border-white/30 bg-black/50 text-white backdrop-blur-sm transition-all duration-200 hover:scale-105 hover:bg-white/20 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/50"
                    aria-label={resolvedVideo?.ariaMute || "Wycisz lub włącz dźwięk"}
                    data-action="mute"
                  >
                    <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-volume-on>
                      <path d="M3 9v6h4l5 5V4L7 9H3zM16.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
                    </svg>
                    <svg class="hidden size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-volume-off>
                      <path d="M3 9v6h4l5 5V4L7 9H3zM16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            {resolvedStats.length > 0 && (
              <div class="mt-6 grid grid-cols-2 gap-4 border-t border-brand-primary/20 pt-6 sm:grid-cols-4">
                {resolvedStats.map((stat) => (
                  <div class="border-l-2 border-brand-primary/60 pl-3 sm:pl-4">
                    <div class="font-[Anton] text-3xl leading-none text-brand-primary sm:text-4xl">{stat.value}</div>
                    <div class="mt-2 text-[10px] font-bold uppercase leading-snug tracking-[0.12em] text-on-surface-variant opacity-70 sm:text-[11px]">
                      {stat.label}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {resolvedCategories.length > 0 && (
              <div class="mt-7 border-t border-brand-primary/15 pt-5">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-on-surface-variant">
                  {resolvedCategoriesLabel}
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {resolvedCategories.map((cat) => (
                    <span class="rounded-md border border-outline-variant bg-surface-card px-3 py-1.5 text-xs font-bold uppercase tracking-[0.12em] text-on-surface-variant">
                      {cat}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </>
        ) : resolvedImage ? (
          <div class="ui-glow-frame relative aspect-[4/3] overflow-hidden rounded-2xl ring-1 ring-white/10">
          <img src={resolvedImage} alt={resolvedImageAlt} width="800" height="600" class="size-full object-cover" loading="lazy" />
          </div>
        ) : null}
      </div>
    </div>

    <!-- Why: mini CTA "Join us" full width below grid,
         with button to form and red glow (ui-glow). -->
    {resolvedJoinTeam && (
      <div class="relative mt-16 overflow-hidden rounded-2xl border border-brand-primary/30 bg-surface-card p-8 md:p-12">
        <div class="ui-glow ui-glow-about-panel" aria-hidden="true"></div>

        <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div class="space-y-4">
            <p class="ui-type-accent-label text-brand-primary">{resolvedJoinTeam.title}</p>
            {resolvedJoinTeam.intro && (
              <Text variant="body" class="text-brand-dark">
                {resolvedJoinTeam.intro}
              </Text>
            )}
            <div class="space-y-2">
              {(resolvedJoinTeam.paragraphs ?? []).map((paragraph) => (
                <p class="text-sm leading-relaxed text-on-surface-variant">{paragraph}</p>
              ))}
            </div>
          </div>
          <div class="lg:pl-12">
            <Button
              href="/kontakt/"
              variant="primary"
              size="lg"
              hoverText={resolvedJoinTeam.ctaHover || "Napisz do nas"}
              class="whitespace-nowrap"
            >
              {resolvedJoinTeam.cta || "Wypełnij formularz"}
            </Button>
          </div>
        </div>
      </div>
    )}
  </Container>
</Section>

<script>
  // Why: video controls (play/pause + mute + volume) - autoplay muted stays,
  // but user can pause video, enable sound and adjust volume.
  // Icons toggled with hidden class, volume slider is vertical and slides out above mute.
  //
  // IMPORTANT: init in astro:page-load instead of module start, because page
  // uses ClientRouter (view transitions). After navigation between subpages DOM is
  // swapped, and script run once would not see new buttons.
  const initVideoControls = () => {
    const shell = document.querySelector<HTMLElement>("[data-video-shell]");
    // Why: guard instanceof (HeroCinematicBlock pattern) narrows Element type
    // to HTMLElement so TS sees dataset without blind casting.
    if (!(shell instanceof HTMLElement)) return;
    // Why: flag protects against double binding if page-load
    // fires for the same (not yet replaced) element.
    if (shell.dataset.vtBound === "true") return;
    shell.dataset.vtBound = "true";

    const video = shell.querySelector<HTMLVideoElement>("video[data-video]");
    // Why: guard instanceof narrows type to HTMLVideoElement, so
    // TS accepts video properties (paused, muted, volume, play, pause).
    if (!(video instanceof HTMLVideoElement)) return;

    const playBtn = shell.querySelector('[data-action="play"]');
    const muteBtn = shell.querySelector('[data-action="mute"]');
    const volumeControl = shell.querySelector('[data-action="volume"]');
    const playIcon = shell.querySelector("[data-icon-play]");
    const pauseIcon = shell.querySelector("[data-icon-pause]");
    const volOnIcon = shell.querySelector("[data-icon-volume-on]");
    const volOffIcon = shell.querySelector("[data-icon-volume-off]");

    // Why: sync reflects video state on buttons (play/pause, muted)
    // and is triggered on video events and at startup.
    const sync = () => {
      const paused = video.paused || video.ended;
      playIcon?.classList.toggle("hidden", !paused);
      pauseIcon?.classList.toggle("hidden", paused);
      const muted = video.muted;
      volOnIcon?.classList.toggle("hidden", muted);
      volOffIcon?.classList.toggle("hidden", !muted);
      if (volumeControl instanceof HTMLInputElement) {
        volumeControl.value = String(video.volume);
      }
    };

    playBtn?.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      // After manual state change autoplay must not override user decision.
      video.autoplay = false;
      if (video.paused || video.ended) {
        void video.play().catch(() => sync());
      } else {
        video.pause();
      }
      // Why: sync after every action - some browsers do not emit
    // video events (play/pause/volumechange), so we refresh icons manually.
      sync();
    });

    muteBtn?.addEventListener("click", () => {
      if (video.muted && video.volume === 0) {
        video.volume = 0.5;
      }
      video.muted = !video.muted;
      sync();
    });

    volumeControl?.addEventListener("input", (event) => {
      const input = event.currentTarget;
      if (!(input instanceof HTMLInputElement)) return;
      video.volume = Number(input.value);
      video.muted = video.volume === 0;
      sync();
    });

    ["play", "pause", "volumechange"].forEach((evt) => video.addEventListener(evt, sync));
    // Why: moderate level after manually enabling sound does not surprise the user.
    video.volume = 0.5;
    sync();
  };

  document.addEventListener("astro:page-load", initVideoControls);
</script>
