---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";

interface Props {
  class?: string;
  tagline?: string;
  title?: string;
  description?: string;
  details?: string[];
}

const defaultHighlights = [
  {
    icon: "calendar",
    label: "Doświadczenie od lat",
    desc: "Firma formalnie istnieje od 2021 roku, ale nasze doświadczenie w budownictwie drewnianym sięga znacznie dalej.",
  },
  {
    icon: "certificate",
    label: "Certyfikowane materiały",
    desc: "Pracujemy wyłącznie na drewnie konstrukcyjnym C24, BSH i KVH.",
  },
  {
    icon: "map",
    label: "Zasięg działania",
    desc: "Domy drewniane budujemy w promieniu do 100 km. Ocieplenia pianą PUR wykonujemy do 200 km.",
  },
  {
    icon: "house",
    label: "Stan surowy i pod klucz",
    desc: "Doprowadzamy inwestycję do etapu, który najbardziej Ci odpowiada.",
  },
];

const {
  class: className = "",
  tagline = "O firmie",
  title = "Budowa domów drewnianych z doświadczeniem",
  description = "Domki z drewna Przemysław Stałanowski to firma, która specjalizuje się w budowie wysokiej jakości konstrukcji drewnianych. Działalność została formalnie założona w 2021 roku, ale doświadczenie w budownictwie drewnianym zdobywaliśmy wiele lat wcześniej, pracując przy różnorodnych projektach. Tworzymy nowoczesne i trwałe domy szkieletowe, całoroczne oraz letniskowe, dopasowane do indywidualnych potrzeb klientów.",
  details,
} = Astro.props;

const highlights = details?.length
  ? details.map((detail, index) => ({
      icon: defaultHighlights[index % defaultHighlights.length].icon,
      label: detail,
      desc: "",
    }))
  : defaultHighlights;
---

<Section class:list={["ui-bg-page", className]}>
  <Container>
    <div class="flex flex-col items-center text-center gap-6 mb-12 md:mb-16 mx-auto max-w-6xl">
      <Text variant="accent-label">{tagline}</Text>
      <Heading level={2} variant="section-title" class="text-balance max-w-4xl">{title}</Heading>
      <Text variant="lead" class="max-w-3xl md:max-w-5xl font-normal">{description}</Text>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
      {highlights.map((h, i) => (
        <div
          class="flex-col lg:flex-row flex gap-4 lg:gap-5 p-6 bg-white rounded-2xl border border-brand-dark/10 hover:border-brand-primary/20 transition-all duration-300 lg:text-left text-center"
        >
          <div class="w-12 h-12 rounded-xl bg-brand-primary/5 border border-brand-primary/10 flex items-center justify-center shrink-0 lg:mt-1 self-center lg:self-start">
            {h.icon === "calendar" && (
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-width="2" stroke-linecap="round"/>
              </svg>
            )}
            {h.icon === "certificate" && (
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-width="2" stroke-linecap="round"/>
              </svg>
            )}
            {h.icon === "map" && (
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-width="2"/>
                <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-width="2"/>
              </svg>
            )}
            {h.icon === "house" && (
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" stroke-width="2" stroke-linecap="round"/>
              </svg>
            )}
          </div>
          <div class="flex-1 min-w-0">
            <Heading level={4} variant="feature-title" class="text-brand-dark mb-1">
              {h.label}
            </Heading>
            {h.desc && <Text variant="body" class="text-brand-dark/60 text-sm leading-relaxed">{h.desc}</Text>}
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>
