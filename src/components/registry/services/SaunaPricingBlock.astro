---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import SectionHeader from "@components/ui/molecules/SectionHeader.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";

// Dane sekcji przekazywane z PageBuilder (src/data/sections/sauna-pricing.json)
interface PlanItem {
  name: string;
  price: string;
  period: string;
  desc: string;
  features: string[];
  cta: string;
  highlight: boolean;
}

interface Props {
  tagline?: string;
  title?: string;
  description?: string;
  note?: string;
  plans?: PlanItem[];
}

const {
  tagline = "Cennik",
  title = "Orientacyjne ceny wynajmu",
  description = "Koszt wynajmu zależy od rodzaju zestawu.",
  note = "* Ceny mają charakter orientacyjny.",
  plans = [],
} = Astro.props;
---

<Section tone="page" id="sauna-pricing">
  <Container>
    <SectionHeader
      tagline={tagline}
      title={title}
      description={description}
      align="center"
    />

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {plans.map((plan, i) => (
        <div
          class={`relative flex flex-col rounded-2xl border transition-all duration-500 p-8 ${
            plan.highlight
              ? "bg-brand-primary border-brand-primary shadow-2xl scale-105 md:scale-110 z-10"
              : "bg-white border-brand-dark/5 hover:border-brand-accent/30"
          }`}
        >
          {plan.highlight && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-flex items-center px-3 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold uppercase whitespace-nowrap tracking-wider text-white bg-brand-accent rounded-md shadow-lg">
              Najczęściej wybierany
            </span>
          )}

          <Heading level={3} variant="feature-title" class={`text-lg mb-1 ${plan.highlight ? "text-brand-light" : "text-brand-dark"}`}>
            {plan.name}
          </Heading>

          <Text variant="body" class={`text-sm mb-5 ${plan.highlight ? "text-brand-light/70" : "text-brand-dark/60"}`}>
            {plan.desc}
          </Text>

          <div class={`flex items-baseline gap-1 mb-6 ${plan.highlight ? "text-brand-light" : "text-brand-dark"}`}>
            <span class="text-3xl sm:text-4xl font-bold tracking-tight">{plan.price}</span>
            <span class={`text-sm ${plan.highlight ? "text-brand-light/60" : "text-brand-dark/40"}`}>{plan.period}</span>
          </div>

          <ul class="space-y-3 mb-6 flex-1">
            {plan.features.map((f) => (
              <li class={`flex items-start gap-3 text-sm ${plan.highlight ? "text-brand-light/80" : "text-brand-dark/60"}`}>
                <svg class={`w-4 h-4 shrink-0 mt-0.5 ${plan.highlight ? "text-brand-accent" : "text-brand-accent"}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2" stroke-linecap="round"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>

          <span class="max-md:hidden">
            {plan.highlight ? (
              <a href="#dcontact" class="inline-flex items-center justify-center gap-1.5 px-5 sm:px-8 h-11 sm:h-12 rounded-md bg-white text-brand-dark font-bold text-sm sm:text-lg transition-all hover:bg-brand-cream shadow-lg w-full">{plan.cta}</a>
            ) : (
              <Button href="#dcontact" variant="primary" size="lg" class="w-full">{plan.cta}</Button>
            )}
          </span>
          <span class="md:hidden">
            {plan.highlight ? (
              <a href="#kontakt" class="inline-flex items-center justify-center gap-1.5 px-5 sm:px-8 h-11 sm:h-12 rounded-md bg-white text-brand-dark font-bold text-sm sm:text-lg transition-all hover:bg-brand-cream shadow-lg w-full">{plan.cta}</a>
            ) : (
              <Button href="#kontakt" variant="primary" size="lg" class="w-full">{plan.cta}</Button>
            )}
          </span>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <Text variant="body" class="text-brand-dark/50 text-sm">
        {note}
      </Text>
    </div>
  </Container>
</Section>
