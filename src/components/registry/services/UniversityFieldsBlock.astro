---
// Why: UniversityFieldsBlock is a reimplementation of the "Selected fields of study" section
// from the aleksandra-klisik project (grid of link cards with institute icons).The client
// geometry of the cards and their hover were preserved, and the colors were transferred to
// Starter Kit tokens.The content input was taken over by the global motion system
// (data-motion-section), and the university content was replaced with neutral PL/EN data in
// JSON.
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import { formatInternalLink } from "@utils/url";
import jsonData from "@data/sections/university-fields.json";

interface Props {
/** Full section data. The block reads the JSON fallback when omitted. */
  data?: typeof jsonData;
/** Content language from JSON: "pl" (default) or "en". */
  locale?: "pl" | "en";
/** Section anchor id (default: "directions"). */
  id?: string;
  /** Section heading tag: 'h2' by default, 'h1' when the block is the first section without hero (SEO). */
  headingTag?: string;
/** Additional section classes, for example from PageBuilder. */
  class?: string;
}

const {
  data,
  locale = "pl",
  id = "kierunki",
  headingTag = "h2",
  class: className = "",
} = Astro.props as Props;

// Why: "props.data || jsonData[locale]" pattern (as in KnowledgeCardsBlock), so that the
// block works independently with section data, and PageBuilder or CMS can overwrite the
// content.When the date comes from outside, we select the language variant (pl/en), just like
// JSON does.
const t = (data ? data[locale] : jsonData[locale]) || jsonData.pl;
const rawItems = t.items ?? [];

// Why: formatInternalLink takes care of trailing slash and path cleanliness, in line with the
// SEO starter kit standard (each internal link with a "/").
const headerHref = formatInternalLink(t.linkHref);
const items = rawItems.map((item) => ({
  ...item,
  href: formatInternalLink(item.href),
}));
---

<Section id={id} tone="page" class:list={["border-t border-brand-dark/10", className]}>
  <Container>
    <!-- Why: section header in the "title + action link on the right" layout
(flex justify-between), exactly like the client's."See all" link
with an arrow in a circle indicates an action without a full button. -->
    <div class="flex flex-wrap items-end justify-between gap-4">
      <Heading tag={headingTag} variant="section-heading-lg" class="min-w-0 !font-extrabold">{t.heading}</Heading>
      <a
        href={headerHref}
        class="group inline-flex items-center gap-3 text-sm font-bold text-brand-dark transition-colors duration-300 hover:text-brand-primary"
      >
        <span>{t.linkLabel}</span>
        <span
          aria-hidden="true"
          class="inline-flex size-9 items-center justify-center rounded-full bg-brand-light text-brand-primary transition-transform duration-300 group-hover:translate-x-1"
        >
          <Icon name="arrow-right" size={16} />
        </span>
      </a>
    </div>

    <!-- Why: grid mobile-first: 1 column for mobile, 2 for md, 3 for lg
(at the client, 3 columns on the desktop).The entire card is a <a> link,
not an article with a link inside (KnowledgeCardsBlock pattern).
H-full expansion aligns tabs in a row regardless of length
description. -->
    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <a
          href={item.href}
          aria-label={`${item.title}, ${item.description}`}
          class="up-field-card group relative flex h-full min-w-0 flex-col p-6"
        >
          {/* Why: icon in a circle on a brand-light background (instead of the client one
octagon with the institute's SVG file).The hover wheel adopts
primary color, which reflects the client's change of the icon background. */}
          <span
            aria-hidden="true"
            class="up-field-card__icon mb-4 inline-flex size-14 items-center justify-center rounded-full bg-brand-light text-brand-primary"
          >
            <Icon name={item.icon} size={26} />
          </span>
          <Heading tag="h3" class="text-base leading-snug !font-semibold text-brand-dark transition group-hover:text-brand-primary">
            {item.title}
          </Heading>
          <Text variant="feature-body-sm" class="mt-2 leading-relaxed text-brand-dark/70">
            {item.description}
          </Text>
          {/* Why: arrow in the lower right corner of the card, only visible
on hover (opacity + translate), exactly like in the client
(.field-card__arrow: opacity 0.3 -> 1).aria-hidden, because it
decoration, and the link already has an aria-label. */}
          <span
            aria-hidden="true"
            class="up-field-card__arrow absolute bottom-4 right-4 inline-flex text-brand-primary"
          >
            <Icon name="arrow-right" size={22} />
          </span>
        </a>
      ))}
    </div>
  </Container>
</Section>

<style>
  /* Why: the original hover wasn't just a simple card swipe.Corner
it changed to a vertical accent and the icon and arrow reacted along with the card. */
  .up-field-card {
    --field-card-cut: 1.05rem;
    --field-corner-color: var(--color-brand-primary);
    --field-hover-corner-color: var(--color-brand-dark);
    --field-hover-icon-bg: var(--color-brand-primary);
    --field-hover-icon-fg: var(--color-on-primary);
    isolation: isolate;
    overflow: hidden;
    background: var(--color-outline-variant);
    clip-path: polygon(
      var(--field-card-cut) 0,
      calc(100% - var(--field-card-cut)) 0,
      100% var(--field-card-cut),
      100% calc(100% - var(--field-card-cut)),
      calc(100% - var(--field-card-cut)) 100%,
      var(--field-card-cut) 100%,
      0 calc(100% - var(--field-card-cut)),
      0 var(--field-card-cut)
    );
    box-shadow: var(--ui-elevation-soft);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .up-field-card::before {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    background: var(--field-corner-color);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
    content: "";
    transition: width 0.3s ease, height 0.3s ease, clip-path 0.3s ease;
  }

  .up-field-card::after {
    position: absolute;
    inset: 1px;
    z-index: 0;
    background: var(--color-surface);
    clip-path: polygon(
      calc(var(--field-card-cut) - 1px) 0,
      calc(100% - var(--field-card-cut) + 1px) 0,
      100% calc(var(--field-card-cut) - 1px),
      100% calc(100% - var(--field-card-cut) + 1px),
      calc(100% - var(--field-card-cut) + 1px) 100%,
      calc(var(--field-card-cut) - 1px) 100%,
      0 calc(100% - var(--field-card-cut) + 1px),
      0 calc(var(--field-card-cut) - 1px)
    );
    content: "";
    pointer-events: none;
  }

  .up-field-card > :not(.up-field-card__arrow) {
    position: relative;
    z-index: 2;
  }

  .up-field-card:hover,
  .up-field-card:focus-visible {
    --field-corner-color: var(--field-hover-corner-color);
    transform: translateY(-0.25rem);
    box-shadow: var(--ui-elevation-strong);
  }

  .up-field-card:hover::before,
  .up-field-card:focus-visible::before {
    width: 0.3rem;
    height: 100%;
    clip-path: none;
  }

  .up-field-card__icon {
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .up-field-card:hover .up-field-card__icon,
  .up-field-card:focus-visible .up-field-card__icon {
    background: var(--field-hover-icon-bg);
    color: var(--field-hover-icon-fg);
  }

  .up-field-card__arrow {
    position: absolute;
    z-index: 2;
    opacity: 0.3;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .up-field-card:hover .up-field-card__arrow,
  .up-field-card:focus-visible .up-field-card__arrow {
    opacity: 1;
    transform: translateX(0.35rem);
  }

  .up-field-card:nth-child(2),
  .up-field-card:nth-child(5) {
    --field-corner-color: var(--color-brand-dark);
    --field-hover-corner-color: var(--color-brand-dark);
    --field-hover-icon-bg: var(--color-brand-dark);
    --field-hover-icon-fg: var(--color-on-primary);
  }

  .up-field-card:nth-child(3) {
    --field-corner-color: var(--color-brand-accent);
    --field-hover-corner-color: var(--color-brand-accent);
    --field-hover-icon-bg: var(--color-brand-accent);
    --field-hover-icon-fg: var(--color-on-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .up-field-card,
    .up-field-card::before,
    .up-field-card__icon,
    .up-field-card__arrow {
      transition: none;
    }
  }
</style>
