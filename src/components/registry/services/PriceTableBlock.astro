---
// Why: PriceTableBlock is a price table in the form of an elegant list of rows, modeled on
// ApartmentsTable from the Piekary9 project (expandable table with sorting and a "Show all"
// button). Unlike price cards, it gives you a quick comparison of all units in one place.
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import priceTableData from "@data/sections/price-table.json";

type PriceColumn = {
  key: string;
  label: string;
  align?: "left" | "center" | "right";
};

type PriceItem = {
  name: string;
  description?: string;
  image?: { src: string; alt: string };
  guests?: number;
  season: string;
  offSeason: string;
  /** CTA link (zwykle formularz rezerwacji). */
  href?: string;
/** Link to the unit details page. Falls back to href. */
  detailHref?: string;
  cta?: string;
  ctaHover?: string;
  tag?: string;
};

interface Props {
  sectionId?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  note?: string;
  unitLabel?: string;
  ctaLabel?: string;
  ctaHref?: string;
  sortable?: boolean;
  columns?: PriceColumn[];
  items?: PriceItem[];
  /** Section heading tag: 'h2' by default, 'h1' on subpages (SEO). */
  headingTag?: string;
}

const {
  sectionId = "cennik",
  eyebrow = "",
  title = "",
  subtitle = "",
  note = "",
  unitLabel = "",
  ctaLabel = "",
  ctaHref = "",
  sortable = true,
  columns = [],
  items = [],
  headingTag = "h2",
} = Astro.props as Props;

// Why: "props || json" pattern as in other blocks - props overwrite content from JSON, and
// JSON is the default source (source of truth for Decap CMS).
const resolvedEyebrow = eyebrow || priceTableData.eyebrow || "";
const resolvedTitle = title || priceTableData.title || "";
const resolvedSubtitle = subtitle || priceTableData.subtitle || "";
const resolvedNote = note || priceTableData.note || "";
const resolvedUnitLabel = unitLabel || priceTableData.unitLabel || "";
const resolvedCtaLabel = ctaLabel || priceTableData.ctaLabel || "";
const resolvedCtaHref = ctaHref || priceTableData.ctaHref || "";
const resolvedSortable = sortable !== false && priceTableData.sortable !== false;
const resolvedColumns = columns.length > 0 ? columns : (priceTableData.columns || []);
const resolvedItems = items.length > 0 ? items : (priceTableData.items || []);

// Why: price kept in JSON as text ("PLN 200") - for sorting we extract a number from the
// string to compare values, not strings.
function priceToNumber(price: string): number {
  const match = price.replace(/\s/g, "").match(/(\d+)/);
  return match ? parseInt(match[1], 10) : 0;
}
---

<Section id={sectionId} tone="page" class="relative">
  <Container>
    <!-- The section header is centered and consistent with the rest of the subpages -->
    <div class="mb-12 flex flex-col items-center text-center">
      <span class="ui-type-accent-label mb-4">{resolvedEyebrow}</span>
      <Heading tag={headingTag} variant="section-title" class="text-brand-dark">
        {resolvedTitle}
      </Heading>
      <Text variant="lead" class="mt-4 max-w-2xl text-brand-dark/70">
        {resolvedSubtitle}
      </Text>
    </div>

    <!-- Why: A table in a tab with rounded corners and scrolling
         horizontal on mobile (overflow-x-auto), because 4 columns with a thumbnail
         they don't fit on small screens. All lines visible
         straight away, without rolling. -->
    <div
      id="price-table-container"
      class="relative overflow-hidden rounded-2xl border border-brand-dark/10 bg-brand-light shadow-sm"
    >
      <div class="overflow-x-auto">
        <table class="w-full min-w-[40rem] text-left text-sm" id="price-table">
          <thead>
            <tr class="border-b border-brand-dark/10 bg-brand-cream/60">
              {resolvedColumns.map((col) => {
                const alignCls =
                  col.align === "center" ? "text-center" : col.align === "right" ? "text-right" : "text-left";
                const isSortable =
                  resolvedSortable &&
                  (col.key === "name" || col.key === "guests" || col.key === "season" || col.key === "offSeason");
                return (
                  <th
                    class:list={[
                      "px-5 py-4 font-heading text-sm font-bold tracking-wide text-brand-dark",
                      alignCls,
                      isSortable ? "cursor-pointer select-none" : "",
                    ]}
                    data-sort-key={isSortable ? col.key : undefined}
                  >
                    {col.label ? (
                      <span class:list={["inline-flex items-center gap-1.5", isSortable ? "group/sort" : ""]}>
                        {col.label}
                        {isSortable && (
                          <i class="ph ph-sort-ascending text-brand-dark/40" aria-hidden="true"></i>
                        )}
                      </span>
                    ) : null}
                  </th>
                );
              })}
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-dark/5">
            {resolvedItems.map((item) => {
              const img = item.image || null;
              // Why: two different link targets per row - thumbnail and name
              // lead to the unit subpage (detailHref), and the CTA button
              // zawsze do formularza rezerwacji (href).
              const detailHref = item.detailHref || item.href || resolvedCtaHref;
              return (
                <tr
                  class="price-row group transition-colors hover:bg-brand-accent/10"
                  data-sort-name={item.name}
                  data-sort-guests={item.guests ?? 0}
                  data-sort-season={priceToNumber(item.season)}
                  data-sort-offseason={priceToNumber(item.offSeason)}
                >
                  <!-- Entity column: larger thumbnail + clickable name + tag + description -->
                  <td class="px-5 py-4">
                    <div class="flex items-center gap-4">
                      {img && (
                        <a
                          href={detailHref}
                          class="block h-16 w-24 shrink-0 overflow-hidden rounded-lg bg-brand-dark/5 transition-transform duration-300 hover:scale-[1.03]"
                          aria-label={`Zobacz szczegóły: ${item.name}`}
                        >
                          <img
                            src={img.src}
                            alt={img.alt}
                            width="96"
                            height="64"
                            loading="lazy"
                            class="h-full w-full object-cover"
                          />
                        </a>
                      )}
                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                          <a
                            href={detailHref}
                            class="group/name truncate font-heading text-lg font-semibold leading-tight text-brand-dark transition-colors hover:text-brand-primary"
                          >
                            {item.name}
                            <i
                              class="ph ph-arrow-up-right ml-1 text-sm text-brand-primary/50 transition-transform duration-300 group-hover/name:translate-x-0.5 group-hover/name:-translate-y-0.5"
                              aria-hidden="true"
                            ></i>
                          </a>
                          {item.tag && (
                            <span class="shrink-0 rounded-full bg-brand-primary/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-brand-primary">
                              {item.tag}
                            </span>
                          )}
                        </div>
                        {item.description && (
                          <Text variant="feature-body-sm" class="mt-0.5 truncate text-xs leading-snug text-brand-dark/60">
                            {item.description}
                          </Text>
                        )}
                      </div>
                    </div>
                  </td>
                  <!-- Number of people column: users icon + number, no decoration -->
                  <td class="whitespace-nowrap px-5 py-4 text-center">
                    {item.guests ? (
                      <span class="inline-flex items-center gap-1.5 font-semibold text-brand-dark/70">
                        <i class="ph ph-users text-base text-brand-primary/60" aria-hidden="true"></i>
                        {item.guests}
                      </span>
                    ) : (
                      <span class="text-brand-dark/40">-</span>
                    )}
                  </td>
                  <!-- Cena sezonowa jako punkt kulminacyjny wiersza -->
                  <td class="whitespace-nowrap px-5 py-4 text-center font-bold text-brand-primary">
                    {item.season}
                    <span class="block text-[10px] font-semibold uppercase tracking-wider text-brand-dark/40">{resolvedUnitLabel}</span>
                  </td>
                  <td class="whitespace-nowrap px-5 py-4 text-center font-semibold text-brand-dark/70">
                    {item.offSeason}
                    <span class="block text-[10px] font-semibold uppercase tracking-wider text-brand-dark/40">{resolvedUnitLabel}</span>
                  </td>
                  <td class="px-5 py-4 text-right">
                    <!-- Why: the CTA button is above the mask gradient (z-10),
                         so that it is not see-through and the mask works on the rest of the table. -->
                    <Button
                      href={item.href || resolvedCtaHref}
                      variant="outline"
                      size="sm"
                      hoverText={item.ctaHover}
                      class="relative z-10 text-brand-primary"
                    >
                      {item.cta || resolvedCtaLabel}
                      <i class="ph ph-arrow-right text-sm" aria-hidden="true" slot="icon-right"></i>
                    </Button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- A note under the table with indicative prices -->
    {resolvedNote && (
      <Text variant="body" class="mt-6 text-center text-sm text-brand-dark/50">
        {resolvedNote}
      </Text>
    )}
  </Container>
</Section>

<script>
  // Why: sorting columns (name, number of people, prices). Sorting
  // compares data-sort-* attributes on rows, so it works without parsing
  // widocznego tekstu. Tabela nie jest zwijana, wszystkie wiersze widoczne.
  document.addEventListener("DOMContentLoaded", () => {
    const table = document.getElementById("price-table") as HTMLTableElement | null;
    const tableBody = table?.querySelector("tbody") as HTMLTableSectionElement | null;

    // ── Sortowanie kolumn ────────────────────────────────────────────────
    const sortHeaders = Array.from(document.querySelectorAll("th[data-sort-key]")) as HTMLElement[];
    let currentSort = { key: "" as string, order: "asc" as "asc" | "desc" };

    sortHeaders.forEach((header) => {
      header.addEventListener("click", () => {
        const key = header.getAttribute("data-sort-key") || "";
        const isAsc = currentSort.key === key && currentSort.order === "asc";
        currentSort.order = isAsc ? "desc" : "asc";
        currentSort.key = key;

        // Reset icons and color of the active header
        sortHeaders.forEach((h) => {
          const icon = h.querySelector("i");
          if (icon) icon.className = "ph ph-sort-ascending text-brand-dark/40";
          h.classList.remove("text-brand-accent");
        });

        // Highlighting the active column
        const icon = header.querySelector("i");
        if (icon) icon.className = `ph ph-sort-${currentSort.order === "asc" ? "ascending" : "descending"} text-brand-accent`;
        header.classList.add("text-brand-accent");

        if (!tableBody) return;
        // Why: data-* attributes are case-insensitive in HTML, so name
        // key (e.g. offSeason) must go to the selector as lowercase.
        const attr = `data-sort-${key.toLowerCase()}`;
        const sorted = Array.from(tableBody.querySelectorAll("tr")).sort((a, b) => {
          const valA = a.getAttribute(attr) || "0";
          const valB = b.getAttribute(attr) || "0";
          const numA = parseFloat(valA);
          const numB = parseFloat(valB);
          if (!isNaN(numA) && !isNaN(numB)) {
            return currentSort.order === "asc" ? numA - numB : numB - numA;
          }
          return currentSort.order === "asc" ? valA.localeCompare(valB, "pl") : valB.localeCompare(valA, "pl");
        });
        sorted.forEach((row) => tableBody.appendChild(row));
      });
    });
  });
</script>
