---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import { formatInternalLink } from "@utils/url";

type Locale = "pl" | "en";

type AccommodationImage = {
  src: string;
  alt: string;
  width?: number;
  height?: number;
};

type AccommodationItem = {
  title: string;
  description: string;
  image: AccommodationImage;
  gallery?: AccommodationImage[];
  href?: string;
  ctaLabel?: string;
  ctaHover?: string;
  details?: string[];
};

type AccommodationContent = {
  eyebrow?: string;
  heading?: string;
  description?: string;
  roomsHeading?: string;
  cottagesHeading?: string;
  reservationCta?: { label: string; href: string; ctaHover?: string };
  rooms?: AccommodationItem[];
  cottages?: AccommodationItem[];
  cta?: { label: string; href: string; ctaHover?: string };
  emptyState?: {
    eyebrow?: string;
    heading: string;
    description: string;
    items?: { title: string; description: string }[];
    cta?: { label: string; href: string; ctaHover?: string };
  };
};

export interface Props extends AccommodationContent {
  data?: AccommodationContent | Partial<Record<Locale, AccommodationContent>>;
  pl?: AccommodationContent;
  en?: AccommodationContent;
  locale?: Locale;
  id?: string;
  headingTag?: string;
  class?: string;
}

const {
  data,
  pl,
  en,
  locale = "pl",
  id = "pokoje-i-domki",
  headingTag = "h2",
  class: className = "",
  eyebrow,
  heading,
  description,
  roomsHeading,
  cottagesHeading,
  rooms,
  cottages,
  cta,
} = Astro.props as Props;

const localizedData = data ?? ((pl || en) ? { pl, en } : undefined);
const isLocalized = !!localizedData && ("pl" in localizedData || "en" in localizedData);
const localizedContent = isLocalized
  ? ((localizedData as Partial<Record<Locale, AccommodationContent>>)[locale]
    ?? (localizedData as Partial<Record<Locale, AccommodationContent>>).pl
    ?? {})
  : (localizedData as AccommodationContent | undefined) ?? {};

const content: AccommodationContent = {
  ...localizedContent,
  ...(eyebrow !== undefined ? { eyebrow } : {}),
  ...(heading !== undefined ? { heading } : {}),
  ...(description !== undefined ? { description } : {}),
  ...(roomsHeading !== undefined ? { roomsHeading } : {}),
  ...(cottagesHeading !== undefined ? { cottagesHeading } : {}),
  ...(rooms !== undefined ? { rooms } : {}),
  ...(cottages !== undefined ? { cottages } : {}),
  ...(cta !== undefined ? { cta } : {}),
};

const groups = [
  { id: "rooms", heading: content.roomsHeading, items: content.rooms ?? [] },
  { id: "cottages", heading: content.cottagesHeading, items: content.cottages ?? [] },
].filter((group) => group.items.length > 0);

const hasTabs = groups.length > 1;
const editorialCottages = groups.length === 1 && groups[0].id === "cottages";
const defaultCtaHover = locale === "en" ? "Write!" : "Pisz!";

for (const group of groups) {
  for (const item of group.items) {
    if (!item.image?.src || !item.image.alt?.trim()) {
      throw new Error(`AccommodationCardsBlock: item "${item.title}" requires a descriptive image alt.`);
    }
  }
}
---

<Section id={id} tone="page" class:list={["border-t border-brand-dark/10", className]}>
  <Container>
    {(content.eyebrow || content.heading || content.description) && (
      <div class="mx-auto max-w-3xl text-center">
        {content.eyebrow && <Text variant="accent-label">{content.eyebrow}</Text>}
        {content.heading && (
          <Heading tag={headingTag} variant="section-heading-lg" class="mt-4">
            {content.heading}
          </Heading>
        )}
        {content.description && (
          <Text variant="lead" class="mx-auto mt-4 max-w-2xl text-brand-dark/70">
            {content.description}
          </Text>
        )}
      </div>
    )}

    {groups.length > 0 && (
      <div class="mt-10 md:mt-14" data-accommodation-tabs>
        {hasTabs && (
          <div class="mb-8 flex justify-center md:mb-10">
            <div
              class="relative mx-auto grid w-full max-w-md grid-cols-2 border-b border-brand-dark/15"
              role="tablist"
              aria-label={content.heading || "Wybierz rodzaj zakwaterowania"}
              data-accommodation-tablist
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute bottom-0 left-0 h-0.5 bg-brand-primary transition-[transform,width] duration-300 ease-out"
                data-accommodation-indicator
              ></span>
              {groups.map((group, index) => {
                const tabId = `${id}-${group.id}-tab`;
                const panelId = `${id}-${group.id}-panel`;
                return (
                  <button
                    type="button"
                    id={tabId}
                    role="tab"
                    aria-controls={panelId}
                    aria-selected={index === 0 ? "true" : "false"}
                    tabindex={index === 0 ? 0 : -1}
                    data-accommodation-tab={group.id}
                    data-state={index === 0 ? "active" : "inactive"}
                    class="relative min-h-12 px-4 py-3 text-center font-sans text-sm font-semibold tracking-wide text-brand-dark/55 transition-colors hover:text-brand-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary/40 focus-visible:ring-offset-2 aria-selected:text-brand-primary sm:px-6"
                  >
                    {group.heading}
                  </button>
                );
              })}
            </div>
          </div>
        )}

        {groups.map((group, index) => {
          const tabId = `${id}-${group.id}-tab`;
          const panelId = `${id}-${group.id}-panel`;
          return (
            <div
              id={panelId}
              role="tabpanel"
              aria-labelledby={hasTabs ? tabId : undefined}
              data-accommodation-panel={group.id}
              data-state={index === 0 ? "active" : "inactive"}
              hidden={hasTabs && index !== 0}
              class="min-w-0"
            >
              {group.heading && hasTabs && (
                <Heading tag="h3" variant="section-subtitle" class="sr-only">
                  {group.heading}
                </Heading>
              )}
              {editorialCottages ? (
                <div class="space-y-20 md:space-y-28" data-accommodation-editorial>
                  {group.items.map((item, itemIndex) => {
                    const galleryImages = [item.image, ...(item.gallery ?? [])].slice(0, 4);
                    const eyebrowLabel = `${locale === "en" ? "COTTAGE" : "DOMEK"} ${String(itemIndex + 1).padStart(2, "0")}`;

                    return (
                      <div>
                        <article
                          class:list={[
                            "cottage-editorial grid min-w-0 items-center gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16",
                            itemIndex % 2 === 1 && "lg:grid-cols-[1.3fr_0.7fr]",
                          ]}
                          data-cottage-editorial
                        >
                          <div
                            class:list={[
                              "order-1 min-w-0 lg:order-2",
                              itemIndex % 2 === 1 && "lg:order-1",
                            ]}
                          >
                            <div class="relative overflow-visible">
                              <div
                                class:list={[
                                  "cottage-editorial-media overflow-hidden bg-brand-dark/5 shadow-soft",
                                  itemIndex % 2 === 0
                                    ? "cottage-editorial-media--left"
                                    : "cottage-editorial-media--right",
                                ]}
                              >
                                <SmartImage
                                  src={item.image.src}
                                  alt={item.image.alt}
                                  width={item.image.width ?? 1200}
                                  height={item.image.height ?? 900}
                                  sizes="(min-width: 1024px) 58vw, 100vw"
                                  class="aspect-[4/3] w-full object-cover transition duration-700 hover:scale-[1.02]"
                                />
                              </div>

                              {galleryImages.length > 1 && (
                                <div
                                  class="relative z-10 -mt-14 grid grid-cols-3 gap-2 px-4 sm:-mt-20 sm:gap-3 sm:px-8"
                                  data-cottage-editorial-thumbnails
                                >
                                  {galleryImages.slice(1).map((image) => (
                                    <div class="overflow-hidden rounded-xl border-4 border-white bg-brand-dark/5 shadow-soft">
                                      <SmartImage
                                        src={image.src}
                                        alt={image.alt}
                                        width={image.width ?? 600}
                                        height={image.height ?? 450}
                                        sizes="(min-width: 1024px) 18vw, 30vw"
                                        class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-105"
                                      />
                                    </div>
                                  ))}
                                </div>
                              )}
                            </div>
                          </div>

                          <div
                            class:list={[
                              "order-2 flex min-w-0 flex-col justify-center lg:order-1",
                              itemIndex % 2 === 1 && "lg:order-2",
                            ]}
                          >
                            <Text variant="accent-label" class="!tracking-[0.24em]">{eyebrowLabel}</Text>
                            <Heading tag="h3" variant="section-heading-lg" class="mt-4">{item.title}</Heading>
                            <div class="mt-5 h-px w-12 bg-brand-primary/50" aria-hidden="true"></div>
                            <Text variant="body" class="mt-5 max-w-md text-brand-dark/70">{item.description}</Text>

                            {item.details && item.details.length > 0 && (
                              <ul class="mt-7 space-y-3">
                                {item.details.map((detail) => (
                                  <li class="flex items-center gap-3">
                                    <i aria-hidden="true" class="ph ph-sparkle text-lg text-brand-primary/70"></i>
                                    <Text tag="span" variant="feature-body-sm" class="text-brand-dark/75">{detail}</Text>
                                  </li>
                                ))}
                              </ul>
                            )}

                            {item.href && item.ctaLabel && (
                              <div class="mt-8">
                                <Button
                                  href={formatInternalLink(item.href)}
                                  variant="accent"
                                  size="md"
                                  hoverText={item.ctaHover ?? defaultCtaHover}
                                >
                                  {item.ctaLabel}
                                </Button>
                              </div>
                            )}
                          </div>
                        </article>

                        {itemIndex < group.items.length - 1 && (
                          <div class="mx-auto mt-20 h-px w-full max-w-5xl bg-brand-dark/10 md:mt-28" aria-hidden="true"></div>
                        )}
                      </div>
                    );
                  })}
                </div>
              ) : (
                <div
                  class:list={[
                    "grid min-w-0 snap-x snap-mandatory auto-cols-[minmax(82%,1fr)] grid-flow-col gap-5 overflow-x-auto overscroll-x-contain pb-4 md:auto-cols-auto md:grid-flow-row md:grid-cols-2 md:gap-6 md:overflow-visible md:pb-0",
                    group.items.length === 2
                      ? "lg:mx-auto lg:max-w-3xl lg:grid-cols-2"
                      : "lg:grid-cols-3",
                  ]}
                >
                  {group.items.map((item) => (
                    <article class="ui-card-interactive group flex min-w-0 snap-start flex-col overflow-hidden rounded-2xl border border-brand-dark/10 bg-brand-dark/5 shadow-soft">
                      <div class="overflow-hidden border-b border-brand-dark/10">
                        <SmartImage
                          src={item.image.src}
                          alt={item.image.alt}
                          width={item.image.width ?? 800}
                          height={item.image.height ?? 600}
                          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 82vw"
                          class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                        />
                      </div>
                      <div class="flex min-w-0 flex-1 flex-col p-6 sm:p-7">
                        <Heading tag="h4" variant="feature-title">{item.title}</Heading>
                        <Text variant="body" class="mt-3 text-brand-dark/70">{item.description}</Text>

                        {item.details && item.details.length > 0 && (
                          <ul class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-brand-dark/10 pt-5">
                            {item.details.map((detail) => (
                              <li>
                                <Text tag="span" variant="feature-body-sm" class="text-xs text-brand-dark/70 sm:whitespace-nowrap">{detail}</Text>
                              </li>
                            ))}
                          </ul>
                        )}

                        {item.href && item.ctaLabel && (
                          <div class="mt-6 flex flex-wrap items-center gap-3 pt-1">
                            <a
                              href={formatInternalLink(item.href)}
                              class="group/link relative inline-flex min-h-10 w-fit items-center gap-2 font-sans text-sm font-semibold tracking-wide text-brand-primary underline decoration-brand-primary/35 underline-offset-4 transition-colors duration-200 hover:text-brand-dark hover:decoration-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary/40 focus-visible:ring-offset-2"
                            >
                              {item.ctaLabel}
                              <i
                                aria-hidden="true"
                                class="ph ph-arrow-up-right text-base transition-transform duration-300 ease-out group-hover/link:translate-x-1"
                              ></i>
                            </a>
                            {content.reservationCta?.href && content.reservationCta.label && (
                              <Button
                                href={formatInternalLink(content.reservationCta.href)}
                                variant="primary"
                                size="sm"
                                hoverText={content.reservationCta.ctaHover ?? defaultCtaHover}
                              >
                                {content.reservationCta.label}
                              </Button>
                            )}
                          </div>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    )}

    {groups.length === 0 && content.emptyState && (
      <div class="mt-10 grid gap-8 overflow-hidden rounded-2xl border border-brand-dark/10 bg-brand-dark/5 p-6 shadow-soft sm:p-8 lg:grid-cols-[0.8fr_1.2fr] lg:p-10">
        <div class="flex flex-col justify-center">
          {content.emptyState.eyebrow && <Text variant="accent-label">{content.emptyState.eyebrow}</Text>}
          <Heading tag="h3" variant="section-heading-lg" class="mt-4">
            {content.emptyState.heading}
          </Heading>
          <Text variant="body" class="mt-4 max-w-xl text-brand-dark/70">
            {content.emptyState.description}
          </Text>
          {content.emptyState.cta?.href && content.emptyState.cta.label && (
            <div class="mt-7">
              <Button
                href={formatInternalLink(content.emptyState.cta.href)}
                variant="accent"
                size="lg"
                hoverText={content.emptyState.cta.ctaHover ?? defaultCtaHover}
              >
                {content.emptyState.cta.label}
              </Button>
            </div>
          )}
        </div>

        {content.emptyState.items && content.emptyState.items.length > 0 && (
          <div class="grid gap-3 self-center sm:grid-cols-2">
            {content.emptyState.items.map((item) => (
              <div class="rounded-xl border border-brand-dark/10 bg-white p-5">
                <Heading tag="h4" variant="feature-title">{item.title}</Heading>
                <Text variant="body" class="mt-2 text-sm text-brand-dark/65">{item.description}</Text>
              </div>
            ))}
          </div>
        )}
      </div>
    )}

    {content.cta?.href && content.cta.label && (
      <div class="mt-12 md:mt-16">
        <Button
          href={formatInternalLink(content.cta.href)}
          variant="accent"
          size="lg"
          hoverText={content.cta.ctaHover ?? defaultCtaHover}
        >
          {content.cta.label}
        </Button>
      </div>
    )}
  </Container>
</Section>

{hasTabs && <script is:inline src="/js/accommodation-tabs.js" defer></script>}

<style>
  .cottage-editorial-media--left {
    clip-path: ellipse(100% 110% at 100% 50%);
  }

  .cottage-editorial-media--right {
    clip-path: ellipse(100% 110% at 0% 50%);
  }

  @media (max-width: 767px) {
    .cottage-editorial-media--left,
    .cottage-editorial-media--right {
      border-radius: 2rem;
      clip-path: none;
    }
  }
</style>
