---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/compliance-architecture-grid.json";

type Service = { id: string; title: string; serviceId?: string; description: string; features: string[]; icon: string; href: string; cta: string; featured?: boolean };
type Secondary = { title: string; description: string; icon: string; href: string; cta: string };
export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string }

const { data, locale = "pl", sectionId = "architektura-zgodnosci", class: className = "" } = Astro.props as Props;
const source = data ?? jsonData;
const t = source[locale] ?? source.pl;
const services = (t.services ?? []) as Service[];
const primary = services.filter((service) => service.featured);
const secondary = (t.secondaryCards ?? []) as Secondary[];

const iconMarkup: Record<string, string> = {
  people: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>',
  check: '<circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path>',
  document: '<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>',
  training: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>',
};
---

<Section id={sectionId} tone="page" class:list={["relative overflow-hidden", className]}>
  <div class="pointer-events-none absolute inset-0 opacity-[0.035]" aria-hidden="true" style="background-image:linear-gradient(var(--color-brand-primary) 1px,transparent 1px),linear-gradient(90deg,var(--color-brand-primary) 1px,transparent 1px);background-size:40px 40px;"></div>
  <Container class="relative z-10">
    <div class="mb-16 text-center">
      <Text variant="accent-label" tag="p" class="text-brand-primary">{t.eyebrow}</Text>
      <Heading tag="h2" variant="section-heading-xl" class="mx-auto mt-4 max-w-3xl text-brand-dark">{t.heading}</Heading>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-t-2xl border border-brand-dark/10 bg-brand-dark/10 shadow-sm md:grid-cols-2">
      {primary.map((service) => (
        <article class="group relative flex h-full flex-col overflow-hidden bg-white p-10 transition-colors duration-500 hover:bg-brand-primary/[0.03]">
          <div class="absolute -top-16 -right-16 size-32 rounded-[2rem] bg-brand-primary/[0.03] transition-transform duration-700 group-hover:scale-150" aria-hidden="true"></div>
          <div class="relative z-10 mb-8 flex items-start justify-between">
            <span class="flex size-16 items-center justify-center rounded-2xl bg-brand-primary text-white shadow-soft transition-[transform] duration-500 group-hover:-rotate-3 group-hover:scale-110">
              <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconMarkup[service.icon] ?? iconMarkup.shield}></svg>
            </span>
            <Text variant="disclaimer" class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-brand-dark/25">{service.serviceId}</Text>
          </div>
          <Heading tag="h3" variant="section-heading-lg" class="relative z-10 mb-4 max-w-md text-brand-dark"><Fragment set:html={service.title} /></Heading>
          <Text variant="body" class="relative z-10 mb-8 text-sm text-brand-dark/65">{service.description}</Text>
          <ul class="relative z-10 mb-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {service.features.map((feature) => (
              <li class="flex items-center gap-3 text-xs font-medium text-brand-dark/65">
                <span class="flex size-5 shrink-0 items-center justify-center rounded-md bg-brand-primary/10 text-brand-primary" aria-hidden="true"><svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                <span class="leading-none">{feature}</span>
              </li>
            ))}
          </ul>
          <a href={service.href} class="relative z-10 mt-auto inline-flex items-center gap-2 text-sm font-bold text-brand-primary transition-[gap] hover:gap-3">
            {service.cta}<span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-b-2xl border-x border-b border-brand-dark/10 bg-brand-dark/10 shadow-sm md:grid-cols-3">
      {secondary.map((card) => (
        <article class="group relative flex h-full flex-col overflow-hidden bg-white p-8 transition-colors duration-500 hover:bg-brand-primary/[0.03]">
          <div class="mb-6">
            <span class="flex size-14 items-center justify-center rounded-2xl border border-brand-primary/15 bg-brand-primary/[0.04] text-brand-primary shadow-sm transition-[background-color,color] duration-300 group-hover:bg-brand-primary group-hover:text-white">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconMarkup[card.icon] ?? iconMarkup.shield}></svg>
            </span>
          </div>
          <Heading tag="h3" variant="feature-heading-md" class="mb-4 text-brand-dark">{card.title}</Heading>
          <Text variant="feature-body-sm" class="mb-6 line-clamp-3 text-brand-dark/65">{card.description}</Text>
          <a href={card.href} class="mt-auto text-[10px] font-bold uppercase tracking-[0.12em] text-brand-dark/50 transition-colors group-hover:text-brand-primary">{card.cta}</a>
        </article>
      ))}
    </div>
  </Container>
</Section>
