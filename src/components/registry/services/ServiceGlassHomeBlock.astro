---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/service-glass-home.json";

type Service = { title: string; description: string; icon: string; href: string; cta: string };
export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string }

const { data, locale = "pl", sectionId = "services-glass", class: className = "" } = Astro.props as Props;
const source = data ?? jsonData;
const t = source[locale] ?? source.pl;
const services = (t.services ?? []) as Service[];

const iconMarkup: Record<string, string> = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>',
  audit: '<circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line>',
  document: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline>',
  training: '<path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path>',
  monitor: '<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line>',
};
---

<Section id={sectionId} tone="base" class:list={["relative overflow-hidden py-10 md:py-[72px]", className]}>
  <Container>
    <div class="mb-8 md:mb-10">
      <Text variant="accent-label" tag="p" class="mb-6 text-brand-primary">{t.eyebrow}</Text>
      <Heading tag="h2" variant="section-heading-xl" class="mb-6 text-brand-dark">{t.heading}</Heading>
      <Text variant="lead" class="max-w-2xl text-brand-dark/70">{t.description}</Text>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:gap-10">
      {services.map((service, index) => (
        <article class:list={["ui-card-interactive group flex min-h-[400px] flex-col justify-between rounded-[3rem] border border-brand-dark/10 bg-white p-10 shadow-soft", index === services.length - 1 && "md:col-span-2 lg:col-span-1"]}>
          <div>
            <div class="mb-10 flex size-16 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary transition-transform duration-500 group-hover:scale-110">
              <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconMarkup[service.icon] ?? iconMarkup.shield}></svg>
            </div>
            <Heading tag="h3" variant="section-heading-lg" class="mb-4 text-brand-dark">{service.title}</Heading>
            <Text variant="body" class="text-brand-dark/70">{service.description}</Text>
          </div>
          <a href={service.href} class="mt-8 inline-flex items-center gap-2 font-bold text-brand-primary transition-[gap] group-hover:gap-4">
            <span>{service.cta}</span>
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </article>
      ))}
    </div>
  </Container>
</Section>
