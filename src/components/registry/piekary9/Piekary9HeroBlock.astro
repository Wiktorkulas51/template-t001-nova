---
import Section from '@components/ui/layout/Section.astro';
import Container from '@components/ui/layout/Container.astro';
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import { formatInternalLink } from '@utils/url';
import data from '@data/sections/piekary9-hero.json';

type HeroData = (typeof data)['pl'];

export interface Props {
  data?: HeroData;
  locale?: 'pl';
  class?: string;
}

const {
  data: overrideData,
  locale = 'pl',
  class: className = '',
} = Astro.props as Props;

const t = overrideData ?? data[locale] ?? data.pl;
---

<Section
  id={t.sectionId}
  class:list={['relative flex min-h-dvh flex-col overflow-hidden bg-brand-dark', className]}
  aria-labelledby="piekary9-hero-heading"
  data-piekary9-hero
>
  <div class="absolute inset-0 z-0" data-piekary9-hero-slider aria-hidden="true">
    {t.images.map((image, index) => (
      <div
        class:list={[
          'absolute inset-0 transition-opacity duration-1000',
          index === 0 ? 'active opacity-100' : 'opacity-0',
        ]}
        data-piekary9-hero-slide={index}
      >
        <img
          src={image.url}
          alt={image.alt}
          width="1920"
          height="1080"
          class="h-full w-full object-cover animate-piekary9-hero-zoom"
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={index === 0 ? 'high' : 'low'}
        />
      </div>
    ))}

    <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/70 to-brand-dark/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-transparent to-brand-dark/40"></div>
  </div>

  <Container class="relative z-10 flex flex-1 items-center">
    <div class="max-w-3xl">
      <div data-motion="fade" class="mb-8 flex items-center gap-4">
        <span class="h-px w-10 bg-brand-accent" aria-hidden="true"></span>
        <Text variant="accent-label" tag="span">{t.eyebrow}</Text>
      </div>

      <Heading id="piekary9-hero-heading" variant="hero" level={1} data-motion="fade" class="text-brand-light">
        {t.heading.line1}<br />
        <em class="not-italic text-brand-accent" set:html={t.heading.highlight}></em>
      </Heading>

      <Text variant="lead" data-motion="fade" class="mt-8 max-w-xl text-brand-light/80">
        {t.description}
      </Text>

      <div data-motion="fade" class="mt-12 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a
          href={formatInternalLink(t.cta.primary.href)}
          class="group relative inline-flex items-center justify-center gap-3 overflow-hidden rounded-full bg-brand-accent px-10 py-4 text-sm font-bold uppercase tracking-widest text-brand-dark shadow-[var(--ui-elevation-soft)] transition-all hover:shadow-[var(--ui-elevation-strong)]"
        >
          <span class="relative z-10">{t.cta.primary.label}</span>
          <i class="ph ph-arrow-right relative z-10 text-base transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
          <span class="absolute inset-0 translate-y-full bg-brand-light/20 transition-transform duration-300 group-hover:translate-y-0" aria-hidden="true"></span>
        </a>

        <a
          href={formatInternalLink(t.cta.secondary.href)}
          class="group inline-flex items-center gap-3 rounded-full border border-brand-light/20 px-10 py-4 text-sm font-bold uppercase tracking-widest text-brand-light/80 backdrop-blur-sm transition hover:border-brand-accent/60 hover:text-brand-light"
        >
          <i class="ph ph-images text-base" aria-hidden="true"></i>
          <span>{t.cta.secondary.label}</span>
        </a>
      </div>
    </div>
  </Container>

  <div class="relative z-10 hidden border-t border-brand-light/10 lg:block">
    <Container class="py-6">
      <div class="flex items-center justify-between">
        <div data-motion="fade" class="flex gap-12">
          {t.stats.map((stat) => (
            <div class="space-y-1">
              <Text variant="accent-label" tag="span" class="text-brand-accent/70 tracking-[0.35em] text-[9px]">{stat.label}</Text>
              {stat.href ? (
                <a href={stat.href} class="block text-sm font-semibold text-brand-light/80 transition-colors hover:text-brand-accent">{stat.value}</a>
              ) : (
                <Text variant="body" tag="span" class="block text-sm font-semibold text-brand-light/80">{stat.value}</Text>
              )}
            </div>
          ))}
        </div>

        <div class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-12">
          <div id="piekary9-hero-dots" role="tablist" aria-label={t.dotsLabel} class="flex items-center gap-[10px] rounded-full bg-brand-dark/20 px-[11px] py-0 backdrop-blur-sm">
            {t.images.map((_, index) => (
              <div
                role="button"
                tabindex="0"
                aria-label={`${t.slideLabel} ${index + 1}`}
                data-piekary9-hero-dot={index}
                class:list={[
                  'min-h-0 h-[6px] leading-none p-0 m-0 rounded-full transition-all duration-500',
                  index === 0 ? 'bg-brand-accent w-[22px]' : 'bg-brand-light/20 w-[7px] hover:bg-brand-light/40',
                ]}
              ></div>
            ))}
          </div>
        </div>

        <a href="#atuty" class="group flex flex-col items-center gap-2 text-brand-light/30 transition hover:text-brand-accent" aria-label={t.scrollLabel}>
          <span class="text-[9px] font-bold uppercase tracking-widest">{t.scrollLabel}</span>
          <span class="relative">
            <i class="ph ph-arrow-down text-lg transition-transform group-hover:translate-y-1" aria-hidden="true"></i>
            <span class="absolute -inset-2 rounded-full border border-brand-light/5 opacity-0 transition-all group-hover:opacity-100"></span>
          </span>
        </a>
      </div>
    </Container>
  </div>
</Section>

<style>
  @keyframes piekary9-hero-zoom {
    from { transform: scale(1); }
    to { transform: scale(1.15); }
  }

  .animate-piekary9-hero-zoom {
    animation: piekary9-hero-zoom 20s ease-out infinite alternate;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-piekary9-hero-zoom {
      animation: none;
    }
  }
</style>

<script>
  type HeroScope = HTMLElement & { __piekary9HeroInterval?: number };
  const globalScope = globalThis as typeof globalThis & { __piekary9HeroLifecycleBound?: boolean };

  const clearHeroIntervals = () => {
    document.querySelectorAll<HeroScope>('[data-piekary9-hero]').forEach((hero) => {
      if (hero.__piekary9HeroInterval !== undefined) {
        window.clearInterval(hero.__piekary9HeroInterval);
        delete hero.__piekary9HeroInterval;
      }
    });
  };

  const initPiekary9Hero = () => {
    const hero = document.querySelector<HeroScope>('[data-piekary9-hero]');
    if (!hero || hero.dataset.piekary9HeroBound === 'true') return;

    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-piekary9-hero-slide]'));
    const dots = Array.from(hero.querySelectorAll<HTMLElement>('[data-piekary9-hero-dot]'));
    if (slides.length === 0 || dots.length === 0) return;

    let currentSlide = 0;

    const showSlide = (index: number) => {
      currentSlide = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle('opacity-100', slideIndex === currentSlide);
        slide.classList.toggle('opacity-0', slideIndex !== currentSlide);
        slide.classList.toggle('active', slideIndex === currentSlide);
      });
      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === currentSlide;
        dot.classList.toggle('bg-brand-accent', active);
        dot.classList.toggle('w-[22px]', active);
        dot.classList.toggle('bg-brand-light/20', !active);
        dot.classList.toggle('w-[7px]', !active);
      });
    };

    const restartInterval = () => {
      if (hero.__piekary9HeroInterval !== undefined) window.clearInterval(hero.__piekary9HeroInterval);
      hero.__piekary9HeroInterval = window.setInterval(() => showSlide(currentSlide + 1), 5000);
    };

    dots.forEach((dot, index) => {
      const activate = () => {
        showSlide(index);
        restartInterval();
      };
      dot.addEventListener('click', activate);
      dot.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate();
        }
      });
    });

    hero.dataset.piekary9HeroBound = 'true';
    restartInterval();
  };

  if (!globalScope.__piekary9HeroLifecycleBound) {
    globalScope.__piekary9HeroLifecycleBound = true;
    document.addEventListener('astro:before-swap', clearHeroIntervals);
    document.addEventListener('astro:page-load', initPiekary9Hero);
    document.addEventListener('astro:after-swap', initPiekary9Hero);
  }

  initPiekary9Hero();
</script>
