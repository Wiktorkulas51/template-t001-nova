---
import Section from '@components/ui/layout/Section.astro';
import Container from '@components/ui/layout/Container.astro';
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import data from '@data/sections/piekary9-advantages.json';
import { formatInternalLink } from '@utils/url';

type AdvantagesData = (typeof data)['pl'];

export interface Props {
  data?: AdvantagesData;
  locale?: 'pl';
  class?: string;
}

const {
  data: overrideData,
  locale = 'pl',
  class: className = '',
} = Astro.props as Props;

const t = overrideData ?? data[locale] ?? data.pl;
---

<Section
  id={t.sectionId}
  class:list={['relative overflow-hidden bg-brand-cream scroll-mt-28 pt-[5rem] lg:pt-[9rem]', className]}
  aria-labelledby="piekary9-advantages-heading"
  data-piekary9-advantages
>
  <Container>
    <div class="mb-12 flex flex-col items-start lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <div class="max-w-2xl">
        <div data-motion="fade" class="mb-4 flex items-center gap-4">
          <span class="h-px w-8 bg-brand-accent" aria-hidden="true"></span>
          <Text variant="accent-label" tag="span">{t.eyebrow}</Text>
        </div>
        <Heading id="piekary9-advantages-heading" variant="section-title" data-motion="fade">
          {t.title}
        </Heading>
      </div>

      <div data-motion="fade" class="mt-8 flex w-full gap-8 overflow-x-auto overflow-y-hidden pb-2 scrollbar-hide lg:mt-2 lg:w-auto lg:overflow-visible lg:pb-0" role="tablist" aria-label={t.title}>
        {t.items.map((item, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`piekary9-advantages-panel-${index}`}
            class:list={[
              'piekary9-advantages-tab group relative shrink-0 whitespace-nowrap pb-2 text-[11px] font-black uppercase tracking-widest transition-all duration-300',
              index === 0 ? 'text-brand-dark' : 'text-brand-dark/30 hover:text-brand-dark/60',
            ]}
            data-piekary9-advantages-tab={index}
          >
            {item.title}
            <span
              class:list={[
                'absolute bottom-0 left-0 h-0.5 bg-brand-accent transition-all duration-500',
                index === 0 ? 'w-full' : 'w-0 group-hover:w-1/2',
              ]}
              data-piekary9-advantages-line
              aria-hidden="true"
            ></span>
          </button>
        ))}
      </div>
    </div>

    <div data-motion="fade" class="relative overflow-hidden rounded-[2.5rem] shadow-2xl">
      <div class="flex transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]" data-piekary9-advantages-track>
        {t.items.map((item, index) => (
          <div id={`piekary9-advantages-panel-${index}`} class="w-full shrink-0" role="tabpanel" aria-hidden={index === 0 ? 'false' : 'true'}>
            <div class="relative min-h-[500px] lg:min-h-[650px]">
              <img
                src={item.image}
                alt={item.imageAlt}
                width="1200"
                height="800"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-[2s]"
                data-piekary9-advantages-image
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/20 to-transparent" aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-r from-brand-dark/60 via-transparent to-transparent" aria-hidden="true"></div>

              <div class="absolute bottom-12 left-8 right-8 lg:bottom-20 lg:left-20">
                <div class="max-w-xl">
                  <Heading variant="section-subtitle" level={3} class="text-brand-light">
                    {item.title}
                  </Heading>
                  <Text variant="lead" class="mt-6 text-brand-light/85">
                    {item.description}
                  </Text>
                  <div class="mt-10 flex items-center gap-4">
                    <a
                      href={formatInternalLink(t.ctaHref)}
                      class="inline-flex items-center gap-3 rounded-full bg-brand-light px-8 py-3 text-[10px] font-black uppercase tracking-widest text-brand-dark transition hover:bg-brand-accent"
                    >
                      {t.ctaLabel}
                      <i class="ph ph-arrow-right" aria-hidden="true"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</Section>

<style is:global>
  .scrollbar-hide::-webkit-scrollbar {
    display: none !important;
  }

  .scrollbar-hide {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
  }
</style>

<script>
  type AdvantagesScope = HTMLElement & { __piekary9AdvantagesBound?: boolean };
  const globalScope = globalThis as typeof globalThis & { __piekary9AdvantagesLifecycleBound?: boolean };

  const initPiekary9Advantages = () => {
    const root = document.querySelector<AdvantagesScope>('[data-piekary9-advantages]');
    if (!root || root.__piekary9AdvantagesBound) return;

    const track = root.querySelector<HTMLElement>('[data-piekary9-advantages-track]');
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[data-piekary9-advantages-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const images = Array.from(root.querySelectorAll<HTMLElement>('[data-piekary9-advantages-image]'));
    if (!track || tabs.length === 0) return;

    let currentIndex = 0;

    const updateSlider = (index: number) => {
      currentIndex = (index + tabs.length) % tabs.length;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === currentIndex;
        tab.classList.toggle('text-brand-dark', active);
        tab.classList.toggle('text-brand-dark/30', !active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        const line = tab.querySelector('[data-piekary9-advantages-line]');
        line?.classList.toggle('w-full', active);
        line?.classList.toggle('w-0', !active);
      });

      panels.forEach((panel, panelIndex) => panel.setAttribute('aria-hidden', panelIndex === currentIndex ? 'false' : 'true'));
      images.forEach((image, imageIndex) => image.classList.toggle('scale-110', imageIndex === currentIndex));
    };

    tabs.forEach((tab, index) => {
      const activate = () => updateSlider(index);
      tab.addEventListener('click', activate);
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate();
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          updateSlider(index + 1);
          tabs[index + 1]?.focus();
        }
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          updateSlider(index - 1);
          tabs[(index - 1 + tabs.length) % tabs.length]?.focus();
        }
      });
    });

    root.__piekary9AdvantagesBound = true;
    updateSlider(0);
  };

  if (!globalScope.__piekary9AdvantagesLifecycleBound) {
    globalScope.__piekary9AdvantagesLifecycleBound = true;
    document.addEventListener('astro:page-load', initPiekary9Advantages);
    document.addEventListener('astro:after-swap', initPiekary9Advantages);
  }

  initPiekary9Advantages();
</script>
