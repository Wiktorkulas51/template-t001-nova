---
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import Text from "@components/ui/atoms/Text.astro";
import contactDetailsContent from "@data/sections/piekary9-contact-details.json";

type ContactDetailsData = typeof contactDetailsContent;

export interface Props {
	data?: ContactDetailsData;
	id?: string;
	class?: string;
}

const { data, id = "contact-details", class: className = "" } = Astro.props as Props;
const content = data ?? contactDetailsContent;
const year = new Date().getFullYear();

const iconName = (name?: string) => {
	const icons: Record<string, string> = {
		clock: "clock",
		phone: "phone",
		email: "envelope",
		facebook: "facebook-logo",
	};

	return icons[name ?? ""] ?? "envelope";
};
---

<footer
	id={id}
	class:list={["ui-section !pt-[4.5rem] border-t border-brand-accent/20 bg-brand-dark scroll-mt-28", className]}
	aria-labelledby={`${id}-heading`}
>
	<Container>
		<div
			data-motion="fade"
			class="flex min-w-0 flex-col gap-8 border-b border-white/10 pb-12 lg:flex-row lg:items-center lg:justify-between"
		>
			<a
				href={content.homeHref}
				class="group ui-footer-contact-line inline-block h-11 shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
				aria-label={content.logo.alt}
			>
				<div class="transition-transform duration-300 group-hover:scale-105">
					<img
						src={content.logo.url}
						alt={content.logo.alt}
						width="200"
						height="100"
						class="h-16 w-auto lg:h-20"
						loading="lazy"
					/>
				</div>
			</a>
			<div class="min-w-0 max-w-xl lg:text-right">
				<Text variant="body" class="font-light italic leading-relaxed tracking-wide text-white/40 lg:text-lg">
					{content.tagline}
				</Text>
			</div>
		</div>

		<Heading id={`${id}-heading`} tag="h2" variant="section-title" class="sr-only">
			{content.title}
		</Heading>

		<div data-motion="fade" class="grid min-w-0 gap-12 pt-12 sm:grid-cols-2 lg:grid-cols-3">
			<div class="min-w-0">
				<Text variant="accent-label" tag="span" class="mb-4 block text-brand-accent">
					{content.office.label}
				</Text>
				<Text variant="lead" class="font-bold text-white">{content.office.addressLine}</Text>
				<Text variant="body" class="mt-2 text-white/65">{content.office.city}</Text>
				<Text variant="body" class="mt-2 text-xs text-white/45">
					<Icon name={iconName("clock")} class="mr-2 align-middle" />
					{content.office.hours}
				</Text>
			</div>

			<div class="min-w-0">
				<Text variant="accent-label" tag="span" class="mb-4 block text-brand-accent">
					{content.company.label}
				</Text>
				<Text variant="lead" class="font-bold text-white">{content.company.name}</Text>
				<Text variant="body" class="mt-3 font-mono text-sm text-white/50">{content.company.nip}</Text>
			</div>

			<div class="min-w-0">
				<Text variant="accent-label" tag="span" class="mb-4 block text-brand-accent">
					{content.contactLabel}
				</Text>
				<ul class="space-y-4" role="list">
					{[...content.contacts, ...content.socials].map((item) => (
						<li>
							<a
								href={item.href}
				class="ui-footer-contact-line group flex h-11 min-w-0 items-center gap-3 transition-colors hover:text-brand-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
								target={item.icon === "facebook" ? "_blank" : undefined}
								rel={item.icon === "facebook" ? "noopener noreferrer" : undefined}
								aria-label={item.label}
							>
								<span class="flex h-10 w-10 min-w-0 items-center justify-center rounded-xl border border-white/10 bg-white/5">
									<Icon
										name={iconName(item.icon)}
										class="text-lg text-white/80 transition-colors group-hover:text-brand-accent"
									/>
								</span>
								<span class="min-w-0">
									<Text variant="accent-label" tag="span" class="block !text-[10px] text-white/40">
										{item.label}
									</Text>
									<Text variant="body" tag="span" class="font-bold text-white transition-colors group-hover:text-brand-accent">
										{item.value}
									</Text>
								</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div
			data-motion="fade"
			class="mt-14 flex min-w-0 flex-col gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between"
		>
			<Text variant="body" class="!text-xs text-white/35">
				{content.copyrightPrefix} {year} {content.company.name} {content.copyrightSuffix}
				<a
					href={content.adminLink.href}
					class="ui-footer-contact-line ml-2 inline-flex h-11 items-center gap-1 opacity-50 transition-colors transition-opacity hover:text-brand-accent hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
					title={content.adminLink.title}
					aria-label={content.adminLink.label}
				>
					<Icon name="lock-key" />
					<span>{content.adminLink.label}</span>
				</a>
			</Text>
			<div class="flex min-w-0 flex-wrap items-center gap-6">
				{content.legal.map((link) => (
					<a href={link.href} aria-label={link.label} class="ui-footer-contact-line inline-flex h-11 items-center transition-colors hover:text-white/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent">
						<Text variant="accent-label" tag="span" class="text-white/35">{link.label}</Text>
					</a>
				))}
				<a
					href={content.attribution.href}
					target="_blank"
					rel="noopener noreferrer"
					class="ui-footer-contact-line inline-flex h-11 items-center transition-colors hover:text-brand-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
					aria-label={content.attribution.label}
				>
					<Text variant="accent-label" tag="span" class="font-bold text-white/35 hover:text-brand-accent">
						{content.attribution.label}
					</Text>
				</a>
			</div>
		</div>
	</Container>
</footer>
