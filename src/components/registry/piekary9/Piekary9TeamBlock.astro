---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import teamContent from "@data/sections/piekary9-team.json";

type TeamData = typeof teamContent;

export interface Props {
	data?: TeamData;
	id?: string;
	class?: string;
}

const { data, id = "team-v2", class: className = "" } = Astro.props as Props;
const content = data ?? teamContent;
const isPlaceholder = content.image.url.startsWith("/placeholder");
---

<Section id={id} tone="page" class:list={["bg-brand-cream scroll-mt-28", className]}>
	<Container>
		<div class="mb-16 min-w-0 text-center">
			<div data-motion="fade" class="mb-6 flex min-w-0 items-center justify-center gap-4">
				<span class="h-px w-8 shrink-0 bg-brand-accent" aria-hidden="true"></span>
				<Text variant="accent-label" tag="span">{content.sectionLabel}</Text>
				<span class="h-px w-8 shrink-0 bg-brand-accent" aria-hidden="true"></span>
			</div>
			<Heading id={`${id}-heading`} variant="section-subtitle" motion="fade">
				{content.title}
			</Heading>
			<Text variant="lead" motion="fade" class="mx-auto mt-6 max-w-2xl">
				{content.description}
			</Text>
		</div>

		<div class="grid min-w-0 gap-6 lg:grid-cols-12">
			<div
				data-motion="fade"
				class="group relative min-h-[450px] min-w-0 overflow-hidden rounded-[2.5rem] bg-brand-dark lg:col-span-8 lg:h-full"
			>
				{isPlaceholder ? (
					<div class="flex min-w-0 h-full w-full items-center justify-center">
						<span class="sr-only">{content.image.placeholderLabel}</span>
					</div>
				) : (
					<img
						src={content.image.url}
						alt={content.image.alt}
						width="1200"
						height="800"
						loading="lazy"
						class="absolute inset-0 h-full w-full object-cover object-[center_10%] transition-transform duration-700 group-hover:scale-105"
					/>
				)}
			</div>

			<div
				data-motion="fade"
				class="flex min-w-0 flex-col items-center justify-center rounded-[2.5rem] border border-brand-dark/5 bg-white p-10 text-center shadow-2xl shadow-brand-dark/5 lg:col-span-4"
			>
				<div data-motion="fade" class="w-full min-w-0 space-y-6">
					{content.members.map((member) => (
						<div class="group relative min-w-0 border-t border-brand-dark/5 pt-6 transition-colors first:border-t-0">
							<Text variant="lead" class="font-bold text-brand-dark transition-colors group-hover:text-brand-accent">
								{member.name}
							</Text>
							<Text variant="accent-label" class="mt-1 !tracking-[0.2em] text-brand-dark/30 transition-colors group-hover:text-brand-accent/60">
								{member.role}
							</Text>
						</div>
					))}
				</div>
			</div>
		</div>
	</Container>
</Section>
