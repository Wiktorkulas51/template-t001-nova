---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import Text from "@components/ui/atoms/Text.astro";
import questionsCtaContent from "@data/sections/piekary9-questions-cta.json";

type QuestionsCtaData = typeof questionsCtaContent;

export interface Props {
	data?: QuestionsCtaData;
	id?: string;
	class?: string;
}

const { data, id = "pytania", class: className = "" } = Astro.props as Props;
const content = data ?? questionsCtaContent;
const phoneDisplay = content.advisor.phone;
const telHref = `tel:${phoneDisplay.replace(/\s/g, "")}`;
---

<Section id={id} tone="page" class:list={["bg-brand-cream scroll-mt-28", className]}>
	<Container>
		<div data-motion="fade" class="min-w-0 rounded-[2.5rem] border border-brand-dark/5 bg-white p-8 shadow-xl shadow-brand-dark/5 lg:p-12">
			<div class="grid min-w-0 gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
				<div data-motion="fade" class="flex min-w-0 flex-col gap-6 lg:col-span-7">
					<div class="flex min-w-0 items-center gap-4">
						<span class="h-px w-8 shrink-0 bg-brand-accent" aria-hidden="true"></span>
						<Text variant="accent-label" tag="span">{content.eyebrow}</Text>
					</div>
					<Heading id={`${id}-heading`} variant="section-title" class="text-balance">
						{content.title}
					</Heading>
					<Text variant="lead" class="max-w-xl">{content.description}</Text>
					<div>
						<a
							href={content.ctaHref}
							class="group relative inline-flex h-11 min-w-0 items-center justify-center gap-2 overflow-hidden rounded-full bg-brand-accent px-8 py-3 text-[10px] font-black uppercase tracking-[0.2em] text-brand-dark shadow-lg shadow-brand-accent/20 transition-[box-shadow,transform] hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-accent/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-dark"
							aria-label={content.ctaLabel}
						>
							<span class="relative z-10">{content.ctaLabel}</span>
							<Icon name="arrow-right" class="relative z-10 text-xs transition-transform group-hover:translate-x-1" />
							<span class="absolute inset-0 translate-y-full bg-white/20 transition-transform duration-300 group-hover:translate-y-0" aria-hidden="true"></span>
						</a>
					</div>
				</div>

				<div
					data-motion="fade"
					class="flex min-w-0 flex-col items-center gap-5 border-t border-brand-dark/10 pt-10 text-center lg:col-span-5 lg:items-start lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0 lg:text-left"
				>
					<div class="relative h-32 w-32 shrink-0 overflow-hidden rounded-full ring-2 ring-brand-accent/25 ring-offset-4 ring-offset-white">
						{content.advisor.photo.url ? (
							<img
								src={content.advisor.photo.url}
								alt={content.advisor.photo.alt}
								width="128"
								height="128"
								class="h-full w-full object-cover"
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div class="flex min-w-0 h-full w-full items-center justify-center bg-brand-cream" aria-hidden="true">
								<Icon name="user" class="text-5xl text-brand-dark/20" />
							</div>
						)}
					</div>
					<div class="min-w-0 space-y-1">
						<Text tag="p" variant="lead" class="!text-xl font-bold text-brand-dark">{content.advisor.name}</Text>
						<Text variant="body" class="!text-sm text-brand-dark/55">{content.advisor.role}</Text>
					</div>
					<a
						href={telHref}
						class="inline-flex h-11 min-w-0 items-center text-base font-bold text-brand-accent transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-dark"
						aria-label={`${content.advisor.phoneAriaLabel}: ${phoneDisplay}`}
					>
						{phoneDisplay}
					</a>
				</div>
			</div>
		</div>
	</Container>
</Section>
