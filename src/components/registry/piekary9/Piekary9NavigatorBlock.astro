---
/**
 * Full Piekary premises navigator. Internal components preserve the front
 * and courtyard view, SVG pins, filtering, table, panel, modal, purchase
 * drawer, gallery and interface state persistence in localStorage.
 */
import Navigator from "@components/registry/piekary9-navigator/Navigator.astro";

export interface Props {
  id?: string;
  class?: string;
}

const { id = "oferta", class: className = "" } = Astro.props as Props;
---

<div data-section-id={id} class:list={className}>
  <Navigator />
</div>
