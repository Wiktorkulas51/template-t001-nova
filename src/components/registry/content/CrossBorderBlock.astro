---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import { formatInternalLink } from "@utils/url";
import data from "@data/sections/cross-border.json";

// Dlaczego: CrossBorderBlock to kopia wizualna sekcji "pomoc transgraniczna"
// from the Tymoteusz-Juszczak project (law firm). The content is general,
// not client ones, but color tokens converted into global brand starter-kit tokens.
type StepItem = {
  title: string;
  description: string;
};

type AreaItem = {
  title: string;
  description: string;
};

export interface Props {
  sectionId?: string;
  /** Content language with JSON (src/data/sections/cross-border.json). PL is the default.*/
  lang?: "pl" | "en";
  title?: string;
  lead?: string;
  steps?: StepItem[];
  areas?: AreaItem[];
  /** Section header tag: 'h2' by default, 'h1' when the block is the first section of a page without hero (SEO).*/
  headingTag?: string;
}

const {
  sectionId = "cross-border",
  lang = "pl",
  title,
  lead,
  steps,
  areas,
  headingTag = "h2",
} = Astro.props as Props;

// Why: "props || JSON" pattern to make the block work on its own with the data
// sections, and PageBuilder could overwrite each content individually.
const t = data[lang] ?? data.pl;
const resolvedTitle = title || t.title;
const resolvedLead = lead || t.lead;
const resolvedSteps = steps ?? t.steps;
const resolvedAreas = areas ?? t.areas;

// Why: CTA and subheading texts were originally hard constants per language,
// so they stay in the component, not in the JSON (section content only keeps steps and areas).
const isPl = lang === "pl";
const eyebrow = isPl ? "Pomoc transgraniczna" : "Cross-border assistance";
const stepHeading = isPl ? "Jak wygląda pomoc" : "How it works";
const sectionTitle = isPl ? "Zakres spraw" : "Practice areas";
const ctaTitle = isPl ? "Potrzebujesz pomocy?" : "Need help?";
const ctaDesc = isPl ? "Umów się na konsultację. Służę pomocą." : "Book a consultation. I am here to help.";
const ctaLabel = isPl ? "Umów konsultację" : "Book a consultation";
const ctaHover = isPl ? "Wyślij wiadomość" : "Send a message";
const ctaHref = formatInternalLink("/#kontakt");

// Why: Phosphor icons for steps and areas, defined locally as in the original.
const stepIcons = ["handshake", "briefcase", "check-circle"];
const areaIcons = ["gavel", "buildings", "users-three", "house", "hand", "shield-chevron"];
---

<Section id={sectionId} tone="page" class="relative overflow-hidden">
  <!-- Why: orb gradient in the upper right corner, as in the original, but with a global one
       tokenem brand-primary zamiast klienckiego accent-primary. -->
  <div
    class="pointer-events-none absolute top-0 right-0 h-96 w-96 max-w-full"
    style="background:radial-gradient(ellipse 60% 60% at 100% 0%, color-mix(in oklab, var(--color-brand-primary) 12%, transparent) 0%, transparent 60%)"
    aria-hidden="true"
  ></div>
  <Container>
    <div class="pt-16 md:pt-20">
      <div class="mb-36 text-center">
        <Text variant="accent-label" class="mb-4 text-brand-dark" motion="fade">
          {eyebrow}
        </Text>
        <Heading tag={headingTag} variant="section-title" class="mb-5 text-brand-dark" motion="fade">
          {resolvedTitle}
        </Heading>
        <Text variant="lead" class="mx-auto max-w-2xl text-brand-dark/70" motion="fade">
          {resolvedLead}
        </Text>
      </div>

      {resolvedSteps.length > 0 && (
        <div class="mb-36">
          <!-- Why: a delicate line separating the section heading from the content (original model).-->
          <div class="mx-auto mb-12 w-3/4 border-t border-brand-dark/10"></div>

          <Heading
            tag="h3"
            variant="section-title"
            class="mb-10 text-center text-brand-dark"
            style="font-weight:500;letter-spacing:0.06em"
          >
            {stepHeading}
          </Heading>

          <!-- Why: step card with an icon in a colored square; hover raises
               frame and adds a glow in the brand color (original pattern).-->
          <div class="grid gap-6 md:grid-cols-3">
            {resolvedSteps.map((step, i) => (
              <div class="step-card group rounded-2xl border border-brand-dark/10 bg-white p-6">
                <div class="mb-5 flex size-14 items-center justify-center rounded-xl bg-brand-primary text-2xl text-brand-dark">
                  <Icon name={stepIcons[i % stepIcons.length]} />
                </div>
                <Heading tag="h4" variant="feature-title" class="mb-2 text-xl text-brand-dark">
                  {step.title}
                </Heading>
                <Text variant="feature-body-sm" class="text-brand-dark/70">
                  {step.description}
                </Text>
              </div>
            ))}
          </div>
        </div>
      )}

      {resolvedAreas.length > 0 && (
        <div class="mb-20">
          <div class="mx-auto mb-12 w-3/4 border-t border-brand-dark/10"></div>

          <Heading
            tag="h3"
            variant="section-title"
            class="mb-10 text-center text-brand-dark"
            style="font-weight:500;letter-spacing:0.06em"
          >
            {sectionTitle}
          </Heading>

          <!-- Dlaczego: karta obszaru w 2 kolumnach na tabletach i desktopie,
               icon on left, content in column; hover raises the frame (original pattern).-->
          <div class="grid gap-5 sm:grid-cols-2">
            {resolvedAreas.map((area, i) => (
              <div class="area-card group flex gap-4 rounded-2xl border border-brand-dark/10 p-5">
                <div class="flex size-14 shrink-0 items-center justify-center rounded-xl bg-brand-primary text-2xl text-brand-dark">
                  <Icon name={areaIcons[i % areaIcons.length]} />
                </div>
                <div class="min-w-0">
                  <Heading tag="h4" variant="feature-title" class="mb-1 text-lg text-brand-dark">
                    {area.title}
                  </Heading>
                  <Text variant="feature-body-sm" class="text-brand-dark/70">
                    {area.description}
                  </Text>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="mx-auto mb-14 w-3/4 border-t border-brand-dark/10"></div>

      <!-- Why: CTA card with button; the background is a delicate brand shade
           (color-mix 12%), hover thickens the frame. Button by Button with hoverText,
           bo starter-kit nie ma klienckiej animacji btn-slide. -->
      <div class="cta-card rounded-2xl border border-brand-dark/10 p-10 text-center" style="background:color-mix(in oklab, var(--color-brand-primary) 12%, transparent)">
        <Heading tag="h3" variant="section-title" class="mb-3 text-brand-dark">
          {ctaTitle}
        </Heading>
        <Text variant="body" class="mx-auto mb-8 max-w-md text-brand-dark/70">
          {ctaDesc}
        </Text>
        <Button href={ctaHref} variant="primary" size="lg" hoverText={ctaHover}>
          {ctaLabel}
        </Button>
      </div>
    </div>
  </Container>
</Section>

<style>
  /* Why: hovering on step and area cards raises the frame to the brand color,
     and the step card additionally receives a glow (original pattern, client token
     zamieniony na globalny brand-primary). */
  .step-card:hover,
  .area-card:hover {
    border-color: var(--color-brand-primary) !important;
  }
  .step-card:hover {
    box-shadow: 0 0 30px color-mix(in oklab, var(--color-brand-primary) 20%, transparent);
  }
  .cta-card:hover {
    border-color: color-mix(in oklab, var(--color-brand-primary) 55%, transparent) !important;
  }
</style>
