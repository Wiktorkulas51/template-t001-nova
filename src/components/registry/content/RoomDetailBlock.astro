---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import { formatInternalLink } from "@utils/url";

type RoomImage = {
	src?: string;
	thumb?: string;
	alt?: string;
};

type RoomHighlight = {
	icon?: string;
	label?: string;
	text?: string;
};

export interface Props {
	sectionId?: string;
	eyebrow?: string;
	title?: string;
	description?: string;
	ctaLabel?: string;
	ctaHref?: string;
	backLabel?: string;
	backHref?: string;
	aboutTitle?: string;
	aboutDescription?: string;
	infoTitle?: string;
	infoItems?: string[];
	highlights?: RoomHighlight[];
	images?: RoomImage[];
	headingTag?: string;
}

const {
	sectionId = "pokoj",
	eyebrow = "",
	title = "",
	description = "",
	ctaLabel = "Zapytaj o termin",
	ctaHref = "/kontakt-rezerwacja/#rezerwacja",
	backLabel = "Wszystkie pokoje",
	backHref = "/pokoje/",
	aboutTitle = "O pokoju",
	aboutDescription = "",
	infoTitle = "Podstawowe informacje",
	infoItems = [],
	highlights = [],
	images: rawImages = [],
	headingTag = "h2",
} = Astro.props;

const shouldRenderEyebrow = eyebrow.trim() !== "" && eyebrow.trim().toLowerCase() !== title.trim().toLowerCase();
const images = Array.isArray(rawImages) ? rawImages.filter((image) => image?.src) : [];
const firstImage = images[0];
const sideImages = images.slice(1, 3);
const galleryItems = images.map((image) => ({
	src: image.src || "",
	title: image.alt || "",
	alt: image.alt || "",
}));
const galleryJson = JSON.stringify(galleryItems);
const primaryHref = formatInternalLink(ctaHref);
const secondaryHref = formatInternalLink(backHref);
---

<Section id={sectionId} tone="page" class="room-detail-block">
	<Container>
		<header class="max-w-4xl">
			{shouldRenderEyebrow && <Text variant="accent-label" class="mb-5 text-brand-primary">{eyebrow}</Text>}
			{title && (
				<Heading tag={headingTag} variant="section-heading-xl" class="max-w-2xl text-brand-dark">
					{title}
				</Heading>
			)}
			{description && (
				<Text variant="lead" class="mt-5 max-w-3xl text-brand-dark/80">
					{description}
				</Text>
			)}
			<nav class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3" aria-label="Nawigacja po pokoju">
				<Button href={primaryHref} variant="primary" size="md" hoverText="Pisz!" class="!rounded-full">
					{ctaLabel}
				</Button>
				<a
					href={secondaryHref}
					class="group relative inline-flex items-center pb-1 font-heading text-xs font-medium tracking-[0.1em] text-brand-dark/65 transition-[color,transform] duration-300 hover:-translate-y-0.5 hover:text-brand-primary focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/40"
				>
					<span>{backLabel}</span>
					<span
						aria-hidden="true"
						class="absolute inset-x-0 bottom-0 h-px origin-right scale-x-100 bg-brand-dark/25 transition-[transform,background-color] duration-300 group-hover:origin-left group-hover:scale-x-100 group-hover:bg-brand-primary"
					></span>
				</a>
			</nav>
		</header>

		{firstImage ? (
			<>
				<div class="mt-12">
					<div class="flex items-center justify-between gap-4">
						<Text variant="accent-label" tag="span" class="text-brand-dark/65">Galeria zdjęć</Text>
						<Text variant="feature-body-sm" tag="span" class="text-brand-dark/55">{images.length} zdjęć</Text>
					</div>
					<div class="mt-3 grid gap-2.5 md:h-[32rem] md:grid-cols-[1.65fr_1fr] md:grid-rows-2" data-room-detail-gallery>
					<button
						type="button"
						data-room-detail-select="0"
						data-lightbox
						data-href={firstImage.src}
						data-title={firstImage.alt || title}
						data-lightbox-gallery={galleryJson}
						class="group relative aspect-[4/3] overflow-hidden rounded-[1rem] bg-brand-dark/10 text-left md:row-span-2 md:aspect-auto md:h-full"
						aria-label={`Otwórz zdjęcie ${1}`}
					>
						<img
							data-room-detail-main
							src={firstImage.src}
							alt={firstImage.alt || title}
							width={1200}
							height={800}
							loading="eager"
							decoding="async"
							class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.025]"
						/>
						<img
							data-room-detail-overlay
							alt=""
							aria-hidden="true"
							width={1200}
							height={800}
							class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-in-out"
						/>
					</button>

					{sideImages.map((image, index) => (
						<button
							type="button"
							data-room-detail-select={index + 1}
							data-room-detail-src={image.src}
							data-lightbox
							data-href={image.src}
							data-title={image.alt || title}
							data-lightbox-gallery={galleryJson}
							class="group relative aspect-[4/3] overflow-hidden rounded-[1rem] bg-brand-dark/10 text-left md:aspect-auto md:h-full"
							aria-label={`Otwórz zdjęcie ${index + 2}`}
						>
							<SmartImage
								src={image.src}
								alt={image.alt || `${title}, zdjęcie ${index + 2}`}
								width={900}
								height={700}
								class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.025]"
							/>
						</button>
					))}
					</div>
				<div class="mt-3 flex gap-2.5 overflow-x-auto pb-2" aria-label="Miniatury zdjęć" data-room-detail-thumbs>
					{images.map((image, index) => (
						<button
							type="button"
							data-room-detail-thumb={index}
							data-room-detail-src={image.src}
							data-lightbox
							data-href={image.src}
							data-title={image.alt || title}
							data-lightbox-gallery={galleryJson}
							class:list={[
								"group shrink-0 overflow-hidden rounded-[0.9rem] border-2 border-transparent transition-colors duration-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/40",
								{ "border-brand-primary": index === 0 },
							]}
							aria-label={`Otwórz zdjęcie ${index + 1}`}
							aria-selected={index === 0 ? "true" : "false"}
						>
							<SmartImage
								src={image.thumb || image.src}
								alt={image.alt || `${title}, miniatura ${index + 1}`}
								width={220}
								height={180}
								class="h-20 w-24 object-cover transition-transform duration-700 ease-out group-hover:scale-105 sm:h-24 sm:w-32"
							/>
						</button>
					))}
					</div>
				</div>
			</>
		) : (
			<div class="mt-12 rounded-[1.25rem] border border-brand-dark/10 py-24 text-center">
				<Text variant="body" class="text-brand-dark/55">Galeria zostanie uzupełniona.</Text>
			</div>
		)}

		<div class="mt-16 grid gap-10 border-t border-brand-dark/25 pt-10 lg:grid-cols-[1.08fr_0.92fr] lg:gap-16">
			<div>
				{aboutTitle && <Heading level={2} variant="section-heading-lg">{aboutTitle}</Heading>}
				{aboutDescription && (
					<Text variant="body" class="mt-5 max-w-2xl text-brand-dark/72">
						{aboutDescription}
					</Text>
				)}
				{highlights.length > 0 && (
					<div class="mt-8 grid gap-4 sm:grid-cols-3">
						{highlights.map((item) => (
							<div class="border-t border-brand-dark/20 pt-4">
								<div class="flex items-start gap-3">
									<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-primary/10 text-brand-primary">
										<Icon name={item.icon || "sparkle"} size={18} />
									</span>
									<span class="min-w-0">
										<strong class="block text-sm font-semibold text-brand-dark">{item.label}</strong>
										{item.text && <span class="mt-1 block text-xs leading-relaxed text-brand-dark/60">{item.text}</span>}
									</span>
								</div>
							</div>
						))}
					</div>
				)}
			</div>
			<div class="rounded-[1.25rem] border border-brand-dark/15 bg-brand-light/35 p-6 lg:border-l lg:pl-12">
				{infoTitle && <Heading level={2} variant="section-heading-lg">{infoTitle}</Heading>}
				<div class="mt-5 divide-y divide-brand-dark/15 border-y border-brand-dark/15">
					{infoItems.map((item) => (
						<div class="py-4 text-brand-dark/75">{item}</div>
					))}
				</div>
				<a
					href={primaryHref}
					class="group mt-6 inline-flex items-center gap-2 border-b border-brand-primary/60 pb-1 font-heading text-xs font-medium tracking-[0.1em] text-brand-dark transition-[color,border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-brand-primary hover:text-brand-primary focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/40"
				>
					{ctaLabel}
					<i aria-hidden="true" class="ph ph-arrow-up-right text-sm transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
				</a>
			</div>
		</div>
	</Container>
</Section>

<script is:inline>
	(() => {
		function setupRoomDetail(root) {
			if (!(root instanceof HTMLElement) || root.dataset.roomDetailReady === "true") return;

			const main = root.querySelector("[data-room-detail-main]");
			const overlay = root.querySelector("[data-room-detail-overlay]");
			const buttons = Array.from(root.querySelectorAll("[data-room-detail-select]"));
			const thumbs = Array.from(root.querySelectorAll("[data-room-detail-thumb]"));
			if (!(main instanceof HTMLImageElement) || !(overlay instanceof HTMLImageElement)) return;

			const images = thumbs.map((thumb) => ({
				src: thumb.getAttribute("data-room-detail-src") || "",
				alt: thumb.querySelector("img")?.getAttribute("alt") || "",
			}));
			const mainButton = buttons[0];
			if (!(mainButton instanceof HTMLElement)) return;
			images[0] = { src: mainButton.getAttribute("data-href") || images[0]?.src || "", alt: mainButton.getAttribute("data-title") || images[0]?.alt || "" };

			function selectImage(index) {
				const image = images[index];
				if (!image?.src || index === 0 && main.src.endsWith(image.src)) return;

				const preload = new Image();
				preload.onload = () => {
					overlay.src = image.src;
					overlay.onload = () => {
						requestAnimationFrame(() => overlay.classList.add("opacity-100"));
						window.setTimeout(() => {
							main.src = image.src;
							main.alt = image.alt;
							overlay.classList.remove("opacity-100");
						}, 720);
					};
				};
				preload.src = image.src;

				mainButton.setAttribute("data-href", image.src);
				mainButton.setAttribute("data-title", image.alt);
				thumbs.forEach((thumb, thumbIndex) => {
					if (!(thumb instanceof HTMLButtonElement)) return;
					thumb.setAttribute("aria-selected", thumbIndex === index ? "true" : "false");
					thumb.classList.toggle("border-brand-primary", thumbIndex === index);
					thumb.classList.toggle("border-transparent", thumbIndex !== index);
				});
			}

			buttons.forEach((button) => {
				button.addEventListener("click", () => {
					const index = Number(button.getAttribute("data-room-detail-select"));
					if (Number.isInteger(index)) selectImage(index);
				});
			});
			thumbs.forEach((thumb) => {
				thumb.addEventListener("click", () => {
					const index = Number(thumb.getAttribute("data-room-detail-thumb"));
					if (Number.isInteger(index)) selectImage(index);
				});
			});

			root.dataset.roomDetailReady = "true";
		}

		function initRoomDetails() {
			document.querySelectorAll(".room-detail-block").forEach(setupRoomDetail);
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initRoomDetails, { once: true });
		} else {
			initRoomDetails();
		}
		document.addEventListener("astro:page-load", initRoomDetails);
	})();
</script>
