---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import defaultData from "@data/sections/mystek-knowledge-video.json";
type Item = { title: string; description: string };
type Copy = { eyebrow: string; title: string; description?: string; items?: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }
const { data, locale = "pl", sectionId = "mystek-knowledge-video", class: className = "" } = Astro.props as Props;
const t = ((data ?? (defaultData as Data))[locale] ?? (data ?? (defaultData as Data)).pl) as Copy;
---
<Section id={sectionId} tone="page" class:list={["relative overflow-hidden", className]}>
  <Container>
    <header class="mb-12 max-w-3xl md:mb-16"><Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>{t.description && <Text variant="lead" class="mt-5 text-brand-dark/65">{t.description}</Text>}</header>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{(t.items ?? []).map((item, index) => (<article class="group overflow-hidden rounded-2xl bg-brand-dark p-5 shadow-soft"><div class="relative aspect-video overflow-hidden rounded-xl border border-white/10 bg-black/20"><div class="absolute inset-0 grid place-items-center"><span class="flex size-14 items-center justify-center rounded-full bg-white text-brand-dark shadow-xl transition-[transform] duration-300 group-hover:scale-105">▶</span></div><Text variant="accent-label" class="absolute bottom-3 left-3 text-white/50">WIDEO 0{index + 1}</Text></div><div class="px-1 pb-2 pt-5"><Heading tag="h3" variant="feature-title" class="text-white">{item.title}</Heading><Text variant="body" class="mt-3 text-white/65">{item.description}</Text><div class="mt-5 h-1 w-12 bg-brand-primary transition-[width] duration-300 group-hover:w-full"></div></div></article>))}</div>
  </Container>
</Section>
