---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/mystek-documentation-process.json";

type Item = { stepLabel: number; title: string; tag: string; description: string };
type Copy = { eyebrow: string; title: string; titleAccent: string; description: string; ctaTitle: string; ctaText: string; ctaHref: string; items: Item[] };
interface Props { data?: { pl: Copy; en?: Copy }; pl?: Copy; en?: Copy; locale?: "pl" | "en"; class?: string }

const { data, pl, en, locale = "pl", class: className = "" } = Astro.props as Props;
const source = data ?? (pl ? { pl, en } : (jsonData as { pl: Copy; en?: Copy }));
const t = source[locale] ?? source.pl;
---

<Section id="proces-dokumentacji" tone="base" class:list={["relative overflow-hidden", className]}>
	<div class="mystek-blueprint-grid pointer-events-none absolute inset-0 opacity-35"></div>
	<div class="pointer-events-none absolute top-0 left-1/4 h-full w-px bg-gradient-to-b from-transparent via-brand-dark/10 to-transparent md:left-1/3"></div>
	<div class="pointer-events-none absolute top-0 right-1/4 h-full w-px bg-gradient-to-b from-transparent via-brand-dark/10 to-transparent"></div>

	<Container class="relative z-10">
		<div class="mx-auto mb-16 max-w-4xl text-center lg:mb-24" data-motion="fade">
			<Text variant="accent-label" class="mb-5 text-brand-primary">{t.eyebrow}</Text>
			<Heading tag="h2" variant="section-heading-xl" class="mb-6">
				{t.title}<br />
				<span class="ui-text-gradient">{t.titleAccent}</span>
			</Heading>
			<Text variant="lead" class="mx-auto max-w-3xl text-brand-dark/65">{t.description}</Text>
		</div>

		<div class="relative mx-auto max-w-5xl">
			<div class="absolute top-4 bottom-4 left-5 w-px bg-brand-primary/20 md:left-1/2 md:-translate-x-1/2" aria-hidden="true"></div>
			<ol class="space-y-12 md:space-y-20">
				{t.items.map((item, index) => {
					const isEven = index % 2 === 0;
					return (
						<li class:list={["relative grid grid-cols-[2.5rem_1fr] gap-5 md:grid-cols-2 md:gap-16", isEven ? "md:text-right" : "md:text-left"]} data-motion="fade" style={`--motion-delay: ${index * 120}ms`}>
							<div class="relative z-10 col-start-1 row-start-1 flex justify-center md:col-span-2 md:col-start-1">
								<div class="flex size-10 items-center justify-center rounded-xl border border-brand-primary/30 bg-brand-light text-sm font-bold text-brand-primary shadow-sm">{String(item.stepLabel).padStart(2, "0")}</div>
							</div>
							<div class:list={["col-start-2 row-start-1 pt-1 md:col-span-1 md:col-start-1", !isEven && "md:col-start-2 md:row-start-1"]}>
								<Text variant="accent-label" class="mb-3 text-brand-primary/65">{item.tag}</Text>
								<Heading tag="h3" variant="feature-heading-md" class="mb-3">{item.title}</Heading>
								<Text variant="body" class="text-brand-dark/65">{item.description}</Text>
							</div>
						</li>
					);
				})}
			</ol>
		</div>

		<div class="mx-auto mt-16 max-w-2xl text-center" data-motion="fade">
			<Heading tag="h3" variant="section-title" class="mb-6">{t.ctaTitle}</Heading>
			<a href={t.ctaHref} class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand-primary px-6 py-3 text-sm font-bold text-white transition-[background-color,transform] duration-300 hover:-translate-y-0.5 hover:bg-brand-primary/90 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/40">{t.ctaText}</a>
		</div>
	</Container>
</Section>

<style>
	.mystek-blueprint-grid {
		background-image:
			linear-gradient(to right, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px);
		background-size: 4rem 4rem;
	}
</style>
