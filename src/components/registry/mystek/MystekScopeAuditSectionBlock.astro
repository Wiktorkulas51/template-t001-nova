---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/mystek-audit-scope.json";

type Item = { title: string; description: string; code: string };
type Copy = {
	eyebrow: string;
	title: string;
	titleAccent: string;
	description: string;
	standardLabel: string;
	standard: string;
	items: Item[];
};

interface Props {
	data?: { pl: Copy; en?: Copy };
	pl?: Copy;
	en?: Copy;
	locale?: "pl" | "en";
	class?: string;
}

const { data, pl, en, locale = "pl", class: className = "" } = Astro.props as Props;
const source = data ?? (pl ? { pl, en } : (jsonData as { pl: Copy; en?: Copy }));
const t = source[locale] ?? source.pl;
---

<Section tone="page" class:list={["relative overflow-hidden", className]}>
	<div class="mystek-blueprint-grid pointer-events-none absolute inset-0 opacity-50"></div>
	<Container class="relative z-10">
		<div class="mb-16 flex flex-col justify-between gap-6 lg:mb-24 lg:flex-row lg:items-start lg:gap-8" data-motion="fade">
			<div class="max-w-3xl">
				<Text variant="accent-label" class="mb-6 text-brand-primary">{t.eyebrow}</Text>
				<Heading tag="h2" variant="section-heading-xl" class="mb-6">
					{t.title}<br />
					<span class="ui-text-gradient">{t.titleAccent}</span>
				</Heading>
				<Text variant="lead" class="max-w-2xl text-brand-dark/65">{t.description}</Text>
			</div>
			<div class="lg:self-end lg:text-right">
				<Text variant="accent-label" class="mb-2 text-brand-primary">{t.standardLabel}</Text>
				<Text variant="body" class="font-bold text-brand-dark">{t.standard}</Text>
			</div>
		</div>

		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
			{t.items.map((item, index) => (
				<article
					class:list={[
						"group relative overflow-hidden rounded-2xl border border-brand-dark/10 bg-white p-7 shadow-soft ui-card-interactive",
						index === 0 || index === t.items.length - 1 ? "lg:col-span-2" : "lg:col-span-1",
					]}
					data-motion="fade"
					style={`--motion-delay: ${index * 80}ms`}
				>
					<div class="pointer-events-none absolute top-0 right-0 h-32 w-32 translate-x-1/3 -translate-y-1/3 rounded-full bg-brand-primary/5 blur-3xl"></div>
					<div class="relative z-10 flex items-start justify-between gap-6">
						<Text variant="accent-label" class="text-brand-primary">{item.code}</Text>
						<div class="h-7 w-7 border border-brand-primary/30 bg-brand-primary/5 transition-transform duration-500 group-hover:rotate-45"></div>
					</div>
					<Heading tag="h3" variant="feature-heading-md" class="relative z-10 mt-8 mb-4">{item.title}</Heading>
					<Text variant="body" class="relative z-10 text-brand-dark/65">{item.description}</Text>
				</article>
			))}
		</div>
	</Container>
</Section>

<style>
	.mystek-blueprint-grid {
		background-image:
			linear-gradient(to right, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px);
		background-size: 4rem 4rem;
	}
</style>
