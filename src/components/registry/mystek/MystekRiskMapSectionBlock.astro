---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/mystek-audit-risk-map.json";

type MiniStat = { label: string; value: string; description: string; footerLabel: string };
type Copy = {
	eyebrow: string;
	title: string;
	titleAccent: string;
	description: string;
	criticalStat: { label: string; value: string; subtitle: string; description: string; status: string };
	miniStats: MiniStat[];
	footnote: string;
};

interface Props {
	data?: { pl: Copy; en?: Copy };
	pl?: Copy;
	en?: Copy;
	locale?: "pl" | "en";
	class?: string;
}

const { data, pl, en, locale = "pl", class: className = "" } = Astro.props as Props;
const source = data ?? (pl ? { pl, en } : (jsonData as { pl: Copy; en?: Copy }));
const t = source[locale] ?? source.pl;
---

<Section tone="base" id="ryzyka-audytowe" class:list={["relative overflow-hidden", className]}>
	<div class="mystek-blueprint-grid pointer-events-none absolute inset-0 opacity-40"></div>
	<Container class="relative z-10">
		<div class="mb-16 max-w-3xl lg:mb-20" data-motion="fade">
			<Text variant="accent-label" class="mb-6 text-brand-primary">{t.eyebrow}</Text>
			<Heading tag="h2" variant="section-heading-xl" class="mb-6">
				{t.title}<br />
				<span class="ui-text-gradient">{t.titleAccent}</span>
			</Heading>
			<Text variant="lead" class="text-brand-dark/65">{t.description}</Text>
		</div>

		<div class="grid auto-rows-min gap-6 md:auto-rows-[220px] md:grid-cols-2 lg:grid-cols-4">
			<article class="group relative overflow-hidden rounded-[2.5rem] border border-brand-dark/10 bg-brand-dark p-8 text-white shadow-xl transition-[transform,box-shadow] duration-500 hover:scale-[1.01] ui-card-interactive md:col-span-2 md:row-span-2 md:p-10" data-motion="fade">
				<div class="relative z-10 flex h-full flex-col justify-between">
					<div>
						<Heading tag="h3" variant="section-heading-lg" class="mb-4 !text-white">{t.criticalStat.label}</Heading>
						<Text variant="lead" class="max-w-md !text-white/70">{t.criticalStat.description}</Text>
					</div>
					<div class="mt-8 flex flex-col items-start justify-between gap-6 sm:mt-0 sm:flex-row sm:items-end">
						<div class="flex flex-col">
							<span class="text-5xl font-black tracking-tighter sm:text-7xl">{t.criticalStat.value}</span>
							<Text variant="accent-label" class="!text-white/60">{t.criticalStat.subtitle}</Text>
						</div>
						<div class="rounded-full border border-white/20 bg-white/10 px-4 py-2 backdrop-blur-md">
							<span class="font-mono text-[10px] font-bold tracking-widest uppercase">{t.criticalStat.status}</span>
						</div>
					</div>
				</div>
				<div class="pointer-events-none absolute -top-12 -right-12 h-64 w-64 rounded-bl-[10rem] bg-white/[0.03] ring-1 ring-white/10 transition-transform duration-700 group-hover:scale-110"></div>
			</article>

			{t.miniStats.map((stat, idx) => (
				<article class="group relative overflow-hidden rounded-[2.5rem] border border-brand-dark/10 bg-white p-8 shadow-sm transition-[transform,box-shadow,border-color] duration-500 hover:scale-[1.02] ui-card-interactive" data-motion="fade" style={`--motion-delay: ${(idx + 1) * 100}ms`}>
					<div class="flex h-full flex-col justify-between">
						<div>
							<Heading tag="h4" variant="feature-heading-md" class="mb-2 transition-colors group-hover:text-brand-primary">{stat.label}</Heading>
							<Text variant="body" class="text-sm text-brand-dark/55">{stat.description}</Text>
						</div>
						<div class="flex items-baseline gap-2">
							<span class="text-3xl font-black tracking-tighter text-brand-primary transition-colors">{stat.value}</span>
							<Text variant="accent-label" class="whitespace-nowrap text-brand-dark/40">{stat.footerLabel}</Text>
						</div>
					</div>
				</article>
			))}
		</div>

		<div class="mt-12 text-center" data-motion="fade">
			<Text variant="disclaimer" class="text-brand-dark/45">{t.footnote}</Text>
		</div>
	</Container>
</Section>

<style>
	.mystek-blueprint-grid {
		background-image:
			linear-gradient(to right, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px);
		background-size: 4rem 4rem;
	}
</style>
