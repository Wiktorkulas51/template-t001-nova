---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import defaultData from "@data/sections/mystek-outsourcing-obligation.json";
type Item = { title: string; description: string; icon?: string };
type Copy = { eyebrow: string; title: string; description?: string; items?: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }
const { data, locale = "pl", sectionId = "mystek-outsourcing-obligation", class: className = "" } = Astro.props as Props;
const t = ((data ?? (defaultData as Data))[locale] ?? (data ?? (defaultData as Data)).pl) as Copy;
const iconName = (name?: string) => name?.replace(/^ph-/, "") || "check-circle";
---
<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}>
  <Container>
    <div class="mb-12 max-w-3xl md:mb-16">
      <Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text>
      <Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>
      {t.description && <Text variant="lead" class="mt-5 max-w-2xl text-brand-dark/65">{t.description}</Text>}
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {(t.items ?? []).map((item, index) => (
        <article class:list={["rounded-2xl border border-brand-dark/10 bg-white p-6 shadow-soft", index === 0 ? "lg:row-span-2 lg:flex lg:flex-col lg:justify-between lg:bg-brand-dark lg:text-white" : ""]}>
          <div>
            <div class="mb-7 flex items-center justify-between">
              <span class:list={["flex size-10 items-center justify-center rounded-xl", index === 0 ? "bg-white/10 text-brand-primary" : "bg-brand-primary/10 text-brand-primary"]}><Icon name={iconName(item.icon)} class="text-xl" /></span>
              <Text variant="accent-label" class={index === 0 ? "text-white/50" : "text-brand-dark/35"}>0{index + 1}</Text>
            </div>
            <Heading tag="h3" variant="feature-title" class={index === 0 ? "text-white" : "text-brand-dark"}>{item.title}</Heading>
            <Text variant="body" class={index === 0 ? "mt-3 text-white/70" : "mt-3 text-brand-dark/65"}>{item.description}</Text>
          </div>
          {index === 0 && <div class="mt-10 border-t border-white/15 pt-5"><Text variant="accent-label" class="text-white/55">ODPOWIEDZIALNOŚĆ IOD</Text></div>}
        </article>
      ))}
    </div>
  </Container>
</Section>
