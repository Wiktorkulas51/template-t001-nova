---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";

export interface Props {
  data?: { image: { src: string; alt: string }; pl: Record<string, string>; en?: Record<string, string> };
  image?: { src: string; alt: string };
  pl?: Record<string, string>;
  en?: Record<string, string>;
  locale?: "pl" | "en";
  sectionId?: string;
  class?: string;
}

const { data, image, pl, en, locale = "pl", sectionId, class: className = "" } = Astro.props as Props;
const source = data ?? (image && pl ? { image, pl, en } : undefined);
if (!source) throw new Error("MystekBoutiqueHeroBlock wymaga danych image i pl.");
const t = (source[locale] ?? source.pl) as Record<string, string>;
---

<Section id={sectionId} tone="base" class:list={["relative overflow-hidden py-12 md:py-24", className]}>
  <Container>
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="relative order-2 flex justify-center lg:order-1 lg:col-span-5 lg:justify-start">
        <div class="group relative w-full max-w-[320px] lg:max-w-sm">
          <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-white shadow-soft transition-transform duration-700 group-hover:scale-[1.01]"><img src={source.image.src} alt={source.image.alt} width="800" height="1000" class="absolute inset-0 h-full w-full object-cover" /></div>
        </div>
      </div>
      <div class="order-1 space-y-6 text-center lg:order-2 lg:col-span-7 lg:pl-4 lg:text-left">
        <div class="space-y-4">
          <Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text>
          <Heading tag="h1" variant="hero" class="text-brand-dark">{t.title}</Heading>
          <Text variant="lead" class="max-w-xl text-brand-dark/70">{t.subtitle} {t.detail}</Text>
        </div>
        <a href={t.ctaHref} class="inline-flex items-center gap-2 rounded-xl bg-brand-primary px-8 py-4 font-semibold text-white shadow-soft transition-[background-color,transform,box-shadow] hover:-translate-y-0.5 hover:bg-brand-primary/90">{t.ctaLabel}<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a>
      </div>
    </div>
  </Container>
</Section>
