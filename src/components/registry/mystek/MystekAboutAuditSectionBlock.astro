---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/mystek-audit-about.json";

type Copy = {
	title: string;
	lead: string;
	description: string;
	callout: string;
	imageAlt: string;
	image?: { src: string; alt: string };
	sectionCode: string;
	legalTitle: string;
	diagnosticsTitle: string;
	signature: string;
	role: string;
	items: { title: string; description: string }[];
};

interface Props {
	data?: { pl: Copy; en?: Copy };
	pl?: Copy;
	en?: Copy;
	locale?: "pl" | "en";
	class?: string;
}

const { data, pl, en, locale = "pl", class: className = "" } = Astro.props as Props;
const source = data ?? (pl ? { pl, en } : (jsonData as { pl: Copy; en?: Copy }));
const t = source[locale] ?? source.pl;
---

<Section
	tone="page"
	class:list={[
		"group/section relative overflow-hidden bg-slate-50",
		className,
	]}
>
	<!-- The static technical mesh retains the character of the original without flickering.-->
	<div class="pointer-events-none absolute inset-0 -z-10">
		<!-- Grid -->
		<div class="mystek-blueprint-grid absolute inset-0 opacity-60"></div>

		<!-- Horizontal CAD Lines -->
		<div
			class="absolute top-1/4 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-slate-300 to-transparent opacity-20"
		>
		</div>
		<div
			class="absolute bottom-1/4 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-slate-300 to-transparent opacity-20"
		>
		</div>
		<!-- Vertical CAD Lines -->
		<div
			class="absolute top-0 left-1/3 h-full w-[1px] bg-gradient-to-b from-transparent via-slate-300 to-transparent opacity-20"
		>
		</div>
		<div
			class="absolute top-0 right-[15%] h-full w-[1px] bg-gradient-to-b from-transparent via-slate-300 to-transparent opacity-20"
		>
		</div>
		<!-- Crosshairs -->
		<div
			class="absolute top-1/4 left-1/3 h-4 w-4 -translate-x-1/2 -translate-y-1/2 border border-slate-300 opacity-20"
		>
		</div>
		<div
			class="absolute right-[15%] bottom-1/4 h-4 w-4 -translate-x-1/2 -translate-y-1/2 border border-slate-300 opacity-20"
		>
		</div>
	</div>

	<Container class="relative z-10">
		<div
			class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12 lg:gap-24"
		>
			<!-- Left Column (Text Content) -->
			<div class="relative order-2 lg:order-1 lg:col-span-6">
				<div class="space-y-16">
					<!-- Header Section -->
					<div data-motion="fade">
						<div class="mb-6 flex items-center gap-4">
							<span
								class="rounded border border-brand-primary/20 bg-brand-primary/10 px-2 py-1 font-mono text-[10px] tracking-widest text-brand-primary"
								>{t.sectionCode}</span
							>
							<div
								class="h-[1px] flex-1 bg-gradient-to-r from-brand-primary/30 to-transparent"
							>
							</div>
						</div>
						<Heading tag="h2" variant="section-heading-xl" class="mb-6">
							{t.title}
						</Heading>
					<Text variant="lead" class="text-brand-dark/65">
							{t.lead}
						</Text>
					</div>

					<!-- Data Points Section -->
						<div
							class="relative space-y-16 overflow-visible border-l border-slate-200 pl-8 md:pl-16"
						>
						<!-- A subtle accent on the data axis replaces the animated scan.-->
						<div
							class="pointer-events-none absolute top-0 left-[-1px] h-full w-[2px] bg-gradient-to-b from-transparent via-brand-primary/50 to-transparent"
						>
						</div>

						<!-- Data Point 1 -->
						<div
							class="relative"
							data-motion="fade"
							style="--motion-delay: 200ms;"
						>
							{
								/* Dot - Precisely centered on the 1px border-l (0px position) */
							}
							<div
								class="absolute top-1.5 -left-[38.5px] z-10 h-3 w-3 border border-brand-primary/40 bg-white md:-left-[70.5px]"
							>
								<div class="absolute inset-1 bg-brand-primary/60"></div>
							</div>

							<Heading
								tag="h3"
								variant="feature-title"
								class="mb-4 flex items-center gap-3 font-sans tracking-[0.2em] text-slate-500 uppercase"
							>
								<span>{t.legalTitle}</span>
								<span class="h-[1px] w-12 bg-slate-200"></span>
							</Heading>
							<Text
								variant="body"
								class="leading-relaxed text-brand-dark/65"
							>
								{t.items[0]?.description}
							</Text>
						</div>

						<!-- Data Point 2 -->
						<div
							class="relative"
							data-motion="fade"
							style="--motion-delay: 400ms;"
						>
							{
								/* Dot - Precisely centered on the 1px border-l (0px position) */
							}
							<div
								class="absolute top-1.5 -left-[38.5px] z-10 h-3 w-3 border border-brand-primary/40 bg-white md:-left-[70.5px]"
							>
								<div class="absolute inset-1 bg-brand-primary/60"></div>
							</div>

							<Heading
								tag="h3"
								variant="feature-title"
								class="mb-4 flex items-center gap-3 font-sans tracking-[0.2em] text-slate-500 uppercase"
							>
								<span>{t.diagnosticsTitle}</span>
								<span class="h-[1px] w-12 bg-slate-200"></span>
							</Heading>
							<Text
								variant="body"
								class="leading-relaxed text-brand-dark/65"
							>
								{t.items[1]?.description}
							</Text>
						</div>
					</div>
				</div>
			</div>

			<!-- Right Column on Desktop (Visual) -->
			<div
				class="relative order-1 lg:order-2 lg:col-span-6"
				data-motion="fade"
				style="--motion-delay: 300ms;"
			>
				<!-- Visual Wrapper -->
				<div
				class="group/visual relative mx-auto w-full max-w-[500px] lg:max-w-full"
				>
					<!-- Image Component -->
									<div class="relative overflow-hidden rounded-3xl border border-brand-dark/10 bg-white shadow-soft">
										<img src={t.image?.src ?? "/assets/placeholders/image-portrait.svg"} alt={t.image?.alt ?? t.imageAlt} width="900" height="1100" loading="lazy" class="relative z-10 aspect-[4/5] w-full object-cover grayscale-[0.2] transition-transform duration-700 group-hover/visual:scale-105" />
										<div class="pointer-events-none absolute inset-x-0 top-0 z-20 h-1/4 bg-gradient-to-b from-brand-primary/10 to-transparent opacity-0 transition-opacity group-hover/visual:opacity-100"></div>
									</div>

					<!-- Expert Insight Card (Blueprint Technical Node) -->
					<div
						class="absolute -bottom-8 left-1/2 z-30 w-[calc(100%-3rem)] max-w-[280px] -translate-x-1/2 rounded-xl border border-slate-200/50 bg-white/80 p-4 shadow-xl shadow-slate-900/10 backdrop-blur-xl transition-[transform,box-shadow] duration-700 group-hover/visual:-translate-y-2 md:-bottom-10 md:-left-12 md:max-w-[260px] md:translate-x-0 md:p-5"
					>
						<!-- Technical Blueprint Corner Marks -->
						<div
						class="pointer-events-none absolute -top-1 -left-1 h-2 w-2 border-t border-l border-brand-primary/60"
						>
						</div>
						<div
						class="pointer-events-none absolute -right-1 -bottom-1 h-2 w-2 border-r border-b border-brand-primary/60"
						>
						</div>

						<div class="relative z-10">
							<blockquote
								class="mb-2 text-center md:mb-3 md:text-left"
							>
								<Text
									tag="p"
									variant="body"
									class="!text-[11px] !font-bold !italic text-brand-dark md:!text-sm"
								>
									„{t.callout}”
								</Text>
							</blockquote>

							<div
								class="flex flex-col items-center border-t border-slate-200/40 pt-2 md:items-start md:pt-3"
							>
								<cite
									class="text-brand-dark block text-[9px] font-black tracking-tight uppercase not-italic"
								>
									{t.signature}
								</cite>
								<div class="mt-0.5 flex items-center gap-2">
									<span class="h-[1px] w-2 bg-brand-primary/40"
									></span>
									<span
										class="block text-[7px] font-bold tracking-[0.15em] text-brand-primary/80 uppercase md:text-[8px]"
									>
																													{t.role}
									</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</Container>
</Section>

<style>
	.mystek-blueprint-grid {
		background-image:
			linear-gradient(to right, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px);
		background-size: 4rem 4rem;
	}
</style>
