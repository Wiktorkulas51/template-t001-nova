---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import jsonData from "@data/sections/mystek-outsourcing-benefits.json";

type Item = { title: string; description: string; icon: string };
type Copy = { eyebrow: string; title: string; titleAccent: string; description: string; items: Item[] };
interface Props { data?: { pl: Copy; en?: Copy }; pl?: Copy; en?: Copy; locale?: "pl" | "en"; class?: string }

const { data, pl, en, locale = "pl", class: className = "" } = Astro.props as Props;
const source = data ?? (pl ? { pl, en } : (jsonData as { pl: Copy; en?: Copy }));
const t = source[locale] ?? source.pl;
---

<Section tone="base" class:list={["relative overflow-hidden", className]}>
	<div class="mystek-blueprint-grid pointer-events-none absolute inset-0 opacity-30"></div>
	<div class="pointer-events-none absolute top-0 left-1/3 h-full w-px bg-brand-dark/10 opacity-30"></div><div class="pointer-events-none absolute top-0 left-2/3 h-full w-px bg-brand-dark/10 opacity-30"></div>
	<Container class="relative z-10">
		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
			<div class="group relative flex flex-col justify-center overflow-hidden rounded-[2rem] border border-brand-dark/10 bg-brand-dark/[0.03] p-10 shadow-soft backdrop-blur-xl md:col-span-2 lg:p-14" data-motion="fade">
				<div class="pointer-events-none absolute -top-20 -right-20 size-80 rounded-full bg-brand-primary/10 blur-3xl transition-transform duration-700 group-hover:scale-110"></div>
				<div class="relative z-10"><Text variant="accent-label" class="mb-6 text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-xl" class="mb-6">{t.title}<br /><span class="ui-text-gradient">{t.titleAccent}</span></Heading><Text variant="lead" class="max-w-xl text-brand-dark/65">{t.description}</Text></div>
			</div>

			{t.items.map((item, index) => (
				<article class="group flex flex-col justify-between ui-card-interactive rounded-[2rem] border border-brand-dark/10 bg-white p-8 shadow-soft" data-motion="fade" style={`--motion-delay: ${(index + 1) * 100}ms`}>
					<div><div class="mb-7 flex size-12 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary transition-[background-color,color] duration-300 group-hover:bg-brand-primary group-hover:text-white"><Icon name={item.icon} size="1.3rem" /></div><Heading tag="h3" variant="feature-heading-md" class="mb-4">{item.title}</Heading><Text variant="body" class="text-brand-dark/65">{item.description}</Text></div>
				</article>
			))}
		</div>
	</Container>
</Section>

<style>
	.mystek-blueprint-grid { background-image: linear-gradient(to right, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px); background-size: 4rem 4rem; }
</style>
