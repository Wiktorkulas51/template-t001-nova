---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/about-bento-page.json";
type Data = { profileTitle: string; experienceTitle: string; certsTitle: string; pubsTitle: string; bio: string[]; certs: string[]; pubs: string[]; experience: string[]; image: { src: string; alt: string } };
export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string }
const { data, locale = "pl", sectionId = "about-bento", class: className = "" } = Astro.props as Props;
const t = ((data ?? jsonData)[locale] ?? (data ?? jsonData).pl) as Data;
---

<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}>
  <Container>
    <div class="grid auto-rows-[minmax(200px,auto)] grid-cols-1 gap-6 md:grid-cols-12">
      <article class="flex flex-col justify-center rounded-3xl border border-brand-dark/10 bg-brand-primary/[0.03] p-8 md:col-span-8 md:row-span-2 md:p-12">
        <Heading tag="h2" variant="section-heading-lg" class="mb-6 text-brand-dark">{t.profileTitle}</Heading>
        <div class="mb-8 space-y-4">{t.bio.map((paragraph) => <Text variant="lead" class="text-brand-dark/70">{paragraph}</Text>)}</div>
        <div><Text variant="accent-label" class="mb-4 text-brand-primary/70">{t.experienceTitle}</Text><ul class="flex flex-wrap gap-3">{t.experience.map((item) => <li class="rounded-lg border border-brand-dark/10 bg-white px-4 py-2 font-medium text-brand-dark shadow-sm">{item}</li>)}</ul></div>
      </article>
      <div class="group relative overflow-hidden rounded-3xl border border-brand-dark/10 bg-brand-dark/5 shadow-soft md:col-span-4 md:row-span-2"><img src={t.image.src} alt={t.image.alt} width="800" height="1000" class="h-full min-h-[24rem] w-full object-cover object-center transition-transform duration-1000 group-hover:scale-110" /></div>
      <article class="rounded-3xl border border-brand-dark/10 bg-white p-8 shadow-soft md:col-span-6"><div class="mb-6 flex items-center gap-3"><span class="flex size-10 items-center justify-center rounded-xl bg-brand-primary/5 text-brand-primary" aria-hidden="true"><svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span><Heading tag="h3" variant="feature-heading-md" class="text-brand-dark">{t.certsTitle}</Heading></div><ul class="grid grid-cols-1 gap-3">{t.certs.map((item) => <li class="flex items-center gap-3 text-brand-dark/70"><span class="h-px w-5 bg-brand-primary" aria-hidden="true"></span><span>{item}</span></li>)}</ul></article>
      <article class="rounded-3xl border border-brand-dark/10 bg-white p-8 shadow-soft md:col-span-6"><div class="mb-6 flex items-center gap-3"><span class="flex size-10 items-center justify-center rounded-xl bg-brand-primary/5 text-brand-primary" aria-hidden="true"><svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg></span><Heading tag="h3" variant="feature-heading-md" class="text-brand-dark">{t.pubsTitle}</Heading></div><ul class="space-y-3">{t.pubs.slice(0, 3).map((item) => <li class="border-l-2 border-brand-dark/10 pl-4 text-sm italic text-brand-dark/65 transition-[border-color] hover:border-brand-primary">{item}</li>)}</ul></article>
    </div>
  </Container>
</Section>
