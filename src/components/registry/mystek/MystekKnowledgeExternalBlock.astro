---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import defaultData from "@data/sections/mystek-knowledge-external.json";
type Item = { title: string; description: string };
type Copy = { eyebrow: string; title: string; description?: string; items?: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }
const { data, locale = "pl", sectionId = "mystek-knowledge-external", class: className = "" } = Astro.props as Props;
const t = ((data ?? (defaultData as Data))[locale] ?? (data ?? (defaultData as Data)).pl) as Copy;
---
<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}>
  <Container>
    <header class="mb-12 max-w-3xl md:mb-16"><Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>{t.description && <Text variant="lead" class="mt-5 text-brand-dark/65">{t.description}</Text>}</header>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{(t.items ?? []).map((item, index) => (<article class="group relative flex min-h-64 flex-col overflow-hidden ui-card-interactive rounded-2xl border border-brand-dark/10 bg-white p-7 shadow-soft"><div class="absolute -right-10 -top-10 size-28 rounded-full bg-brand-primary/5 transition-[transform] duration-500 group-hover:scale-150"></div><div class="relative mb-8 flex items-center justify-between"><Text variant="accent-label" class="rounded-full border border-brand-primary/15 bg-brand-primary/5 px-3 py-1 text-brand-primary">ŹRÓDŁO 0{index + 1}</Text><span class="text-xl text-brand-dark/40 transition-[transform,color] duration-300 group-hover:translate-x-1 group-hover:text-brand-primary">↗</span></div><Heading tag="h3" variant="feature-title" class="relative text-brand-dark">{item.title}</Heading><Text variant="body" class="relative mt-3 flex-1 text-brand-dark/65">{item.description}</Text><div class="relative mt-8 flex items-center gap-3 text-sm font-bold text-brand-primary"><span>↗</span><span class="h-px flex-1 bg-brand-primary/20"></span></div></article>))}</div>
  </Container>
</Section>
