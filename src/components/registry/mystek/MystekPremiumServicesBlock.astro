---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import defaultData from "@data/sections/mystek-premium-services.json";
type Item = { title: string; description: string; icon?: string };
type Copy = { eyebrow: string; title: string; description?: string; items?: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }
const { data, locale = "pl", sectionId = "mystek-premium-services", class: className = "" } = Astro.props as Props;
const t = ((data ?? (defaultData as Data))[locale] ?? (data ?? (defaultData as Data)).pl) as Copy;
const iconName = (name?: string) => name?.replace(/^ph-/, "") || "briefcase";
---
<Section id={sectionId} tone="page" class:list={["relative overflow-hidden", className]}><Container><header class="mx-auto mb-12 max-w-3xl text-center md:mb-16"><Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>{t.description && <Text variant="lead" class="mx-auto mt-5 max-w-2xl text-brand-dark/65">{t.description}</Text>}</header><div class="grid gap-6 md:grid-cols-2">{(t.items ?? []).map((item, index) => <article class="group rounded-[1.75rem] border border-brand-dark/10 bg-white p-7 shadow-soft md:p-9"><div class="mb-10 flex items-center justify-between"><span class="flex size-12 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary"><Icon name={iconName(item.icon)} class="text-2xl" /></span><Text variant="accent-label" class="text-brand-primary/60">0{index + 1}</Text></div><Heading tag="h3" variant="section-heading-lg" class="text-brand-dark">{item.title}</Heading><Text variant="body" class="mt-4 max-w-lg text-brand-dark/65">{item.description}</Text><div class="mt-8 h-px w-16 bg-brand-primary transition-[width] duration-300 group-hover:w-full"></div></article>)}</div></Container></Section>
