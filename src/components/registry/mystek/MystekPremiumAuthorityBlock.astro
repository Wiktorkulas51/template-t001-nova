---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import defaultData from "@data/sections/mystek-premium-authority.json";

type Item = { title: string; description: string; icon?: string };
type Copy = { eyebrow: string; title: string; description?: string; items?: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }
const { data, locale = "pl", sectionId = "mystek-premium-authority", class: className = "" } = Astro.props as Props;
const t = ((data ?? (defaultData as Data))[locale] ?? (data ?? (defaultData as Data)).pl) as Copy;
const items = t.items ?? [];
const iconName = (name?: string) => name?.replace(/^ph-/, "") || "shield-check";
---

<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}>
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <div class="relative overflow-hidden rounded-[2rem] border border-brand-dark/10 bg-brand-dark p-8 text-white shadow-soft md:p-12">
          <div class="absolute -right-16 -top-16 size-48 rounded-full border border-white/10"></div>
          <div class="absolute bottom-8 right-8 size-3 rounded-full bg-brand-primary"></div>
          <Text variant="accent-label" class="text-white/60">{t.eyebrow}</Text>
          <Heading tag="h2" variant="section-heading-xl" class="mt-6 max-w-md text-white">{t.title}</Heading>
          {t.description && <Text variant="lead" class="mt-6 text-white/70">{t.description}</Text>}
          <div class="mt-10 flex items-center gap-3 border-t border-white/15 pt-5">
            <span class="size-2 rounded-full bg-brand-primary"></span>
            <Text variant="accent-label" class="text-white/60">{t.eyebrow}</Text>
          </div>
        </div>
      </div>
      <div class="lg:col-span-7">
        <div class="grid gap-4 sm:grid-cols-2">
          {items.map((item, index) => (
            <article class:list={["rounded-2xl border border-brand-dark/10 bg-white p-6 shadow-soft", index === 0 ? "sm:col-span-2" : ""]}>
              <div class="mb-5 flex items-center justify-between">
                <span class="flex size-10 items-center justify-center rounded-xl bg-brand-primary/10 text-brand-primary"><Icon name={iconName(item.icon)} class="text-xl" /></span>
                <Text variant="accent-label" class="text-brand-primary/60">0{index + 1}</Text>
              </div>
              <Heading tag="h3" variant="feature-title" class="text-brand-dark">{item.title}</Heading>
              <Text variant="body" class="mt-3 text-brand-dark/65">{item.description}</Text>
            </article>
          ))}
        </div>
      </div>
    </div>
  </Container>
</Section>
