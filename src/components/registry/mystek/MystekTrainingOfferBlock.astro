---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import defaultData from "@data/sections/mystek-training-offer.json";

type TrainingItem = {
  id: string;
  title: string;
  price: number;
  duration: string;
  format: string;
};

type TrainingGroup = {
  id: string;
  label: string;
  title: string;
  description: string;
  packageLabel: string;
  packagePrice: number;
  items: TrainingItem[];
};

type StandardItem = { title: string; description: string };

type Copy = {
  eyebrow: string;
  title: string;
  description: string;
  selectionHint: string;
  detailsLabel: string;
  selectLabel: string;
  selectedLabel: string;
  clearLabel: string;
  summaryTitle: string;
  summaryDescription: string;
  howToTitle: string;
  howToDescription: string;
  standardTitle: string;
  standardItems: StandardItem[];
  quoteInfoTitle: string;
  quoteInfoDescription: string;
  pricePrefix: string;
  emptySelection: string;
  totalLabel: string;
  currencyLabel: string;
  orderLabel: string;
  orderHref: string;
  disclaimer: string;
  groups: TrainingGroup[];
};

type Data = { pl: Copy; en?: Copy };

export interface Props {
  data?: Data;
  locale?: "pl" | "en";
  sectionId?: string;
  class?: string;
}

const { data, locale = "pl", sectionId = "mystek-training-offer", class: className = "" } = Astro.props as Props;
const source = (data ?? defaultData) as Data;
const t = source[locale] ?? source.pl;
---

<Section id={sectionId} tone="page" class:list={["relative overflow-hidden", className]}>
  <Container>
    <header class="mx-auto mb-12 max-w-3xl text-center md:mb-16">
      <Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text>
      <Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>
      <Text variant="lead" class="mx-auto mt-5 max-w-2xl text-brand-dark/65">{t.description}</Text>
    </header>

    <div class="mx-auto max-w-6xl" data-training-configurator data-training-price-prefix={t.pricePrefix}>
      <div class="mb-8 border-y border-brand-dark/10 py-4" role="tablist" aria-label={t.selectionHint}>
        <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
          {t.groups.map((group, index) => (
            <button
              type="button"
              class="flex min-h-16 flex-col items-start justify-center rounded-xl border px-4 py-3 text-left transition-[background-color,border-color,color] duration-300"
              class:list={index === 0 ? ["border-brand-primary bg-brand-primary text-white"] : ["border-brand-dark/10 bg-white text-brand-dark hover:border-brand-primary/40"]}
              id={`training-tab-${group.id}`}
              role="tab"
              aria-controls={`training-panel-${group.id}`}
              aria-selected={index === 0}
              data-training-tab={group.id}
            >
              <Text variant="accent-label" class="opacity-70">{group.label}</Text>
              <span class="mt-1 text-sm font-semibold">{group.title}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
        <div>
          {t.groups.map((group, index) => (
            <section id={`training-panel-${group.id}`} role="tabpanel" aria-labelledby={`training-tab-${group.id}`} data-training-panel={group.id} hidden={index !== 0}>
              <header class="mb-8 max-w-2xl">
                <Text variant="accent-label" class="text-brand-primary">{group.label}</Text>
                <Heading tag="h3" variant="section-heading-lg" class="mt-3 text-brand-dark">{group.title}</Heading>
                <Text variant="body" class="mt-3 text-brand-dark/65">{group.description}</Text>
              </header>

              <div class="grid gap-4 md:grid-cols-2">
                {group.items.map((item) => (
                  <button
                    type="button"
                    class="group flex h-full flex-col rounded-2xl border border-brand-dark/10 bg-white p-6 text-left shadow-soft ui-card-interactive"
                    data-training-item
                    data-training-id={item.id}
                    data-training-title={item.title}
                    data-training-price={item.price}
                    aria-pressed="false"
                  >
                    <span class="flex items-start justify-between gap-4">
                      <Heading tag="h4" variant="feature-title" class="text-brand-dark">{item.title}</Heading>
                      <span class="shrink-0 text-right text-sm font-bold text-brand-primary">{t.pricePrefix} {item.price} <span class="block text-[10px] uppercase tracking-[0.16em] text-brand-dark/45">{t.currencyLabel}</span></span>
                    </span>
                    <span class="mt-7 flex flex-wrap gap-x-5 gap-y-2 border-t border-brand-dark/10 pt-4 text-xs font-semibold uppercase tracking-[0.12em] text-brand-dark/55">
                      <span>{item.duration}</span>
                      <span>{item.format}</span>
                    </span>
                    <span class="mt-5 flex items-center justify-between gap-4 text-sm font-semibold text-brand-primary"><span>{t.detailsLabel}</span><span>{t.selectLabel}</span></span>
                  </button>
                ))}
              </div>

              <button
                type="button"
                class="mt-4 flex w-full items-center justify-between rounded-2xl border border-brand-primary/25 bg-brand-primary/5 p-5 text-left transition-[background-color,border-color] duration-300 hover:border-brand-primary hover:bg-brand-primary/10"
                data-training-item
                data-training-id={`${group.id}-package`}
                data-training-title={group.packageLabel}
                data-training-price={group.packagePrice}
                aria-pressed="false"
              >
                <span>
                  <span class="block text-xs font-bold uppercase tracking-[0.16em] text-brand-primary">{group.packageLabel}</span>
                  <span class="mt-2 block text-sm text-brand-dark/65">{t.selectLabel}</span>
                </span>
                  <span class="text-right text-lg font-bold text-brand-primary">{t.pricePrefix} {group.packagePrice} <span class="block text-[10px] uppercase tracking-[0.16em] text-brand-dark/45">{t.currencyLabel}</span></span>
              </button>
            </section>
          ))}
        </div>

        <aside class="rounded-2xl border border-brand-dark/10 bg-brand-dark p-6 text-white lg:sticky lg:top-24" data-training-summary>
          <Text variant="accent-label" class="text-brand-primary">{t.selectedLabel}</Text>
          <Heading tag="h3" variant="feature-title" class="mt-3 text-white">{t.summaryTitle}</Heading>
          <Text variant="body" class="mt-2 text-white/65">{t.summaryDescription}</Text>
          <div class="mt-6 border-t border-white/15 pt-5">
            <Text variant="accent-label" class="text-white/60">{t.howToTitle}</Text>
            <Text variant="body" class="mt-2 text-white/65">{t.howToDescription}</Text>
          </div>
          <div class="mt-6 border-t border-white/15 pt-5">
            <Text variant="accent-label" class="text-white/60">{t.standardTitle}</Text>
            <ul class="mt-3 space-y-3">
              {t.standardItems.map((item) => (
                <li>
                  <strong class="block text-sm text-white">{item.title}</strong>
                  <span class="mt-1 block text-sm text-white/60">{item.description}</span>
                </li>
              ))}
            </ul>
          </div>
          <p class="mt-6 text-sm text-white/65" data-training-empty>{t.emptySelection}</p>
          <ul class="mt-6 space-y-3 border-t border-white/15 pt-5" data-training-selected hidden></ul>
          <div class="mt-6 flex items-end justify-between border-t border-white/15 pt-5">
            <Text variant="accent-label" class="text-white/60">{t.totalLabel}</Text>
            <span class="text-2xl font-bold text-brand-primary"><span data-training-total>0</span> <span class="text-xs uppercase tracking-[0.16em] text-white/55">{t.currencyLabel}</span></span>
          </div>
          <div class="mt-6 grid gap-3">
            <Button href={t.orderHref} variant="accent" full hoverText={t.orderLabel}>{t.orderLabel}</Button>
            <Button variant="ghost" full data-training-clear>{t.clearLabel}</Button>
          </div>
        </aside>
      </div>

      <aside class="mt-10 rounded-2xl border border-brand-primary/20 bg-brand-primary/5 p-6 md:p-8">
        <Heading tag="h3" variant="feature-title" class="text-brand-dark">{t.quoteInfoTitle}</Heading>
        <Text variant="body" class="mt-3 max-w-4xl text-brand-dark/65">{t.quoteInfoDescription}</Text>
      </aside>

      <Text variant="body" class="mx-auto mt-10 max-w-3xl text-center text-sm text-brand-dark/55">{t.disclaimer}</Text>
    </div>
  </Container>
</Section>

<script is:inline data-astro-rerun src="/js/mystek-training-configurator.js"></script>
