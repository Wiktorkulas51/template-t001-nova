---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import jsonData from "@data/sections/mystek-audit-process.json";

type Item = { number: string; title: string; description: string };
type Copy = { eyebrow: string; title: string; titleAccent: string; description: string; ctaText: string; ctaHref: string; timeLabel: string; items: Item[] };
interface Props { data?: { pl: Copy; en?: Copy }; pl?: Copy; en?: Copy; locale?: "pl" | "en"; class?: string }

const { data, pl, en, locale = "pl", class: className = "" } = Astro.props as Props;
const source = data ?? (pl ? { pl, en } : (jsonData as { pl: Copy; en?: Copy }));
const t = source[locale] ?? source.pl;
---

<Section tone="base" class:list={["group/section relative bg-white", className]}>
	<div class="mystek-blueprint-grid pointer-events-none absolute inset-0 opacity-30"></div>
	<div class="pointer-events-none absolute top-0 left-1/4 h-full w-px bg-gradient-to-b from-transparent via-brand-dark/10 to-transparent md:left-1/3"></div>
	<div class="pointer-events-none absolute top-0 right-1/4 h-full w-px bg-gradient-to-b from-transparent via-brand-dark/10 to-transparent"></div>

	<Container class="relative z-10">
		<div class="grid grid-cols-1 items-start gap-16 lg:grid-cols-12 lg:gap-24">
			<div class="h-fit lg:sticky lg:top-40 lg:col-span-5" data-motion="fade">
				<Text variant="accent-label" class="mb-6 text-brand-primary">{t.eyebrow}</Text>
				<Heading tag="h2" variant="section-heading-xl" class="mb-8">
					{t.title}<br />
					<span class="ui-text-gradient">{t.titleAccent}</span>
				</Heading>
				<Text variant="lead" class="mb-12 max-w-sm text-brand-dark/65">{t.description}</Text>
				<div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
					<a href={t.ctaHref} class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand-primary px-6 py-3 text-sm font-bold text-white transition-[background-color,transform] duration-300 hover:-translate-y-0.5 hover:bg-brand-primary/90 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/40">{t.ctaText}</a>
					<div class="flex items-center gap-3 text-brand-dark/55"><div class="flex size-10 items-center justify-center rounded-full bg-brand-primary/10 text-brand-primary"><Icon name="clock" size="1.15rem" /></div><span class="text-sm font-bold tracking-tight">{t.timeLabel}</span></div>
				</div>
			</div>

			<div class="relative lg:col-span-7">
				<div class="absolute top-0 bottom-0 left-0 w-px bg-brand-dark/10 lg:-left-12"><div class="absolute top-0 left-0 h-1/3 w-full bg-brand-primary/70"></div><div class="absolute top-0 left-[-4px] h-px w-2 bg-brand-dark/30"></div><div class="absolute bottom-0 left-[-4px] h-px w-2 bg-brand-dark/30"></div></div>
				<div class="space-y-16 lg:space-y-24">
					{t.items.map((item, index) => (
						<article class="relative pl-10 lg:pl-0" data-motion="fade" style={`--motion-delay: ${index * 150}ms`}>
							<div class="absolute top-0 left-[-0.45rem] flex size-9 items-center justify-center rounded-xl border border-brand-primary/30 bg-brand-light text-xs font-bold text-brand-primary lg:-left-[4.05rem]">{item.number}</div>
							<Text variant="accent-label" class="mb-3 text-brand-primary/65">KROK {item.number}</Text>
							<Heading tag="h3" variant="feature-heading-md" class="mb-4">{item.title}</Heading>
							<Text variant="body" class="max-w-xl text-brand-dark/65">{item.description}</Text>
						</article>
					))}
				</div>
			</div>
		</div>
	</Container>
</Section>

<style>
	.mystek-blueprint-grid {
		background-image:
			linear-gradient(to right, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in oklab, var(--color-brand-dark) 6%, transparent) 1px, transparent 1px);
		background-size: 4rem 4rem;
	}
</style>
