---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
export interface Props {
  data?: { pl: Record<string, string>; en?: Record<string, string> };
  pl?: Record<string, string>;
  en?: Record<string, string>;
  locale?: "pl" | "en";
  sectionId?: string;
  class?: string;
}

const { data, pl, en, locale = "pl", sectionId = "offer-contact-cta", class: className = "" } = Astro.props as Props;
const source = data ?? (pl ? { pl, en } : undefined);
if (!source) throw new Error("OfferContactCtaMystekBlock wymaga danych pl.");
const t = (source[locale] ?? source.pl) as Record<string, string>;
---
<Section id={sectionId} tone="base" class:list={["pb-24 md:pb-32", className]}>
  <Container>
    <div class="group relative overflow-hidden rounded-2xl bg-brand-primary px-6 py-10 text-center text-white shadow-soft md:p-14">
      <div class="relative z-10"><Heading tag="h2" variant="section-heading-xl" class="mb-4 text-white">{t.title}</Heading><Text variant="lead" class="mx-auto mb-8 max-w-2xl text-white/80">{t.description}</Text><div class="flex flex-col items-stretch justify-center gap-4 sm:flex-row sm:items-center"><a href={t.ctaHref} class="inline-flex w-full items-center justify-center rounded-xl bg-white px-8 py-4 font-bold text-brand-primary shadow-soft transition-[background-color,transform,box-shadow] hover:-translate-y-0.5 hover:bg-white/90 sm:w-auto">{t.ctaLabel}</a><a href={t.secondaryHref} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center rounded-xl border border-white/40 px-8 py-4 font-bold text-white transition-[background-color,color] hover:bg-white hover:text-brand-primary sm:w-auto">{t.secondaryLabel}</a></div></div>
      <div class="pointer-events-none absolute top-0 right-0 size-48 rounded-bl-[8rem] bg-white/5 transition-transform duration-1000 group-hover:scale-110" aria-hidden="true"></div><div class="pointer-events-none absolute bottom-0 left-0 size-32 rounded-tr-[6rem] bg-white/5 transition-transform duration-1000 group-hover:scale-110" aria-hidden="true"></div><div class="pointer-events-none absolute -top-24 -left-24 size-96 rounded-[8rem] bg-white/5 opacity-0 blur-[100px] transition-opacity duration-1000 group-hover:opacity-100" aria-hidden="true"></div>
    </div>
  </Container>
</Section>
