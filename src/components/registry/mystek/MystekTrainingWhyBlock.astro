---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import defaultData from "@data/sections/mystek-training-why.json";

type Item = { title: string; description: string; icon?: string };
type Copy = { eyebrow: string; title: string; description: string; panelTitle: string; panelDescription: string; items: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }

const { data, locale = "pl", sectionId = "mystek-training-why", class: className = "" } = Astro.props as Props;
const source = (data ?? defaultData) as Data;
const t = source[locale] ?? source.pl;
const iconName = (name?: string) => name?.replace(/^ph-/, "") || "shield-check";
---

<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}>
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6">
        <Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text>
        <Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>
        <Text variant="lead" class="mt-5 max-w-xl text-brand-dark/65">{t.description}</Text>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {t.items.map((item) => (
            <article class="rounded-2xl border border-brand-dark/10 bg-white p-6 shadow-soft">
              <span class="flex size-11 items-center justify-center rounded-xl bg-brand-primary/10 text-brand-primary"><Icon name={iconName(item.icon)} class="text-xl" /></span>
              <Heading tag="h3" variant="feature-title" class="mt-6 text-brand-dark">{item.title}</Heading>
              <Text variant="body" class="mt-3 text-brand-dark/65">{item.description}</Text>
            </article>
          ))}
        </div>
      </div>

      <aside class="relative overflow-hidden rounded-[2rem] bg-brand-dark p-8 text-white shadow-soft md:p-12 lg:col-span-6">
        <div class="pointer-events-none absolute inset-8 border border-white/15"></div>
        <div class="pointer-events-none absolute inset-x-16 top-1/2 h-px bg-brand-primary/60"></div>
        <div class="pointer-events-none absolute inset-y-16 left-1/2 w-px bg-brand-primary/40"></div>
        <div class="relative z-10 flex min-h-[20rem] flex-col justify-end">
          <Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text>
          <Heading tag="h3" variant="section-heading-lg" class="mt-3 max-w-sm text-white">{t.panelTitle}</Heading>
          <Text variant="body" class="mt-4 max-w-md text-white/70">{t.panelDescription}</Text>
        </div>
      </aside>
    </div>
  </Container>
</Section>
