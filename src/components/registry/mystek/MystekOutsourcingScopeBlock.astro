---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import defaultData from "@data/sections/mystek-outsourcing-scope.json";

type Item = { title: string; description: string; icon?: string };
type Copy = { eyebrow: string; title: string; description: string; items: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }

const { data, locale = "pl", sectionId = "mystek-outsourcing-scope", class: className = "" } = Astro.props as Props;
const source = (data ?? defaultData) as Data;
const t = source[locale] ?? source.pl;
const iconName = (name?: string) => name?.replace(/^ph-/, "") || "shield-check";
---

<Section id={sectionId} tone="page" class:list={["relative overflow-hidden", className]}>
  <Container>
    <header class="mx-auto mb-12 max-w-3xl text-center md:mb-16">
      <Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text>
      <Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>
      <Text variant="lead" class="mx-auto mt-5 max-w-2xl text-brand-dark/65">{t.description}</Text>
    </header>

    <div class="grid gap-5 md:grid-cols-2">
      {t.items.map((item, index) => (
        <article class="group ui-card-interactive rounded-2xl border border-brand-dark/10 bg-white p-7 shadow-soft md:p-9">
          <div class="flex items-start justify-between gap-5">
            <span class="flex size-12 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary"><Icon name={iconName(item.icon)} class="text-xl" /></span>
            <Text variant="accent-label" class="text-brand-primary/60">{String(index + 1).padStart(2, "0")}</Text>
          </div>
          <Heading tag="h3" variant="feature-title" class="mt-8 text-brand-dark">{item.title}</Heading>
          <Text variant="body" class="mt-3 text-brand-dark/65">{item.description}</Text>
        </article>
      ))}
    </div>
  </Container>
</Section>
