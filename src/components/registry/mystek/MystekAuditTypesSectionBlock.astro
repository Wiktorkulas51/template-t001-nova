---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/mystek-audit-types.json";

type Mode = {
	 title: string;
	 badge: string;
	 description: string;
	 items: string[];
	 accent: "primary" | "secondary";
};

type Copy = {
	 eyebrow: string;
	 title: string;
	 titleAccent: string;
	 ctaTitle: string;
	 ctaText: string;
	 ctaHref: string;
	 modes: Mode[];
};

interface Props {
	data?: { pl: Copy; en?: Copy };
	pl?: Copy;
	en?: Copy;
	locale?: "pl" | "en";
	class?: string;
}

const { data, pl, en, locale = "pl", class: className = "" } = Astro.props as Props;
const source = data ?? (pl ? { pl, en } : (jsonData as { pl: Copy; en?: Copy }));
const t = source[locale] ?? source.pl;
---

<Section tone="page" class:list={["relative overflow-hidden", className]}>
	<div class="pointer-events-none absolute top-0 left-1/2 block h-0 w-px -translate-x-1/2 bg-brand-dark/10 opacity-40 lg:h-full"></div>
	<div class="pointer-events-none absolute top-1/2 left-0 h-px w-full bg-brand-dark/10 opacity-40"></div>

	<Container class="relative z-10">
		<div class="mx-auto mb-16 max-w-4xl text-center lg:mb-24" data-motion="fade">
			<Text variant="accent-label" class="mx-auto mb-4 text-brand-primary">{t.eyebrow}</Text>
			<Heading tag="h2" variant="section-heading-xl">
				{t.title}<br />
				<span class="ui-text-gradient">{t.titleAccent}</span>
			</Heading>
		</div>

		<div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
			{t.modes.map((mode, idx) => (
				<div class="group relative" data-motion="fade" style={`--motion-delay: ${idx * 150}ms`}>
					<div class:list={[
						"absolute -top-4 -left-4 z-20 flex h-12 w-12 items-center justify-center rounded-xl border bg-white text-xs font-black text-slate-400 transition-[transform,box-shadow,border-color,color] duration-500 group-hover:-translate-y-1 group-hover:shadow-xl",
						mode.accent === "primary" ? "border-brand-primary/20 group-hover:border-brand-primary group-hover:text-brand-primary" : "border-brand-dark/15 group-hover:border-brand-dark group-hover:text-brand-dark",
					]}>
						{String(idx + 1).padStart(2, "0")}
					</div>

					<div class="relative flex h-full flex-col overflow-hidden ui-card-interactive rounded-[3rem] border border-brand-dark/10 bg-white p-10 shadow-soft lg:p-14">
						<div class:list={["pointer-events-none absolute top-0 right-0 h-48 w-48 translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl", mode.accent === "primary" ? "bg-brand-primary/10" : "bg-brand-dark/5"]}></div>
						<div class="relative z-10 flex h-full flex-col">
							<span class:list={["mb-6 inline-flex w-fit rounded-full px-4 py-1.5 text-[10px] font-black tracking-widest uppercase", mode.accent === "primary" ? "bg-brand-primary/10 text-brand-primary" : "bg-brand-dark/10 text-brand-dark"]}>{mode.badge}</span>
							<Heading tag="h3" variant="section-heading-lg" class="mb-6">{mode.title}</Heading>
							<Text variant="lead" class="mb-10 text-brand-dark/65">{mode.description}</Text>
							<div class="mt-auto space-y-4">
								<Text variant="accent-label" class="mb-4 text-brand-dark/45">{t.eyebrow}</Text>
								{mode.items.map((item) => (
									<div class="group/item flex items-start gap-4">
										<div class:list={["mt-1.5 h-2 w-2 shrink-0 border opacity-60 transition-opacity group-hover/item:opacity-100", mode.accent === "primary" ? "border-brand-primary bg-brand-primary/30" : "border-brand-dark bg-brand-dark/20"]}></div>
										<Text tag="span" variant="body" class="font-bold text-brand-dark/65 transition-colors group-hover/item:text-brand-primary">{item}</Text>
									</div>
								))}
							</div>
						</div>
					</div>
				</div>
			))}
		</div>

		<div class="mx-auto mt-16 max-w-2xl text-center lg:mt-24" data-motion="fade">
			<Heading tag="h3" variant="section-title" class="mb-6">{t.ctaTitle}</Heading>
			<a href={t.ctaHref} class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand-primary px-6 py-3 text-sm font-bold text-white transition-[background-color,transform] duration-300 hover:-translate-y-0.5 hover:bg-brand-primary/90">{t.ctaText}</a>
		</div>
	</Container>
</Section>
