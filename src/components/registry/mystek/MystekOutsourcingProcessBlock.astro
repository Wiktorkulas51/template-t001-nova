---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import defaultData from "@data/sections/mystek-outsourcing-process.json";

type Item = { title: string; description: string };
type Copy = { eyebrow: string; title: string; description: string; ctaLabel: string; ctaHref: string; stepLabel: string; items: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }

const { data, locale = "pl", sectionId = "mystek-outsourcing-process", class: className = "" } = Astro.props as Props;
const source = (data ?? defaultData) as Data;
const t = source[locale] ?? source.pl;
---

<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}>
  <Container>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:sticky lg:top-24 lg:col-span-5 lg:self-start">
        <Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text>
        <Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>
        <Text variant="lead" class="mt-5 max-w-md text-brand-dark/65">{t.description}</Text>
        <Button href={t.ctaHref} variant="primary" class="mt-8" hoverText={t.ctaLabel}>{t.ctaLabel}</Button>
      </div>

      <ol class="relative space-y-6 lg:col-span-7">
        <div class="absolute bottom-5 left-5 top-5 w-px bg-brand-primary/20" aria-hidden="true"></div>
        {t.items.map((item, index) => (
          <li class="relative grid gap-5 sm:grid-cols-[3rem_1fr] sm:gap-7">
            <div class="relative z-10 flex size-10 items-center justify-center rounded-xl border border-brand-primary/30 bg-brand-light font-mono text-sm font-bold text-brand-primary">{String(index + 1).padStart(2, "0")}</div>
            <article class="rounded-2xl border border-brand-dark/10 bg-white p-6 shadow-soft md:p-8">
              <Text variant="accent-label" class="text-brand-primary/60">{t.stepLabel} {String(index + 1).padStart(2, "0")}</Text>
              <Heading tag="h3" variant="feature-title" class="mt-3 text-brand-dark">{item.title}</Heading>
              <Text variant="body" class="mt-3 text-brand-dark/65">{item.description}</Text>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</Section>
