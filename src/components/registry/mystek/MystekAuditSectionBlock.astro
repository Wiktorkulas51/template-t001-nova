---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import defaultData from "@data/sections/mystek-audit-about.json";

type Card = {
  title: string;
  description: string;
  icon?: string;
  items?: string[];
  value?: string;
  label?: string;
};

type SectionCopy = {
  layout: "aboutAudit" | "split" | "cards" | "scope" | "risk" | "timeline" | "report" | "benefits" | "pricing" | "reviews" | "faq" | "cta";
  eyebrow: string;
  title: string;
  description?: string;
  lead?: string;
  image?: { src: string; alt: string };
  callout?: string;
  signature?: string;
  role?: string;
  items?: Card[];
  cta?: { label: string; href: string };
};

type Data = { pl: SectionCopy; en?: SectionCopy };

export interface Props {
  data?: Data;
  pl?: SectionCopy;
  en?: SectionCopy;
  locale?: "pl" | "en";
  sectionId?: string;
  class?: string;
}

const {
  data,
  pl,
  en,
  locale = "pl",
  sectionId = "mystek-audit-section",
  class: className = "",
} = Astro.props as Props;

const source = data ?? (pl ? { pl, en } : (defaultData as Data));
const t = (source[locale] ?? source.pl) as SectionCopy;
const items = t.items ?? [];
const cardClass = "min-w-0 rounded-3xl border border-brand-dark/10 bg-white p-6 shadow-soft md:p-8";
const iconName = (name?: string) => name?.replace(/^ph-/, "") || "shield-check";
---

<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}>
  <Container>
    <div class="mb-12 max-w-3xl md:mb-16">
      <Text variant="accent-label" class="mb-4 text-brand-primary">{t.eyebrow}</Text>
      <Heading tag="h2" variant="section-heading-xl" class="text-brand-dark">{t.title}</Heading>
      {t.description && <Text variant="lead" class="mt-5 max-w-2xl text-brand-dark/70">{t.description}</Text>}
    </div>

    {t.layout === "aboutAudit" && (
      <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12 lg:gap-24">
        <div class="order-2 lg:order-1 lg:col-span-6">
          <div class="space-y-16">
            <div>
              <div class="mb-6 flex items-center gap-4">
                <span class="rounded border border-brand-primary/20 bg-brand-primary/10 px-2 py-1 font-mono text-[10px] tracking-widest text-brand-primary">SEC_01</span>
                <div class="h-px flex-1 bg-brand-primary/25"></div>
              </div>
              <Heading tag="h2" variant="section-heading-xl" class="text-brand-dark">{t.title}</Heading>
              {t.lead && <Text variant="lead" class="mt-6 text-brand-dark/65">{t.lead}</Text>}
            </div>
            <div class="relative space-y-12 border-l border-brand-dark/15 pl-8 md:pl-16">
              {items.slice(0, 2).map((item, index) => (
                <div class="relative">
                  <span class="absolute top-1.5 -left-[2.45rem] size-3 border-2 border-brand-primary bg-brand-light md:-left-[4.45rem]" aria-hidden="true"></span>
                  <Heading tag="h3" variant="feature-title" class="mb-4 uppercase tracking-[0.14em] text-brand-dark/60">{item.title}</Heading>
                  <Text variant="body" class="text-brand-dark/65">{item.description}</Text>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="order-1 lg:order-2 lg:col-span-6">
          <div class="group relative mx-auto max-w-xl">
            {t.image && <img src={t.image.src} alt={t.image.alt} width="900" height="1100" loading="lazy" class="aspect-[4/5] w-full object-cover shadow-soft transition-transform duration-700 group-hover:scale-[1.02]" />}
            {t.callout && (
              <aside class="absolute -bottom-8 left-1/2 z-10 w-[calc(100%-2rem)] max-w-xs -translate-x-1/2 border border-brand-dark/10 bg-white/90 p-5 shadow-xl backdrop-blur-md md:-left-10 md:translate-x-0">
                <span class="pointer-events-none absolute -top-1 -left-1 h-3 w-3 border-t border-l border-brand-primary"></span>
                <span class="pointer-events-none absolute -right-1 -bottom-1 h-3 w-3 border-r border-b border-brand-primary"></span>
                <Text variant="feature-body-sm" class="font-semibold italic text-brand-dark">„{t.callout}”</Text>
                {t.signature && <Text variant="accent-label" class="mt-4 border-t border-brand-dark/10 pt-3 text-brand-dark">{t.signature}</Text>}
                {t.role && <Text variant="accent-label" class="mt-1 text-brand-primary/70">{t.role}</Text>}
              </aside>
            )}
          </div>
        </div>
      </div>
    )}

    {t.layout === "split" && (
      <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
        <article class:list={[cardClass, "bg-brand-primary text-white"]}>
          <Text variant="accent-label" class="mb-5 text-white/70">{t.eyebrow}</Text>
          <Heading tag="h3" variant="section-heading-lg" class="text-white">{items[0]?.title}</Heading>
          <Text variant="lead" class="mt-5 text-white/80">{items[0]?.description}</Text>
        </article>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
          {items.slice(1).map((item) => (
            <article class={cardClass}>
              <div class="mb-4 flex size-11 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary">
                <Icon name={iconName(item.icon)} class="text-xl" />
              </div>
              <Heading tag="h3" variant="feature-title" class="text-brand-dark">{item.title}</Heading>
              <Text variant="body" class="mt-3 text-brand-dark/70">{item.description}</Text>
            </article>
          ))}
        </div>
      </div>
    )}

    {t.layout === "cards" && (
      <div class="grid gap-6 md:grid-cols-2">
        {items.map((item, index) => (
          <article class={cardClass}>
            <div class="mb-5 flex items-start justify-between gap-4">
              <div class="flex size-11 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary">
                <Icon name={iconName(item.icon)} class="text-xl" />
              </div>
              <Text variant="accent-label" class="text-brand-primary/60">0{index + 1}</Text>
            </div>
            <Heading tag="h3" variant="feature-title" class="text-brand-dark">{item.title}</Heading>
            <Text variant="body" class="mt-3 text-brand-dark/70">{item.description}</Text>
            {item.items && <ul class="mt-5 space-y-2">{item.items.map((entry) => <li class="border-l-2 border-brand-primary/30 pl-3 text-sm text-brand-dark/70">{entry}</li>)}</ul>}
          </article>
        ))}
      </div>
    )}

    {t.layout === "scope" && (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {items.map((item, index) => (
          <article class:list={[cardClass, "min-h-52"]}>
            <Text variant="accent-label" class="mb-5 text-brand-primary/60">OBSZAR 0{index + 1}</Text>
            <Heading tag="h3" variant="feature-title" class="text-brand-dark">{item.title}</Heading>
            <Text variant="body" class="mt-3 text-brand-dark/70">{item.description}</Text>
          </article>
        ))}
      </div>
    )}

    {t.layout === "risk" && (
      <div class="grid gap-6 md:grid-cols-12">
        {items.map((item, index) => (
          <article class:list={[cardClass, index === 0 ? "md:col-span-7 bg-brand-primary text-white" : "md:col-span-5"]}>
            {item.value && <Heading tag="p" variant="section-heading-xl" class={index === 0 ? "text-white" : "text-brand-primary"}>{item.value}</Heading>}
            <Heading tag="h3" variant="feature-title" class={index === 0 ? "mt-4 text-white" : "mt-4 text-brand-dark"}>{item.title}</Heading>
            <Text variant="body" class={index === 0 ? "mt-3 text-white/80" : "mt-3 text-brand-dark/70"}>{item.description}</Text>
          </article>
        ))}
      </div>
    )}

    {t.layout === "timeline" && (
      <ol class="relative ml-2 max-w-4xl space-y-8 border-l border-brand-primary/20 pl-8 md:ml-6 md:space-y-10">
        {items.map((item, index) => (
          <li class="relative">
            <span class="absolute -left-[2.55rem] top-0 flex size-9 items-center justify-center rounded-xl border border-brand-primary/20 bg-brand-light text-sm font-bold text-brand-primary">{index + 1}</span>
            <Heading tag="h3" variant="feature-title" class="text-brand-dark">{item.title}</Heading>
            <Text variant="body" class="mt-2 max-w-2xl text-brand-dark/70">{item.description}</Text>
          </li>
        ))}
      </ol>
    )}

    {t.layout === "report" && (
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <article class:list={[cardClass, "bg-brand-dark text-white"]}>
          <Text variant="accent-label" class="mb-5 text-white/60">{t.eyebrow}</Text>
          <Heading tag="h3" variant="section-heading-lg" class="text-white">{t.title}</Heading>
          <Text variant="body" class="mt-5 text-white/75">{t.description}</Text>
        </article>
        <div class="grid gap-4 sm:grid-cols-2">
          {items.map((item, index) => (
            <article class={cardClass}>
              <Text variant="accent-label" class="mb-4 text-brand-primary/60">0{index + 1}</Text>
              <Heading tag="h3" variant="feature-title" class="text-brand-dark">{item.title}</Heading>
              <Text variant="feature-body-sm" class="mt-3 text-brand-dark/65">{item.description}</Text>
            </article>
          ))}
        </div>
      </div>
    )}

    {t.layout === "benefits" && (
      <div class="grid gap-6 lg:grid-cols-2">
        {items.map((item) => (
          <article class:list={[cardClass, "border-brand-primary/15"]}>
            <div class="mb-5 flex size-11 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary"><Icon name={iconName(item.icon)} class="text-xl" /></div>
            <Heading tag="h3" variant="feature-title" class="text-brand-dark">{item.title}</Heading>
            <Text variant="body" class="mt-3 text-brand-dark/70">{item.description}</Text>
          </article>
        ))}
      </div>
    )}

    {t.layout === "pricing" && (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {items.map((item) => (
          <article class={cardClass}>
            <div class="mb-5 flex size-11 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary"><Icon name={iconName(item.icon)} class="text-xl" /></div>
            <Heading tag="h3" variant="feature-title" class="text-brand-dark">{item.title}</Heading>
            <Text variant="feature-body-sm" class="mt-3 text-brand-dark/65">{item.description}</Text>
          </article>
        ))}
      </div>
    )}

    {t.layout === "reviews" && (
      <div class="grid gap-6 md:grid-cols-3">
        {items.map((item) => (
          <article class={cardClass}>
            <Text variant="lead" class="text-brand-dark/80">“{item.description}”</Text>
            <Text variant="accent-label" class="mt-6 text-brand-primary">{item.label ?? item.title}</Text>
          </article>
        ))}
      </div>
    )}

    {t.layout === "faq" && (
      <div class="mx-auto max-w-4xl space-y-3" data-accordion>
        {items.map((item) => (
          <details class="group rounded-2xl border border-brand-dark/10 bg-white px-6 py-5">
            <summary class="cursor-pointer list-none pr-8 font-heading text-lg font-bold text-brand-dark marker:hidden">{item.title}</summary>
            <Text variant="body" class="mt-4 text-brand-dark/70">{item.description}</Text>
          </details>
        ))}
      </div>
    )}

    {t.layout === "cta" && (
      <article class="relative overflow-hidden rounded-3xl bg-brand-primary px-6 py-10 text-center text-white md:px-12 md:py-16">
        <div class="relative z-10 mx-auto max-w-2xl">
          <Heading tag="h3" variant="section-heading-lg" class="text-white">{t.title}</Heading>
          {t.description && <Text variant="lead" class="mt-5 text-white/80">{t.description}</Text>}
          {t.cta && <a href={t.cta.href} class="mt-8 inline-flex min-h-11 items-center rounded-xl bg-white px-6 py-3 font-bold text-brand-primary transition-[transform,background-color] hover:-translate-y-0.5 hover:bg-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">{t.cta.label}</a>}
        </div>
      </article>
    )}
  </Container>
</Section>
