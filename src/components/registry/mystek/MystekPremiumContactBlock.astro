---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import defaultData from "@data/sections/mystek-premium-contact.json";
type Copy = { eyebrow: string; title: string; description?: string; cta?: { label: string; href: string } };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }
const { data, locale = "pl", sectionId = "mystek-premium-contact", class: className = "" } = Astro.props as Props;
const t = ((data ?? (defaultData as Data))[locale] ?? (data ?? (defaultData as Data)).pl) as Copy;
---
<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}><Container><div class="grid items-center gap-10 overflow-hidden rounded-[2rem] bg-brand-dark p-8 text-white md:p-12 lg:grid-cols-[0.9fr_1.1fr] lg:p-16"><div><Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-xl" class="mt-5 text-white">{t.title}</Heading>{t.description && <Text variant="lead" class="mt-5 text-white/70">{t.description}</Text>}<div class="mt-8 h-px w-24 bg-brand-primary"></div></div><div class="rounded-2xl border border-white/15 bg-white/5 p-6 backdrop-blur-sm md:p-8"><Text variant="accent-label" class="text-white/55">{t.eyebrow}</Text><div class="mt-6 space-y-4"><div class="h-3 rounded-full bg-white/10"></div><div class="h-3 w-4/5 rounded-full bg-white/10"></div><div class="h-3 w-3/5 rounded-full bg-white/10"></div></div>{t.cta && <a href={t.cta.href} class="mt-8 inline-flex min-h-11 items-center rounded-xl bg-white px-5 py-3 text-sm font-bold text-brand-dark transition-[transform,background-color] hover:-translate-y-0.5 hover:bg-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">{t.cta.label}</a>}</div></div></Container></Section>
