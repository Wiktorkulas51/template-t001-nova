---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import defaultData from "@data/sections/mystek-knowledge-search.json";
type Item = { title: string; description: string };
type Copy = { eyebrow: string; title: string; description?: string; items?: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }
const { data, locale = "pl", sectionId = "mystek-knowledge-search", class: className = "" } = Astro.props as Props;
const t = ((data ?? (defaultData as Data))[locale] ?? (data ?? (defaultData as Data)).pl) as Copy;
---
<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}>
  <Container>
    <header class="mb-10 max-w-3xl"><Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>{t.description && <Text variant="lead" class="mt-5 text-brand-dark/65">{t.description}</Text>}</header>
    <div class="mb-8 flex flex-col gap-4 rounded-2xl border border-brand-dark/10 bg-white p-4 shadow-soft sm:flex-row"><label class="sr-only" for={`${sectionId}-search`}>{t.title}</label><input id={`${sectionId}-search`} type="search" placeholder={t.title} class="min-h-11 flex-1 rounded-xl border border-brand-dark/10 bg-brand-light px-4 text-sm text-brand-dark outline-none transition-[border-color,box-shadow] focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20"/><div class="flex flex-wrap gap-2">{(t.items ?? []).map((item, index) => <button type="button" class:list={["rounded-xl border px-3 py-2 text-xs font-bold", index === 0 ? "border-brand-primary bg-brand-primary text-white" : "border-brand-dark/10 bg-white text-brand-dark/65"]}>{item.title}</button>)}</div></div>
    <div class="grid gap-4 md:grid-cols-2">{(t.items ?? []).map((item, index) => <article class="rounded-2xl border border-brand-dark/10 bg-white p-6 shadow-soft"><Text variant="accent-label" class="text-brand-primary/60">TEMAT 0{index + 1}</Text><Heading tag="h3" variant="feature-title" class="mt-4 text-brand-dark">{item.title}</Heading><Text variant="body" class="mt-3 text-brand-dark/65">{item.description}</Text></article>)}</div>
  </Container>
</Section>
