---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import jsonData from "@data/sections/mystek-outsourcing-when.json";

type Item = { title: string; description: string; icon: string };
type Copy = { eyebrow: string; title: string; titleAccent: string; description: string; ctaTitle: string; ctaText: string; ctaHref: string; interventionLabel: string; items: Item[] };
interface Props { data?: { pl: Copy; en?: Copy }; pl?: Copy; en?: Copy; locale?: "pl" | "en"; class?: string }

const { data, pl, en, locale = "pl", class: className = "" } = Astro.props as Props;
const source = data ?? (pl ? { pl, en } : (jsonData as { pl: Copy; en?: Copy }));
const t = source[locale] ?? source.pl;
---

<Section tone="base" class:list={["relative overflow-hidden", className]}>
	<Container class="relative z-10">
		<div class="mx-auto mb-16 max-w-3xl text-center lg:mb-20" data-motion="fade">
			<Text variant="accent-label" class="mb-6 text-brand-primary">{t.eyebrow}</Text>
			<Heading tag="h2" variant="section-heading-xl" class="mb-6">{t.title}<br /><span class="ui-text-gradient">{t.titleAccent}</span></Heading>
			<Text variant="lead" class="mx-auto mt-4 text-brand-dark/65">{t.description}</Text>
		</div>

		<div class="relative grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
			{t.items.map((item, index) => (
				<article class="group relative flex flex-col items-start overflow-hidden ui-card-interactive rounded-[2rem] border border-brand-dark/10 bg-white p-8 shadow-soft lg:p-10" data-motion="fade" style={`--motion-delay: ${index * 90}ms`}>
					<div class="pointer-events-none absolute top-6 right-8 font-black tracking-tighter text-brand-dark/5 transition-colors duration-500 group-hover:text-brand-primary/10">{String(index + 1).padStart(2, "0")}</div>
					<div class="relative z-10 mb-6 flex size-14 items-center justify-center rounded-2xl border border-brand-dark/10 bg-brand-dark/[0.03] text-brand-primary transition-[background-color,color,transform] duration-500 group-hover:scale-105 group-hover:bg-brand-primary group-hover:text-white"><Icon name={item.icon} size="1.35rem" /></div>
					<div class="relative z-10 flex w-full flex-grow flex-col"><Heading tag="h3" variant="feature-heading-md" class="mb-3 pr-8">{item.title}</Heading><Text variant="body" class="flex-grow text-brand-dark/60">{item.description}</Text><div class="mt-8 flex items-center gap-2 border-t border-brand-dark/10 pt-5 text-xs font-bold tracking-wider text-brand-primary uppercase"><span>{t.interventionLabel}</span><span aria-hidden="true">→</span></div></div>
				</article>
			))}
		</div>

		<div class="mx-auto mt-16 max-w-2xl text-center" data-motion="fade"><Heading tag="h3" variant="section-title" class="mb-6">{t.ctaTitle}</Heading><a href={t.ctaHref} class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand-primary px-6 py-3 text-sm font-bold text-white transition-[background-color,transform] duration-300 hover:-translate-y-0.5 hover:bg-brand-primary/90 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/40">{t.ctaText}</a></div>
	</Container>
</Section>
