---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import defaultData from "@data/sections/mystek-outsourcing-cost.json";
type Item = { title: string; description: string; icon?: string };
type Copy = { eyebrow: string; title: string; description?: string; items?: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }
const { data, locale = "pl", sectionId = "mystek-outsourcing-cost", class: className = "" } = Astro.props as Props;
const t = ((data ?? (defaultData as Data))[locale] ?? (data ?? (defaultData as Data)).pl) as Copy;
const iconName = (name?: string) => name?.replace(/^ph-/, "") || "chart-line";
---
<Section id={sectionId} tone="page" class:list={["relative overflow-hidden", className]}><Container><div class="mb-12 flex flex-col justify-between gap-6 lg:flex-row lg:items-end"><div class="max-w-3xl"><Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>{t.description && <Text variant="lead" class="mt-5 text-brand-dark/65">{t.description}</Text>}</div><div class="rounded-2xl border border-brand-primary/15 bg-brand-primary/5 px-5 py-4"><Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text></div></div><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{(t.items ?? []).map((item, index) => <article class="rounded-2xl border border-brand-dark/10 bg-white p-6 shadow-soft"><div class="mb-8 flex items-center justify-between"><span class="flex size-10 items-center justify-center rounded-xl bg-brand-primary/10 text-brand-primary"><Icon name={iconName(item.icon)} class="text-lg" /></span><Text variant="accent-label" class="text-brand-dark/35">0{index + 1}</Text></div><Heading tag="h3" variant="feature-title" class="text-brand-dark">{item.title}</Heading><Text variant="body" class="mt-3 text-brand-dark/65">{item.description}</Text><div class="mt-7 h-1 rounded-full bg-brand-primary/15"><div class="h-full rounded-full bg-brand-primary" style={`width: ${65 + index * 8}%`}></div></div></article>)}</div></Container></Section>
