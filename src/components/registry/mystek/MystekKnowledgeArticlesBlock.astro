---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import defaultData from "@data/sections/mystek-knowledge-articles.json";
type Item = { title: string; description: string };
type Copy = { eyebrow: string; title: string; description?: string; items?: Item[] };
type Data = { pl: Copy; en?: Copy };
export interface Props { data?: Data; locale?: "pl" | "en"; sectionId?: string; class?: string }
const { data, locale = "pl", sectionId = "mystek-knowledge-articles", class: className = "" } = Astro.props as Props;
const t = ((data ?? (defaultData as Data))[locale] ?? (data ?? (defaultData as Data)).pl) as Copy;
---
<Section id={sectionId} tone="base" class:list={["relative overflow-hidden", className]}>
  <Container>
    <header class="mb-12 max-w-3xl md:mb-16"><Text variant="accent-label" class="text-brand-primary">{t.eyebrow}</Text><Heading tag="h2" variant="section-heading-xl" class="mt-4 text-brand-dark">{t.title}</Heading>{t.description && <Text variant="lead" class="mt-5 text-brand-dark/65">{t.description}</Text>}</header>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{(t.items ?? []).map((item, index) => (<article class="group flex min-h-72 flex-col overflow-hidden rounded-2xl border border-brand-dark/10 bg-white shadow-soft"><div class="relative aspect-[16/9] overflow-hidden bg-brand-dark"><div class="absolute inset-5 border border-white/15"></div><div class="absolute bottom-5 left-5 text-white/45"><Text variant="accent-label">0{index + 1}</Text></div></div><div class="flex flex-1 flex-col p-6"><Text variant="accent-label" class="text-brand-primary/60">{t.eyebrow}</Text><Heading tag="h3" variant="feature-title" class="mt-3 text-brand-dark">{item.title}</Heading><Text variant="body" class="mt-3 flex-1 text-brand-dark/65">{item.description}</Text><span class="mt-6 text-sm font-bold text-brand-primary">↗</span></div></article>))}</div>
  </Container>
</Section>
