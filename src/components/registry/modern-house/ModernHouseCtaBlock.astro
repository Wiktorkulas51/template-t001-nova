---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";

type Cta = { label: string; href: string; hoverLabel?: string };

interface Props {
  sectionId?: string;
  eyebrow?: string;
  title?: string;
  accentText?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  cta?: Cta;
}

const {
  sectionId = "cta",
  eyebrow = "",
  title = "",
  accentText = "",
  description = "",
  image = "",
  imageAlt = "",
  cta,
} = Astro.props as Props;

const accentStart = accentText ? title.indexOf(accentText) : -1;
const titleBeforeAccent = accentStart >= 0 ? title.slice(0, accentStart) : title;
const titleAfterAccent = accentStart >= 0 ? title.slice(accentStart + accentText.length) : "";
---

<Section id={sectionId} tone="page" class="mh-cta-section">
  <Container>
    <div class="mh-cta-box relative isolate overflow-hidden ui-radius-xl border border-brand-dark/10 ui-elevation-soft">
      <SmartImage src={image} alt={imageAlt} width={1672} height={941} sizes="(max-width: 768px) 100vw, 1200px" loading="lazy" class="absolute inset-0 -z-20 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-dark/90 via-brand-dark/55 to-brand-dark/15" aria-hidden="true"></div>
      <div class="absolute inset-3 -z-10 ui-radius-xl border border-white/30" aria-hidden="true"></div>

      <div class="relative flex min-h-[22rem] flex-col justify-center px-6 py-14 sm:min-h-[26rem] sm:px-12 sm:py-16 lg:min-h-[30rem] lg:px-16">
        {eyebrow && <Text variant="accent-label" tag="p" class="text-brand-primary">{eyebrow}</Text>}
        <Heading level={2} variant="hero" class="mt-4 max-w-2xl text-[clamp(1.5rem,2.8vw,2.5rem)] leading-[1.1] text-white">
          {accentStart >= 0 ? <>{titleBeforeAccent}<span class="text-brand-primary">{accentText}</span>{titleAfterAccent}</> : title}
        </Heading>
        {description && <Text variant="lead" class="mt-5 max-w-xl text-white/75">{description}</Text>}
        {cta && <div class="mt-8"><Button href={cta.href} variant="primary" size="lg" hoverText={cta.hoverLabel}>{cta.label}</Button></div>}
      </div>
    </div>
  </Container>
</Section>

<style>
  .mh-cta-section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .mh-cta-box {
    aspect-ratio: 3 / 1;
  }

  @media (max-width: 64rem) {
    .mh-cta-box {
      aspect-ratio: auto;
    }
  }
</style>
