---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";

type HeroCta = { label: string; href: string; hoverLabel?: string };
type TrustItem = { icon: string; value: string; label: string };

interface Props {
  sectionId?: string;
  pageHeading?: string;
  title?: string;
  eyebrow?: string;
  accentText?: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
  trustItems?: TrustItem[];
}

const {
  sectionId = "hero",
  pageHeading = "",
  title = "",
  eyebrow = "",
  accentText = "",
  subtitle = "",
  image = "",
  imageAlt = "",
  primaryCta,
  secondaryCta,
  trustItems = [],
} = Astro.props as Props;

const heading = pageHeading || title;
const accentStart = accentText ? heading.indexOf(accentText) : -1;
const headingBeforeAccent = accentStart >= 0 ? heading.slice(0, accentStart) : heading;
const headingAfterAccent = accentStart >= 0 ? heading.slice(accentStart + accentText.length) : "";
---

<Section id={sectionId} class="mh-hero-section relative overflow-hidden rounded-b-4xl bg-brand-dark pb-0 pt-0 text-white" tone="page">
  <div class="mh-hero-media absolute inset-0" aria-hidden="true">
    <SmartImage
      src={image}
      alt={imageAlt}
      width={1672}
      height={941}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
  </div>

  <div class="pointer-events-none absolute inset-y-0 left-0 w-full bg-gradient-to-r from-brand-dark/85 via-brand-dark/40 to-transparent lg:w-[60%]"></div>
  <div class="mh-hero-bottom-mask pointer-events-none absolute bottom-0 left-0 h-[58%] w-full lg:h-[64%] lg:w-[62%]"></div>

  <Container class="relative z-10">
    <div class="mh-hero-shell flex min-h-[clamp(38rem,100svh,56rem)] flex-col justify-end px-0 pb-6 pt-0 sm:pb-8 lg:min-h-[clamp(42rem,90svh,75rem)] lg:max-w-3xl lg:pb-10">
      {eyebrow && <Text variant="accent-label" tag="p" class="mb-5 w-fit border-l-2 border-brand-primary pl-3 text-white/75">{eyebrow}</Text>}

      <Heading level={1} variant="hero" class="max-w-3xl text-[clamp(2rem,4.2vw,3.75rem)] leading-[1.05] text-white">
        {accentStart >= 0 ? (
          <>
            {headingBeforeAccent.split("\n").map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}
            <span class="text-brand-primary">{accentText}</span>
            {headingAfterAccent.split("\n").map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}
          </>
        ) : (
          heading.split("\n").map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)
        )}
      </Heading>

      {subtitle && <Text variant="lead" class="mt-6 max-w-xl text-white/75">{subtitle}</Text>}

      {(primaryCta || secondaryCta) && (
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          {primaryCta && <Button href={primaryCta.href} variant="primary" size="lg" hoverText={primaryCta.hoverLabel}>{primaryCta.label}</Button>}
          {secondaryCta && (
            <a href={secondaryCta.href} class="group inline-flex min-h-12 items-center justify-center gap-2 px-4 text-sm font-semibold text-white transition-colors hover:text-brand-primary focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/50 sm:justify-start">
              {secondaryCta.label}
              <Icon name="arrow-right" class="transition-transform group-hover:translate-x-1" />
            </a>
          )}
        </div>
      )}

      {trustItems.length > 0 && (
        <div class="mt-10 grid max-w-xl grid-cols-3 gap-4 border-t border-white/15 pt-5" data-hero-trust>
          {trustItems.map((item) => (
            <div class="min-w-0">
              <div class="flex items-center gap-2 text-brand-primary">
                <Icon name={item.icon} class="text-base" />
                <Text tag="strong" class="text-lg font-semibold text-white sm:text-xl">{item.value}</Text>
              </div>
              <Text variant="feature-body-sm" class="mt-1 text-white/55">{item.label}</Text>
            </div>
          ))}
        </div>
      )}
    </div>
  </Container>
</Section>

<style>
  .mh-hero-section {
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  .mh-hero-media :global(img) {
    object-position: center;
  }

  .mh-hero-bottom-mask {
    background: radial-gradient(
      ellipse 120% 115% at 0% 100%,
      color-mix(in oklab, var(--color-brand-dark) 88%, transparent) 0%,
      color-mix(in oklab, var(--color-brand-dark) 52%, transparent) 34%,
      color-mix(in oklab, var(--color-brand-dark) 20%, transparent) 58%,
      transparent 84%
    );
  }

  @media (max-width: 40rem) {
    .mh-hero-section :global(.ui-container) {
      padding-inline: 0.75rem;
    }
  }
</style>
