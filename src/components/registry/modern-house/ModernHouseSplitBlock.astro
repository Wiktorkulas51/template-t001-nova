---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";

type Cta = { label: string; href: string; hoverLabel?: string };

interface Props {
  sectionId?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  badgeLabel?: string;
  bullets?: string[];
  cta?: Cta;
  reverse?: boolean;
  tone?: "page" | "base";
}

const {
  sectionId = "split",
  eyebrow = "",
  title = "",
  description = "",
  image = "",
  imageAlt = "",
  badgeLabel = "",
  bullets = [],
  cta,
  reverse = false,
  tone = "base",
} = Astro.props as Props;
---

<Section id={sectionId} tone={tone} class="mh-split-section">
  <Container>
    <div class:list={["grid items-center gap-10 lg:grid-cols-2 lg:gap-20", reverse && "lg:[&>div:first-child]:order-2"]}>
      <div class="relative overflow-hidden ui-radius-xl border border-brand-dark/10 ui-bg-surface ui-elevation-soft">
        <SmartImage src={image} alt={imageAlt} width={1254} height={1254} sizes="(max-width: 768px) 100vw, 560px" class="aspect-square w-full object-cover" />
        {badgeLabel && (
          <div class="absolute bottom-6 left-6 inline-flex items-center gap-2 ui-radius-lg border border-white/25 bg-brand-dark/90 px-4 py-3 text-sm font-semibold text-white shadow-lg backdrop-blur-sm sm:bottom-8 sm:left-8">
            <Icon name="sparkle" class="text-brand-primary" />
            {badgeLabel}
          </div>
        )}
      </div>

      <div class="max-w-xl">
        {eyebrow && <Text variant="accent-label" tag="p">{eyebrow}</Text>}
        <Heading level={2} variant="section-heading-xl" class="mt-3 text-brand-dark">{title}</Heading>
        {description && <Text variant="lead" class="mt-5 text-brand-dark/65">{description}</Text>}

        {bullets.length > 0 && (
          <ul class="mt-7 space-y-3">
            {bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-brand-dark/75 sm:text-base">
                <Icon name="check-circle" class="mt-0.5 shrink-0 text-brand-primary" />
                <Text tag="span" variant="feature-body-sm">{bullet}</Text>
              </li>
            ))}
          </ul>
        )}

        {cta && (
          <div class="mt-8">
            <Button href={cta.href} variant="outline" size="lg" hoverText={cta.hoverLabel}>
              {cta.label}
              <Fragment slot="icon-right"><Icon name="arrow-right" /></Fragment>
            </Button>
          </div>
        )}
      </div>
    </div>
  </Container>
</Section>

<style>
  .mh-split-section {
    padding-block: clamp(4rem, 9vw, 8rem);
  }
</style>
