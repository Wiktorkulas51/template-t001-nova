---
// Why: CtaUpBlock is a reimplementation of the final CTA section
// from the recruitment landing page of the Pomeranian University in Slupsk
// (projekt aleksandra-klisik, index.html linie 454-511 + style.css).
// The layout has been preserved: a banner with cut corners (clip-path) with a wordmark
// in the background, inner frame, text + two buttons and a photo
// person glued to the right edge (absolute). Client signature
// (neon lime, navy, cyan) jest zmapowana na tokeny brand starter-kita:
// banner = brand-primary, tekst = brand-dark, przyciski = atom Button.
// Dot pattern
// removed (DESIGN_RULES: zero dots). Photo (cta-banner.jpg/webp)
// was copied from the client project to public/assets/images/up/.
// The content is PL/EN neutral.
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import jsonData from "@data/sections/cta-up.json";

type Cta = {
  label: string;
  hoverLabel: string;
  href: string;
};

type LocaleData = (typeof jsonData)["pl"] & {
  ctas: Cta[];
};

export interface Props {
  /** Full section details; when missing, the block reads the fallback from the JSON.*/
  data?: LocaleData;
  /** JSON content language: "pl" (default) or "en".*/
  locale?: "pl" | "en";
  /** The section anchor id (default "cta").*/
  id?: string;
  /** Header tag: 'h2' by default.*/
  headingTag?: "h1" | "h2";
  /** Additional classes per section (e.g. with PageBuilder).*/
  class?: string;
}

const { data, locale = "pl", id = "cta", headingTag = "h2", class: className = "" } =
  Astro.props as Props;

// Dlaczego: wzorzec "props.data || jsonData[locale]" (jak w FaqUpBlock),
// so that the block works independently from the section data, and PageBuilder or CMS can
// overwrite content. Fallback to pl protects against bad places.
const t = (data ?? jsonData[locale] ?? jsonData.pl) as LocaleData;
const ctas = t.ctas ?? [];
---

<Section tone="base" class:list={["relative overflow-visible", className]} id={id}>
  <Container class="relative">
    <div class="up-cta-banner relative">
      {/* Dlaczego: wordmark w tle (wielki napis w niskiej alfa navy),
          hidden on mobile, just like the .cta-banner__wordmark from the original.*/}
      <span class="up-cta-wordmark" aria-hidden="true">{t.wordmark}</span>

      <div class="up-cta__content">
        <Heading
          tag={headingTag}
          class="text-[clamp(2rem,5.5vw,3.2rem)] font-extrabold uppercase leading-[0.95] text-brand-dark"
        >
          <span set:html={t.headingHtml} />
        </Heading>
        <Text tag="p" class="up-cta__text text-brand-dark/70">{t.text}</Text>

        <div class="up-cta__actions mt-3 flex w-full flex-wrap gap-4">
          {ctas.map((cta, i) => {
            const isPrimary = i === 0;
            return (
              <Button
                href={cta.href}
                variant={isPrimary ? "primary" : "outline"}
                size="lg"
                class={isPrimary ? "!bg-brand-dark" : undefined}
                hoverText={cta.hoverLabel ?? cta.label}
              >
                {cta.label}
              </Button>
            );
          })}
        </div>
      </div>
    </div>

    {/* Dlaczego: visual pozostaje poza banerem, jak w oryginalnym index.html,
        so it can protrude above the top edge of the frame.*/}
    <div class="up-cta-visual" aria-hidden="true">
      <picture>
        <source srcset="/assets/images/up/cta-banner.webp" type="image/webp" />
        <img
          class="up-cta-person"
          src="/assets/images/up/cta-banner.jpg"
          alt=""
          width="1080"
          height="1280"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
  </Container>
</Section>

<style>
  /* Why: UP signature as own block classes (pattern
     AboutExpertBlock), ale z kolorami na tokenach brand starter-kita.
     Dot pattern from the original removed (DESIGN_RULES: zero dots).*/

  .up-cta-banner {
    --cta-cut: 1.35rem;
    position: relative;
    z-index: 1;
    padding: 2.5rem 1.5rem 2rem;
    background: var(--color-brand-primary);
    clip-path: polygon(var(--cta-cut) 0, calc(100% - var(--cta-cut)) 0, 100% var(--cta-cut), 100% calc(100% - var(--cta-cut)), calc(100% - var(--cta-cut)) 100%, var(--cta-cut) 100%, 0 calc(100% - var(--cta-cut)), 0 var(--cta-cut));
    overflow: visible;
  }

  .up-cta-banner::after {
    /* Why: inner frame (2px inset) with beveled corners
       in brand-light color, like the .cta-banner::after from the original.*/
    position: absolute;
    inset: 2px;
    z-index: 0;
    background: var(--color-brand-light);
    clip-path: polygon(calc(var(--cta-cut) + 2px) 2px, calc(100% - var(--cta-cut) - 2px) 2px, calc(100% - 2px) calc(var(--cta-cut) + 2px), calc(100% - 2px) calc(100% - var(--cta-cut) - 2px), calc(100% - var(--cta-cut) - 2px) calc(100% - 2px), calc(var(--cta-cut) + 2px) calc(100% - 2px), 2px calc(100% - var(--cta-cut) - 2px), 2px calc(var(--cta-cut) + 2px));
    content: "";
  }

  .up-cta-wordmark {
    /* Dlaczego: wielki napis w tle (nazwa klienta w niskiej alfa brand-dark),
       centered, pointer-events none. Hidden on mobile (media query).*/
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: color-mix(in srgb, var(--color-brand-dark) 8%, transparent);
    font-size: clamp(2.8rem, 7.5vw, 6.2rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 0.9;
    white-space: nowrap;
    pointer-events: none;
    z-index: 2;
  }

  .up-cta__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 32rem;
    color: var(--color-brand-dark);
  }

  .up-cta__text {
    margin: 0;
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .up-cta-visual {
    display: block;
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 5;
    pointer-events: none;
  }

  .up-cta-person {
    display: block;
    width: auto;
    height: clamp(20rem, 30vw, 34rem);
    max-width: none;
  }

  /* ---- Responsiveness (exactly like the original) ----*/
  @media (max-width: 767px) {
    .up-cta-wordmark {
      display: none;
    }
    .up-cta-visual {
      /* Why: on mobile the photo is slightly blurred/darkened under the text
         (the original showed them in the background), we leave them as decoration.*/
      opacity: 0.25;
      bottom: 0;
      right: -2rem;
    }
  }

  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .up-cta-banner {
      padding: 3rem 2.5rem 2.75rem 2.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .up-cta-wordmark {
      display: none;
    }
    .up-cta__content {
      align-items: center;
      text-align: center;
      max-width: 40rem;
    }
    .up-cta__actions {
      justify-content: center;
    }
  }

  @media (min-width: 64rem) {
    .up-cta-banner {
      padding: 3rem 22rem 2.75rem 2.5rem;
    }
    .up-cta-person {
      height: clamp(28rem, 36vw, 40rem);
    }
  }
</style>
