---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import data from "@data/sections/cta-spectrum.json";

// Why: texts are in props (SSOT) with fallback to JSON
// (src/data/sections/cta-spectrum.json). JSON keeps en/pl content as at the source
// (HeinrichCtaBlockV5 from filip-halucha), and PL is the main language.
export interface Props {
  sectionId?: string;
  /** Content language with JSON. PL is the main language (default).*/
  lang?: "pl" | "en";
  title?: string;
  description?: string;
  cta?: { label: string; href: string };
  /** Section header tag: 'h2' by default, 'h1' when the block is the first section of a page without hero (SEO).*/
  headingTag?: string;
}

const {
  sectionId = "cta-spectrum",
  lang = "pl",
  title,
  description,
  cta,
  headingTag = "h2",
} = Astro.props as Props;

const t = data[lang] ?? data.pl;

const resolvedTitle = title || t.title;
const resolvedDescription = description || t.description;
const primaryCta = cta || t.cta;

// Why: bar heights are random as in the source (HeinrichCtaBlockV5).
// In a static build, this is done once, so each build produces a different "graph".
// Every second bar remains on mobile - fewer elements = shallower DOM tree
// and cheaper animation on weaker devices.
const barHeights = Array.from({ length: 100 }, () => Math.floor(Math.random() * 80) + 10);
const mobileBars = barHeights.filter((_, i) => i % 2 === 0);
---

<Section id={sectionId} tone="page" class="relative overflow-hidden py-24 sm:py-32">
  <!-- Spectrum as absolute background: vertical stripes with ui-spectrum-pulse animation.
       The mask (intersect vertical and horizontal) makes the stripes disappear at the edges
       i w rogach (kopia z HeinrichCtaBlockV5). pointer-events-none, bo to dekoracja. -->
  <div
    class="pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden"
    aria-hidden="true"
    style="mask-image: linear-gradient(to bottom, transparent 10%, black 35%, black 65%, transparent 90%), linear-gradient(to right, black 8%, transparent 38%, transparent 62%, black 92%); mask-composite: intersect; -webkit-mask-image: linear-gradient(to bottom, transparent 10%, black 35%, black 65%, transparent 90%), linear-gradient(to right, black 8%, transparent 38%, transparent 62%, black 92%); -webkit-mask-composite: source-in;"
  >
    <!-- Why: desktop gets 100 bars (hidden sm:flex), mobile gets half
         (flex sm:hidden). Animation/delay height and time go inline style -
         each bar pulsates at a different rhythm, which creates an "equalizer" effect.-->
    <div class="hidden w-full items-center justify-center gap-[2px] px-4 sm:flex" style="height: 60%;">
      {barHeights.map((h, i) => (
        <div
          class="ui-spectrum-bar flex-1"
          style={`height: ${h}%; animation: ui-spectrum-pulse ${1.0 + (i % 5) * 0.3}s ease-in-out infinite; animation-delay: ${i * 0.03}s;`}
        ></div>
      ))}
    </div>
    <div class="flex w-full items-center justify-center gap-[2px] px-4 sm:hidden" style="height: 60%;">
      {mobileBars.map((h, i) => (
        <div
          class="ui-spectrum-bar flex-1"
          style={`height: ${h}%; animation: ui-spectrum-pulse ${1.0 + (i % 5) * 0.3}s ease-in-out infinite; animation-delay: ${i * 0.06}s;`}
        ></div>
      ))}
    </div>
  </div>

  <!-- Siatka kropek (jasny wariant, kopia z HeinrichCtaBlockV5).
       Klasa ui-console-grid jest w core.css. -->
  <div class="absolute inset-0 ui-console-grid opacity-20" aria-hidden="true"></div>

  <Container class="relative z-10">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <!-- Why: set:html allows <br /> and bolding of part of the title
           (wzorzec SectionHeading z heinrich: h2 font-light z szerokim tracking).
           The tailwind classes override font-bold from the Heading atom.-->
      <Heading
        tag={headingTag}
        variant="section-title"
        class="text-3xl font-light tracking-[0.08em] text-neutral-900 sm:text-4xl"
        set:html={resolvedTitle}
      />
      <Text
        variant="body"
        class="mx-auto mt-6 max-w-xl text-sm leading-relaxed text-neutral-500"
        set:html={resolvedDescription}
      />
      <div class="mt-10">
        <!-- Dlaczego: przycisk na jasnym tle zostaje brandowy (ui-button-primary),
             and the right arrow (icon-right slot) suggests a navigation action.
             Wzorzec CTA z HeinrichCtaBlockV5. -->
        <Button href={primaryCta.href} variant="primary" size="lg" class="min-h-11">
          {primaryCta.label}
          <Icon slot="icon-right" name="arrow-right" class="text-base" />
        </Button>
      </div>
    </div>
  </Container>
</Section>

<!-- Dlaczego: hover na sekcji przyciemnia paski (subtelna interakcja jak
     at the source). Scoped style: .ui-spectrum-bar gets the scoped attribute,
     and #cta-spectrum (id from props) matches the parent section.-->
<style>
  #cta-spectrum:hover .ui-spectrum-bar {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.07), rgba(0, 0, 0, 0.2));
  }
</style>
