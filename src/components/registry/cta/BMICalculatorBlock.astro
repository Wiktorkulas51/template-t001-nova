---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import jsonData from "@data/sections/bmi-calculator.json";

export interface Props { data?: typeof jsonData; locale?: "pl" | "en"; sectionId?: string; class?: string; }
const { data: overrideData, sectionId = "kalkulator-bmi", class: className = "" } = Astro.props as Props;
const t = overrideData ?? jsonData;
---
<Section id={sectionId} tone="page" class={className}>
  <Container>
    <div class="mx-auto mb-10 max-w-3xl text-center md:mb-14">
      <Text variant="accent-label" class="mb-4 text-brand-primary">{t.eyebrow}</Text>
      <Heading tag="h2" variant="section-heading-lg" class="text-brand-dark">{t.title} <span class="italic text-brand-primary">{t.titleAccent}</span></Heading>
      <Text variant="lead" class="mx-auto mt-4 max-w-2xl text-brand-dark/65">{t.description}</Text>
    </div>

    <div
      data-bmi-calculator
      data-bmi-under-label={t.categories.under.label}
      data-bmi-under-tip={t.categories.under.tip}
      data-bmi-healthy-label={t.categories.healthy.label}
      data-bmi-healthy-tip={t.categories.healthy.tip}
      data-bmi-over-label={t.categories.over.label}
      data-bmi-over-tip={t.categories.over.tip}
      data-bmi-obesity-label={t.categories.obesity.label}
      data-bmi-obesity-tip={t.categories.obesity.tip}
      class="ui-card mx-auto max-w-5xl p-4 shadow-[var(--ui-elevation-strong)] sm:p-6 md:p-8"
    >
      <div class="grid items-start gap-5 md:grid-cols-2 md:gap-10">
        <div class="space-y-6 sm:space-y-8">
          <div class="flex gap-1 rounded-full border border-brand-primary/10 bg-brand-primary/5 p-1.5" role="group" aria-label={t.gender.label}>
            <button type="button" data-bmi-gender="female" class="min-h-11 flex-1 rounded-full bg-brand-primary px-3 text-xs font-bold uppercase tracking-[0.14em] text-white transition-colors" aria-pressed="true">{t.gender.female}</button>
            <button type="button" data-bmi-gender="male" class="min-h-11 flex-1 rounded-full px-3 text-xs font-bold uppercase tracking-[0.14em] text-brand-dark/55 transition-colors" aria-pressed="false">{t.gender.male}</button>
          </div>

          <div class="space-y-6">
            <label class="block space-y-2">
              <span class="flex items-center justify-between gap-4"><span class="ui-type-accent-label text-brand-dark">{t.fields.height}</span><output data-bmi-value="height" class="ui-type-accent-label text-brand-primary">170 cm</output></span>
              <input data-bmi-input="height" type="range" min="140" max="220" value="170" class="h-2.5 w-full cursor-pointer appearance-none rounded-lg border border-brand-primary/10 bg-brand-primary/10 accent-brand-primary" />
            </label>
            <label class="block space-y-2">
              <span class="flex items-center justify-between gap-4"><span class="ui-type-accent-label text-brand-dark">{t.fields.weight}</span><output data-bmi-value="weight" class="ui-type-accent-label text-brand-primary">70 kg</output></span>
              <input data-bmi-input="weight" type="range" min="40" max="150" value="70" class="h-2.5 w-full cursor-pointer appearance-none rounded-lg border border-brand-primary/10 bg-brand-primary/10 accent-brand-primary" />
            </label>
            <label class="block space-y-2">
              <span class="flex items-center justify-between gap-4"><span class="ui-type-accent-label text-brand-dark">{t.fields.age}</span><output data-bmi-value="age" class="ui-type-accent-label text-brand-primary">30 lat</output></span>
              <input data-bmi-input="age" type="range" min="15" max="80" value="30" class="h-2.5 w-full cursor-pointer appearance-none rounded-lg border border-brand-primary/10 bg-brand-primary/10 accent-brand-primary" />
            </label>
            <label class="block space-y-2">
              <span class="ui-type-accent-label text-brand-dark">{t.fields.activity}</span>
              <select data-bmi-input="activity" class="ui-form-input w-full" aria-label={t.fields.activity}>
                {t.activities.map((activity, index) => <option value={activity.value} selected={index === 0}>{activity.label}</option>)}
              </select>
            </label>
          </div>
        </div>

        <div class="ui-bg-page space-y-6 rounded-2xl border border-brand-dark/10 p-4 sm:p-6 md:p-8">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-brand-dark/10 bg-white p-4 shadow-sm sm:p-5">
              <Text variant="accent-label" class="text-brand-dark/55">{t.results.bmi}</Text>
              <div data-bmi-result="bmi" class="mt-2 font-heading text-4xl font-semibold tracking-tight text-brand-dark">22.9</div>
              <Text tag="p" data-bmi-result="category" variant="accent-label" class="mt-1 text-brand-primary">{t.categories.healthy.label}</Text>
            </div>
            <div class="rounded-2xl border border-brand-primary/20 bg-brand-primary p-4 text-white shadow-sm sm:p-5">
              <Text variant="accent-label" class="text-white/75">{t.results.tdee}</Text>
              <div data-bmi-result="tdee" class="mt-2 font-heading text-4xl font-semibold tracking-tight">1700</div>
              <Text tag="p" variant="accent-label" class="mt-1 text-white/75">{t.results.daily}</Text>
            </div>
          </div>

          <div data-bmi-screen="calculator" class="space-y-6">
            <div class="rounded-2xl border border-brand-primary/15 bg-white p-5 shadow-sm">
              <div class="flex items-center gap-2"><Icon name="lightbulb" weight="regular" class="text-brand-primary" /><Text variant="accent-label" class="text-brand-dark">{t.results.tipTitle}</Text></div>
              <Text tag="p" data-bmi-result="tip" variant="feature-body-sm" class="mt-3 italic leading-relaxed text-brand-dark/65">{t.categories.healthy.tip}</Text>
            </div>
            <Button type="button" data-bmi-lead-start full size="lg">{t.lead.cta} <span data-bmi-cta-kcal>1700</span> kcal</Button>
          </div>

          <div data-bmi-screen="lead" class="hidden space-y-5">
            <div class="flex items-start justify-between gap-4">
              <div><Heading tag="h3" variant="feature-heading-md" class="text-brand-dark">{t.lead.emailTitle}</Heading><Text variant="feature-body-sm" class="mt-2 text-brand-dark/65">{t.lead.emailDescription}</Text></div>
              <button type="button" data-bmi-back class="ui-type-accent-label shrink-0 text-brand-primary underline underline-offset-4">{t.lead.back}</button>
            </div>
            <form data-bmi-lead-form class="space-y-4">
              <input data-bmi-email type="email" required placeholder={t.lead.emailPlaceholder} class="ui-form-input" />
              <Button type="submit" full size="lg">{t.lead.submit}</Button>
            </form>
          </div>

          <div data-bmi-screen="success" class="hidden space-y-5 py-5 text-center">
            <div class="mx-auto flex size-16 items-center justify-center rounded-full border border-brand-primary/20 bg-brand-primary/10 text-brand-primary"><Icon name="check" weight="bold" class="text-3xl" /></div>
            <Heading tag="h3" variant="feature-heading-md" class="text-brand-dark">{t.lead.successTitle}</Heading>
            <Text variant="feature-body-sm" class="text-brand-dark/65">{t.lead.successDescription}</Text>
            <button type="button" data-bmi-again class="ui-type-accent-label text-brand-primary underline underline-offset-4">{t.lead.again}</button>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>

<script is:inline src="/js/bmi-calculator.js"></script>
