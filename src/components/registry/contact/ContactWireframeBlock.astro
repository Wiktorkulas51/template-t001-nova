---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import SectionHeader from "@components/ui/molecules/SectionHeader.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import FormStatus from "@components/ui/patterns/FormStatus.astro";

interface Props {
  class?: string;
  tagline?: string;
  title?: string;
  description?: string;
  phone1?: string;
  phone1Label?: string;
  phone2?: string;
  phone2Label?: string;
  email?: string;
  address?: string;
}

const {
  class: className = "",
  tagline = "Zamów bezpłatną wycenę",
  title = "Porozmawiajmy o Twojej inwestycji",
  description = "Opisz czego potrzebujesz, a przygotuję wycenę dopasowaną do Twojego projektu. Odpowiadam na WhatsApp i telefonicznie.",
  phone1 = "+48 000 000 000",
  phone1Label = "Usługa 1",
  phone2 = "+48 000 000 001",
  phone2Label = "Usługa 2",
  email = "kontakt@przyklad.pl",
  address = "ul. Przykładowa 1, 00-000 Miasto",
} = Astro.props;
---

<Section class:list={["ui-bg-page", className]} id="dcontact">
  <Container>
    <SectionHeader
      tagline={tagline}
      title={title}
      description={description}
      align="center"
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mt-12">
      <div class="bg-white rounded-2xl border border-brand-dark/10 p-6 md:p-8 flex flex-col justify-center">
        <Heading level={3} variant="feature-title" class="mb-1">
          {tagline}
        </Heading>
        <Text variant="body" class="text-brand-dark/60 mb-6">
          {description}
        </Text>

        <form class="space-y-5" action="/api/form-handler.php" method="POST" data-contact-form data-form-msg-original="Wyślij zapytanie" data-form-msg-loading="Wysyłanie wiadomości..." data-form-msg-success="Dziękujemy. Odezwiemy się tak szybko, jak to możliwe." data-form-msg-error="Nie udało się wysłać formularza. Spróbuj ponownie.">
          <div class="hidden" aria-hidden="true">
            <label for="contact-website">Strona internetowa</label>
            <input id="contact-website" type="text" name="_honey" tabindex="-1" autocomplete="off" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-first-name" class="ui-form-label">Imię</label>
              <input id="contact-first-name" type="text" name="first_name" placeholder="Twoje imię" class="ui-form-input" maxlength="80" required />
            </div>
            <div>
              <label for="contact-last-name" class="ui-form-label">Nazwisko</label>
              <input id="contact-last-name" type="text" name="last_name" placeholder="Twoje nazwisko" class="ui-form-input" maxlength="80" required />
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-email" class="ui-form-label">Email</label>
              <input id="contact-email" type="email" name="email" placeholder="twoj@email.pl" class="ui-form-input" maxlength="160" required />
            </div>
            <div>
              <label for="contact-phone" class="ui-form-label">Telefon <span class="text-brand-dark/30">(opcjonalnie)</span></label>
              <input id="contact-phone" type="tel" name="phone" placeholder="+48 123 456 789" class="ui-form-input" maxlength="40" />
            </div>
          </div>
          <div>
            <label for="contact-message" class="ui-form-label">Wiadomość</label>
            <textarea id="contact-message" name="message" rows={4} maxlength="4000" placeholder="Opisz czego dotyczy Twoje zapytanie..." class="ui-form-textarea" required></textarea>
          </div>
          <button
            type="submit"
            class="ui-button ui-type-cta-label group inline-flex h-11 w-full items-center justify-center gap-1.5 rounded-md whitespace-nowrap bg-brand-primary px-5 text-sm text-white shadow-xl shadow-brand-primary/20 transition-all hover:brightness-110 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-primary/50 sm:h-12 sm:px-8 sm:text-lg"
          >
            Wyślij zapytanie
          </button>
          <div class="hidden" data-form-feedback="loading" tabindex="-1">
            <FormStatus type="loading" title="Wysyłanie wiadomości" description="Proszę chwilę poczekać." />
          </div>
          <div class="hidden" data-form-feedback="success" tabindex="-1">
            <FormStatus type="success" title="Wiadomość wysłana" description="Dziękujemy. Odezwiemy się tak szybko, jak to możliwe." />
          </div>
          <div class="hidden" data-form-feedback="error" tabindex="-1">
            <FormStatus type="error" title="Nie udało się wysłać wiadomości" description="Spróbuj ponownie." />
          </div>
          <Text variant="disclaimer" class="text-xs text-center text-brand-dark/40 leading-snug">
            Wysyłając zapytanie, akceptujesz naszą <a href="/polityka-prywatnosci/" class="text-brand-primary/60 hover:text-brand-primary underline transition-colors">politykę prywatności</a>
          </Text>
        </form>
      </div>

      <div class="space-y-6">
        <div class="bg-white rounded-2xl border border-brand-dark/10 p-6 md:p-8">
          <Heading level={3} variant="feature-title" class="mb-6">
            Dane kontaktowe
          </Heading>

          <div class="space-y-6">
            <a href={`tel:${phone1.replace(/\s/g, '')}`} class="flex items-center gap-4 group">
              <div class="w-12 h-12 rounded-xl bg-brand-primary/10 flex items-center justify-center shrink-0 group-hover:bg-brand-primary/20 transition-colors">
                <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-width="2"/>
                </svg>
              </div>
              <div class="min-w-0">
                <Text variant="body" class="font-semibold text-brand-dark">{phone1}</Text>
                <Text variant="body" class="text-brand-dark/50 text-sm">{phone1Label}</Text>
              </div>
            </a>

            <a href={`tel:${phone2.replace(/\s/g, '')}`} class="flex items-center gap-4 group">
              <div class="w-12 h-12 rounded-xl bg-brand-primary/10 flex items-center justify-center shrink-0 group-hover:bg-brand-primary/20 transition-colors">
                <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-width="2"/>
                </svg>
              </div>
              <div class="min-w-0">
                <Text variant="body" class="font-semibold text-brand-dark">{phone2}</Text>
                <Text variant="body" class="text-brand-dark/50 text-sm">{phone2Label}</Text>
              </div>
            </a>

            <a href={`mailto:${email}`} class="flex items-center gap-4 group">
              <div class="w-12 h-12 rounded-xl bg-brand-primary/10 flex items-center justify-center shrink-0 group-hover:bg-brand-primary/20 transition-colors">
                <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-width="2"/>
                </svg>
              </div>
              <div class="min-w-0">
                <Text variant="body" class="font-semibold text-brand-dark break-words">{email}</Text>
                <Text variant="body" class="text-brand-dark/50 text-sm">Email</Text>
              </div>
            </a>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-brand-primary/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-width="2"/>
                  <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-width="2"/>
                </svg>
              </div>
              <div class="min-w-0">
                <Text variant="body" class="font-semibold text-brand-dark">{address}</Text>
                <Text variant="body" class="text-brand-dark/50 text-sm">Adres firmy</Text>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-brand-dark/10 p-6 md:p-8">
          <Heading level={3} variant="feature-title" class="mb-4">
            Godziny pracy
          </Heading>
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-xl bg-brand-primary/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2"/>
                </svg>
              </div>
              <div>
                <Text variant="body" class="text-brand-dark/70">
                  Dostępny telefonicznie w godzinach 8:00 - 20:00
                </Text>
                <Text variant="body" class="text-brand-dark/50 text-sm">
                  Zachęcam do kontaktu przez WhatsApp
                </Text>
              </div>
            </div>
            <div class="border-t border-brand-dark/5 pt-4">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-brand-primary/10 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2"/>
                  </svg>
                </div>
                <div>
                  <Text variant="body" class="text-brand-dark/70">
                    Pilne zlecenia proszę kierować telefonicznie
                  </Text>
                  <Text variant="body" class="text-brand-dark/50 text-sm">
                    Odpowiadam na WhatsApp w ciągu 24h
                  </Text>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <div class="lg:col-span-2 bg-white rounded-2xl border border-brand-dark/10 overflow-hidden">
      <div class="w-full h-72">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15899.5!2d20.908!3d53.742!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x46e2092e76e7739b%3A0x3ae80eebb18230e7!2sNowe%20Kiejkuty!5e0!3m2!1spl!2spl!4v1"
          width="100%"
          height="100%"
          style="border:0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa dojazdu"
        ></iframe>
      </div>
      <div class="px-6 md:px-8 py-4 border-t border-brand-dark/5 flex items-center justify-between flex-wrap gap-2">
        <span class="text-sm self-start text-brand-dark/60">{address}</span>
        <a
          href={`https://www.google.com/maps/place/${encodeURIComponent(address)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-semibold text-brand-primary hover:text-brand-accent transition-colors self-center"
        >
          Otwórz w Google Maps &rarr;
        </a>
      </div>
      </div>
    </div>
  </Container>
</Section>
