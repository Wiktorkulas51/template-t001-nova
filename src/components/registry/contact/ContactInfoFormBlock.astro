---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import Input from "@components/ui/atoms/Input.astro";
import Textarea from "@components/ui/atoms/Textarea.astro";
import FormStatus from "@components/ui/patterns/FormStatus.astro";
import { formatInternalLink } from "@utils/url";
import jsonData from "@data/sections/contact-info-form.json";

// Why: ContactInfoFormBlock is a faithful copy of the "KONTAKT" section from the
// lean-creative project (index.astro, lines 491-600) plus optional card "How the
// first call looks" from the kontakt.astro subpage. Client tokens (border-outline,
// bg-brand-cream, text-on-surface-variant) replaced with global starter kit tokens,
// PNG ornaments removed (decoration), and content entrance taken over by the global
// motion system.
// The form uses the shared handler, and data attributes preserve the individual
// button and message layout of this block.

export interface Props {
  /** Section data; props override default JSON ("props || json" pattern). */
  data?: typeof jsonData;
  /** Content language from JSON. PL is default. */
  locale?: "pl" | "en";
  /** Section heading tag: 'h2' by default, 'h1' when block is first section without hero (SEO). */
  headingTag?: string;
  /** Extra classes on section, e.g. from PageBuilder. */
  class?: string;
}

const { data, locale = "pl", headingTag = "h2", class: className = "" } = Astro.props as Props;

// Why: "props || json" pattern so the block works standalone with section
// data, while PageBuilder or CMS can override the whole content object.
const t = data?.[locale] ?? data?.pl ?? jsonData[locale] ?? jsonData.pl;

// Why: GDPR text contains a link in the middle of the sentence (label "privacy
// policy"). We split the sentence by the link label (case-insensitive,
// regex with escaping) and wrap the phrase in <a>. Same pattern as in ContactForm.
const rodoPattern = new RegExp(t.form.rodoLinkLabel.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i");
const [rodoPrefix = t.form.rodoText, rodoSuffix = ""] = t.form.rodoText.split(rodoPattern);

// Why: external links (e.g. Google map) open in a new tab,
// tel:/mailto: and internal links do not.
const isExternal = (href: string) => href.startsWith("http");
---

<Section id="kontakt" tone="page" class={`relative border-t border-brand-dark/10 scroll-mt-28 ${className}`}>
  <Container>
    <div class="relative py-16">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <!-- Left column: label, heading, description and contact boxes -->
        <div class="flex flex-col gap-6">
          <Text variant="accent-label" tag="p" class="!font-extrabold !tracking-[0.24em] !text-brand-primary">
            {t.eyebrow}
          </Text>
          <Heading tag={headingTag} variant="section-heading-lg" class="!font-extrabold max-w-2xl">
            {t.heading}
          </Heading>
          <Text variant="lead" class="max-w-2xl text-brand-dark/70">
            {t.description}
          </Text>

          <!-- Why: contact boxes faithfully reproduce the client: card
               with icon in a square, label and value-link. Hover boosts
               border and brand shadow (client shadow color is teal,
               replaced with global brand-primary in <style>). -->
          <div class="mt-2 flex flex-col gap-4 py-2 -my-2">
            {t.boxes.map((box) => (
              <div class="group flex items-center gap-4 rounded-md border border-brand-dark/10 bg-white p-4 shadow-soft contact-info-box transition hover:border-brand-primary/30">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-base bg-brand-primary/10 text-brand-primary transition duration-300 group-hover:bg-brand-primary group-hover:text-white">
                  <Icon name={box.icon} size={20} />
                </div>
                <div class="min-w-0">
                  <Text tag="p" variant="body" class="!text-xs !font-bold text-brand-dark/70">
                    {box.label}
                  </Text>
                  <a
                    href={box.href}
                    class="text-sm font-extrabold text-brand-dark transition hover:text-brand-primary"
                    {...(isExternal(box.href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    {box.value}
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- Optional card "How the first call looks" (from kontakt.astro).
               Renders only when JSON has firstCall filled. -->
          {t.firstCall?.heading && (
            <div class="mt-6 rounded-lg border border-brand-dark/10 bg-white p-7 sm:p-10 shadow-soft">
              <Heading level={3} class="!text-lg !font-extrabold">
                {t.firstCall.heading}
              </Heading>
              <Text variant="feature-body-sm" class="mt-3 leading-relaxed text-brand-dark/60">
                {t.firstCall.text}
              </Text>
            </div>
          )}
        </div>

        <!-- Right column: form. Field validation is done by the browser,
             while submission and message states are handled by the shared handler. -->
        <form
          class="flex flex-col gap-4 rounded-lg border border-brand-dark/10 bg-white p-6 sm:p-8 shadow-soft"
          data-form
          data-contact-form
          action="/send-form.php"
          method="POST"
          data-form-msg-original={t.form.submitLabel}
          data-form-msg-loading={t.form.sendingLabel}
          data-form-msg-success={t.form.successText}
          data-form-msg-error={t.form.errorText}
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="flex flex-col gap-1.5">
              <Text tag="span" variant="body" class="!text-xs !font-bold text-brand-dark/70">
                {t.form.nameLabel} <span class="text-brand-primary">*</span>
              </Text>
              <Input
                type="text"
                name="name"
                placeholder={t.form.namePlaceholder}
                required
                class="h-12 rounded-md border border-brand-dark/10 bg-white px-4 text-sm font-semibold text-brand-dark placeholder:text-brand-dark/40 focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/10"
              />
            </label>
            <label class="flex flex-col gap-1.5">
              <Text tag="span" variant="body" class="!text-xs !font-bold text-brand-dark/70">
                {t.form.emailLabel} <span class="text-brand-primary">*</span>
              </Text>
              <Input
                type="email"
                name="email"
                placeholder={t.form.emailPlaceholder}
                required
                class="h-12 rounded-md border border-brand-dark/10 bg-white px-4 text-sm font-semibold text-brand-dark placeholder:text-brand-dark/40 focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/10"
              />
            </label>
          </div>

          <label class="flex flex-col gap-1.5">
            <Text tag="span" variant="body" class="!text-xs !font-bold text-brand-dark/70">
              {t.form.phoneLabel}
            </Text>
            <Input
              type="tel"
              name="phone"
              placeholder={t.form.phonePlaceholder}
              class="h-12 rounded-md border border-brand-dark/10 bg-white px-4 text-sm font-semibold text-brand-dark placeholder:text-brand-dark/40 focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/10"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <Text tag="span" variant="body" class="!text-xs !font-bold text-brand-dark/70">
              {t.form.messageLabel} <span class="text-brand-primary">*</span>
            </Text>
            <Textarea
              name="message"
              placeholder={t.form.messagePlaceholder}
              rows={5}
              required
              class="rounded-md border border-brand-dark/10 bg-white px-4 py-3 text-sm font-semibold text-brand-dark placeholder:text-brand-dark/40 focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/10 resize-y"
            />
          </label>

          <!-- Why: real ui-button structure (wrap text swap, see
               DESIGN_RULES), not btn-slide. Hover is kit standard: ::after fill
               (brand-dark) + text roll. Spinner and sending state are controlled by
               the shared form-handler.js via data-form-submit/spinner/success. -->
          <button
            type="submit"
            class="ui-button ui-button-primary ui-type-cta-label font-semibold text-sm sm:text-base h-12 px-8"
            data-form-submit
          >
            <span class="ui-button-text-wrap">
              <span class="ui-button-text-default" data-form-submit-text>
                {t.form.submitLabel}
              </span>
              <span class="ui-button-text-hover" aria-hidden="true">{t.form.submitLabel}</span>
            </span>
            <span class="absolute inset-0 hidden items-center justify-center gap-2" data-form-spinner>
              <svg class="h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
              </svg>
              <Text tag="span" variant="body" class="!text-sm !font-extrabold">
                {t.form.sendingLabel}
              </Text>
            </span>
          </button>

          <!-- Success message, visible after submission (hidden removed by JS). -->
          <div class="hidden" data-form-feedback="success" data-form-success tabindex="-1">
            <FormStatus type="success" title={t.form.successTitle} description={t.form.successText} />
          </div>

          <div class="hidden" data-form-feedback="error" tabindex="-1">
            <FormStatus type="error" title={t.form.errorTitle} description={t.form.errorText} />
          </div>

          <div class="hidden" data-form-feedback="loading" tabindex="-1">
            <FormStatus type="loading" title={t.form.loadingTitle} description={t.form.loadingText} />
          </div>

          <!-- GDPR note with link in the middle of the sentence. formatInternalLink ensures
               trailing slash for internal links (SEO). -->
          <Text tag="p" variant="body" class="!text-xs leading-relaxed text-brand-dark/60">
            {rodoPrefix}
            <a href={formatInternalLink(t.form.rodoHref)} class="text-brand-primary underline transition hover:text-brand-dark">
              {t.form.rodoLinkLabel}
            </a>
            {rodoSuffix}
          </Text>
        </form>
      </div>
    </div>
  </Container>
</Section>

<style>
  /* Why: hover on contact boxes boosts border and adds brand shadow.
     Client shadow color rgba(0,111,120,0.08) is teal, replaced
     with global brand-primary (color-mix, 12% opacity). */
  .contact-info-box {
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .contact-info-box:hover {
    box-shadow: 0 4px 16px color-mix(in oklab, var(--color-brand-primary) 12%, transparent);
  }

  /* Why: success message appear animation (client used
     lc-fade-in-up; name changed to avoid collisions). */
  @keyframes contact-info-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-info-box {
      transition: none;
    }
    .contact-info-box:hover {
      box-shadow: none;
    }
  }
</style>
