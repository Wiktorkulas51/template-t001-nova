---
// Why: ContactEditorialBlock is a visual copy of the contact section from the
// tom-ros project (v3 "Editorial Rows"): numbered rows 01/02/03 in editorial
// style (Anton) on the left, form in a card with a side red bar on the right.
// Glow, form panel and fonts (Anton, Barlow Condensed) are already in
// core.css / fonts.css of the starter kit, so the block looks identical.
// The form is delegated to the ContactForm molecule, which handles AJAX
// submit via form-handler.js (data-contact-form).
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import ContactForm from "@components/ui/molecules/ContactForm.astro";
import contactData from "@data/sections/contact-editorial.json";

// Why: the ContactForm molecule requires a narrow union of field types, while JSON
// stores types as plain strings. We narrow the type explicitly during mapping.
type ContactField = {
  name: string;
  label: string;
  type: "text" | "email" | "tel" | "number" | "url" | "password" | "date" | "textarea" | "select" | "checkbox";
  required?: boolean;
  placeholder?: string;
  rows?: number;
  autoComplete?: string;
  options?: { value: string; label: string }[];
};

// Why: row labels and social media live in JSON (editable in CMS),
// but block props can override them ("props || json" pattern).
type ContactRowLabels = { phone?: string; email?: string; address?: string; location?: string };

interface Props {
  sectionId?: string;
  title?: string;
  description?: string;
  email?: string;
  phone?: string;
  address?: string;
  social?: { instagram?: string; facebook?: string; labels?: { instagram?: string; facebook?: string } };
  formFields?: ContactField[];
  submitLabel?: string;
  submittingLabel?: string;
  resetLabel?: string;
  successMessage?: string;
  errorMessage?: string;
  formId?: string;
  fieldIdPrefix?: string;
  rows?: { labels?: ContactRowLabels };
  socialLabel?: string;
  /** Section heading tag: 'h2' by default, 'h1' on subpages (SEO). */
  headingTag?: string;
}

const {
  sectionId = "kontakt",
  title = "",
  description = "",
  email = "",
  phone = "",
  address = "",
  social = {},
  formFields = [],
  submitLabel = "",
  submittingLabel = "",
  resetLabel = "",
  successMessage = "",
  errorMessage = "",
  formId = "",
  fieldIdPrefix = "",
  rows: rowsProps = {},
  socialLabel = "",
  headingTag = "h2",
} = Astro.props as Props;

// Why: "props || json" pattern lets PageBuilder override section data while
// JSON remains the default content source.
const resolvedTitle = title || contactData.title || "";
const resolvedDescription = description || contactData.description || "";
const resolvedEmail = email || contactData.email || "";
const resolvedPhone = phone || contactData.phone || "";
const resolvedAddress = address || contactData.address || "";
const resolvedSocial = {
  instagram: social.instagram || contactData.social?.instagram || "",
  facebook: social.facebook || contactData.social?.facebook || "",
  labels: social.labels || contactData.social?.labels || {},
};
const resolvedRows = {
  labels: rowsProps.labels || contactData.rows?.labels || {},
};
const resolvedSocialLabel = socialLabel || contactData.socialLabel || "";

// Why: row labels are read from JSON (rows.labels) with safe fallbacks
// so that a missing field does not break the layout.
const rowsLabels = resolvedRows.labels;
const phoneLabel = rowsLabels.phone || "Telefon";
const emailLabel = rowsLabels.email || "E-mail";
const addressLabel = rowsLabels.location || rowsLabels.address || "Lokalizacja";

// Why: numbered contact rows build an editorial order instead of cards.
// Empty values are filtered out to avoid placeholder links (href="#").
const rows = [
  { key: "phone", label: phoneLabel, href: resolvedPhone ? `tel:${resolvedPhone.replace(/\s+/g, "")}` : "", value: resolvedPhone },
  { key: "email", label: emailLabel, href: resolvedEmail ? `mailto:${resolvedEmail}` : "", value: resolvedEmail },
  { key: "address", label: addressLabel, href: resolvedAddress ? `https://www.google.com/maps?q=${encodeURIComponent(resolvedAddress)}` : "", value: resolvedAddress },
].filter((row) => row.value.trim().length > 0);

// Why: numbering 01/02/03 in Anton is consistent with service numbering
// (FeaturesOfferCardsBlock), building a shared visual language for sections.
const numberedRows = rows.map((row, index) => ({
  ...row,
  num: String(index + 1).padStart(2, "0"),
}));

// Why: social media as circles with logo icons, without text labels
// (iconography is sufficient). Empty links are filtered out.
const socials = [
  { key: "instagram", icon: "instagram-logo", href: resolvedSocial.instagram },
  { key: "facebook", icon: "facebook-logo", href: resolvedSocial.facebook },
].filter((socialItem) => socialItem.href.trim().length > 0);

// Why: form fields from JSON normalized to the molecule union type;
// props take precedence, JSON is the fallback.
const fields: ContactField[] = (
  formFields.length > 0 ? formFields : (contactData.formFields || [])
).map((field) => ({ ...field, type: field.type as ContactField["type"] }));

const resolvedFormId = formId || contactData.formId || `contact-form-${sectionId}`;
const resolvedFieldIdPrefix = fieldIdPrefix || contactData.fieldIdPrefix || sectionId;
const resolvedSubmitLabel = submitLabel || contactData.submitLabel || "";
const resolvedSubmittingLabel = submittingLabel || contactData.submittingLabel || "";
const resolvedResetLabel = resetLabel || contactData.resetLabel || "";
const resolvedSuccessMessage = successMessage || contactData.successMessage || "";
const resolvedErrorMessage = errorMessage || contactData.errorMessage || "";
---

<Section id={sectionId} tone="page" class="relative overflow-hidden py-24 sm:py-32">
  <Container>
    <!-- Why: min-w-0 on columns lets the grid shrink to viewport width
          despite truncate in rows. Glow is anchored to the left column
          (not the section) so it always glows behind rows regardless
          of viewport width, and content (relative) renders above it. -->
    <div class="relative grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
      <!-- Left column: heading + numbered rows + social media -->
      <div class="relative min-w-0">
        <div class="ui-glow ui-glow-contact" aria-hidden="true"></div>
        <div class="relative">
          <Heading
            tag={headingTag}
            variant="section-title"
            class="font-[Anton] text-[clamp(2rem,5vw,4.5rem)] font-normal uppercase leading-[0.9] tracking-[-0.01em] text-brand-dark"
          >
            {resolvedTitle}
          </Heading>

          <!-- Why: description paragraphs as plain text (Text body) to avoid
                stealing hierarchy from the section heading. -->
          {resolvedDescription && (
            <Text variant="body" class="mt-5 max-w-xl text-sm leading-relaxed text-brand-dark/70">
              {resolvedDescription}
            </Text>
          )}

          <!-- Why: rows 01/02/03 - the entire row is a link (tel/mailto/
                Google Maps), and on hover the number and value change color and
                an arrow icon appears, signaling clickability. -->
          <div class="mt-10">
            {numberedRows.map((row) => (
              <a
                href={row.href || "#"}
                class="group flex items-center gap-5 border-b border-brand-dark/15 py-5 transition-colors duration-300 hover:border-brand-primary/40"
              >
                <span
                  aria-hidden="true"
                  class="w-10 shrink-0 font-[Anton] text-2xl font-bold leading-none opacity-60 transition-colors duration-300 group-hover:text-brand-primary"
                >
                  {row.num}
                </span>
                <span class="min-w-0">
                  <span class="block text-xs font-bold uppercase tracking-[0.22em] opacity-60">{row.label}</span>
                  <span class="block truncate text-lg font-semibold text-brand-dark transition-colors duration-300 group-hover:text-brand-primary">
                    {row.value}
                  </span>
                </span>
                <Icon name="arrow-up-right" class="ml-auto shrink-0 text-brand-primary opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
              </a>
            ))}
          </div>

          <!-- Why: social media as compact circles with icons; hover
                highlights the link with accent color (consistent with the rest of the block). -->
          {socials.length > 0 && (
            <div class="mt-8 flex items-center gap-3">
              <span class="text-xs font-bold uppercase tracking-[0.22em] opacity-60">{resolvedSocialLabel}</span>
              {socials.map((socialItem) => (
                <a
                  href={socialItem.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex size-10 items-center justify-center rounded-md border border-brand-dark/15 bg-white text-brand-dark/60 transition-all duration-300 hover:border-brand-primary hover:text-brand-primary"
                  aria-label={resolvedSocial.labels?.[socialItem.key as keyof typeof resolvedSocial.labels] || socialItem.key}
                >
                  <Icon name={socialItem.icon} class="text-lg" />
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Right column: form in card with side red bar -->
      <div class="relative min-w-0">
        <!-- Why: ui-contact-form-panel (inset shadow from core.css) + vertical
              gradient bar on the left + glow in the corner - visual signature of the
              tom-ros copy. Content is relative z-[1], so it renders above decorations. -->
        <div class="ui-contact-form-panel relative overflow-hidden rounded-2xl border border-brand-dark/15 bg-white p-6 sm:p-8">
          <div aria-hidden="true" class="absolute inset-y-0 left-0 w-[3px] bg-gradient-to-b from-brand-primary via-brand-primary/60 to-transparent"></div>
          <div class="ui-contact-form-glow" aria-hidden="true"></div>

          <div class="relative z-[1]">
            <ContactForm
              formId={resolvedFormId}
              fieldIdPrefix={resolvedFieldIdPrefix}
              fields={fields}
              submitLabel={resolvedSubmitLabel}
              submittingLabel={resolvedSubmittingLabel}
              resetLabel={resolvedResetLabel}
              successMessage={resolvedSuccessMessage}
              errorMessage={resolvedErrorMessage}
              showHeader={false}
              includeRodoConsent={false}
            />
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>
