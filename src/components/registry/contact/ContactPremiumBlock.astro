---
// Why: ContactPremiumBlock is a visual copy of the contact section from the Promix project (v1:
// mailto card + FAQ accordion in a grid of 2 columns). The customer color tokens
// (text-on-surface-variant, border-outline) were replaced with GLOBAL BRAND STARTER-KIT tokens,
// the icons <i class="ph"> were replaced with an atom<Icon>, and the customer scroll-reveal was
// removed (the starter-kit has its own motion system). Customer data (email, phone, company name)
// was DELIBERATELY not sent to the library.
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import GradientOrb from "@components/decorations/GradientOrb.astro";
import jsonData from "@data/sections/contact-premium.json";

// Why: the data type comes directly from JSON (pl/en structure with faq), so that the component
// and content cannot move.
type ContactPremiumData = typeof jsonData;

export interface Props {
  /* * Section data; by default JSON from library, props allow you to overwrite from PageBuilder/CMS. */
  data?: ContactPremiumData;
  /* * Content language from JSON. PL is the default language, EN is the English equivalent. */
  locale?: "pl" | "en";
  /** Id kotwicy sekcji. */
  id?: string;
  /* * Section header tag: 'h2' by default, 'h1' when the block is the first section of the page without hero (SEO). */
  headingTag?: string;
  /* * Additional classes per section (e.g. with PageBuilder). */
  class?: string;
}

const { data, locale = "pl", id, headingTag = "h2", class: className = "" } = Astro.props as Props;

// Why: the "props || json" pattern (as in AboutLawBlock), so that the block works independently
// with the section data, and PageBuilder or CMS can overwrite the content.
const t = (data ?? jsonData)[locale] ?? (data ?? jsonData).pl;
const faq = t.faq ?? [];
// Why: formatInternalLink (in Button) treats mailto: like an external link, so href passes
// unchanged. Fallback "#" protects against a dead link.
const mailHref = t.email ? `mailto:${t.email}` : "#";
---

<Section id={id} class:list={["relative", className]}>
  {/* Why: Why: background with two GradientOrb (supports propsy position/size/opacity/blur/color
      like at the customer's) + slot for additional decorations with PageBuilder. */}
  <div class="pointer-events-none absolute inset-0 z-[1] overflow-hidden" aria-hidden="true">
    <GradientOrb position="left" size="45vw" opacity="0.04" blur="0px" />
    <GradientOrb color="var(--color-brand-accent)" position="right" size="35vw" opacity="0.03" blur="0px" />
    <slot name="decorations" />
  </div>

  <Container>
    <div class="relative z-10 mx-auto max-w-4xl">
      <div class="mb-12 text-center md:mb-16">
        {t.eyebrow && (
          <Text variant="accent-label" class="mb-4 block">{t.eyebrow}</Text>
        )}
        {t.heading && (
          <Heading tag={headingTag} variant="section-heading-lg" class="text-balance">
            {t.heading}
          </Heading>
        )}
        {t.description && (
          <Text variant="lead" class="mx-auto mt-5 max-w-xl text-pretty">
            {t.description}
          </Text>
        )}
      </div>

      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2 lg:gap-12">
        {t.email && (
          /* Why: Why: the mailto card uses tokens: border-brand-primary/10,
             bg-white and client arbitrary shadow converted to shadow-soft
             (token --ui-elevation-soft with system design). */
          <div class="relative overflow-hidden rounded-3xl border border-brand-primary/10 bg-white px-8 py-10 shadow-soft">
            <div
              class="pointer-events-none absolute inset-x-0 top-0 z-[-1] h-32 opacity-40"
              style="background: radial-gradient(ellipse 80% 100% at 50% 0%, color-mix(in oklch, var(--color-brand-primary) 18%, transparent) 0%, transparent 70%)"
              aria-hidden="true"
            />
            <div class="mx-auto mb-6 flex size-16 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary">
              <Icon name="envelope-simple" class="text-3xl" />
            </div>
            <Heading tag="h3" variant="feature-title" class="mb-3 text-center text-brand-dark">
              {t.heading || "Napisz do nas"}
            </Heading>
            {t.responseTime && (
              <Text variant="feature-body-sm" class="mb-6 text-center text-brand-dark/60">
                {t.responseTime}
              </Text>
            )}
            <Button href={mailHref} variant="primary" size="lg" class="w-full">
              {t.email}
            </Button>
            {/* Why: Why: client security footer; shield-check does not exist
                in phosphor-min.css, so we use check-circle (it is in the selectors). */}
            <div class="mt-6 flex items-center justify-center gap-2 text-xs text-brand-dark/30">
              <Icon name="check-circle" />
              <span>{t.secureLabel}</span>
            </div>
          </div>
        )}

        {faq.length > 0 && (
          /* Why: Why: accordion FAQ by native<details>/<summary>(without JS),
             border-outline/10 client changed to border-brand-dark/10. */
          <div class="flex flex-col gap-4" data-accordion>
            <Heading tag="h3" variant="feature-title" class="mb-2 text-center text-brand-dark lg:text-left">
              Często zadawane pytania
            </Heading>
            {faq.map((item) => (
              <details class="group rounded-xl border border-brand-dark/10 bg-white shadow-sm">
                <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 text-sm font-medium text-brand-dark transition-colors hover:text-brand-primary">
                  <span>{item.question}</span>
                  <Icon name="caret-down" class="text-lg transition-transform duration-200 group-open:rotate-180" />
                </summary>
                <div class="border-t border-white/40 px-5 pb-5 pt-3">
                  <Text variant="feature-body-sm" class="text-brand-dark/60">
                    {item.answer}
                  </Text>
                </div>
              </details>
            ))}
          </div>
        )}
      </div>
    </div>
  </Container>
</Section>
