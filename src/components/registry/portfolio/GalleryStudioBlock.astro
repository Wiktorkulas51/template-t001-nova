---
// Why: the block is a visual copy of the gallery from the filip-halucha (heinrich) project,
// but the lightbox and slider are based on the global mechanisms of the starter kit. Slider
// (scrolling slides) has its own lightweight JS, while photo preview supports global
// lightbox.js (data-lightbox + data-lightbox-gallery).
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import studio from "@data/sections/gallery-studio.json";

// Why: src is required (JSON always provides it), which simplifies rendering and protects
// against empty lightbox triggers.
interface StudioImage {
  src: string;
  alt?: string;
}

interface Props {
  sectionId?: string;
  heading?: string;
  description?: string;
  images?: StudioImage[];
  /** Section heading tag: 'h2' by default, 'h1' when the block is the first section without hero (SEO). */
  headingTag?: string;
}

const {
  sectionId = "studio",
  heading = "",
  description = "",
  images: rawImages = [],
  headingTag = "h2",
} = Astro.props as Props;

// Why: JSON data is default, and props allow you to overwrite it per page.
const t = studio;
const content = {
  heading: heading || t.heading,
  description: description || t.description,
};
const images = (rawImages.length > 0 ? rawImages : t.images)
  .filter((image: StudioImage) => image?.src)
  .slice(0, 6); // Why: Maximum of 6 items, as per the block contract.
const equipmentItems = t.equipment || [];

// Why: the global lightbox reads data-lightbox-gallery from the trigger itself, so each slide
// carries the full list of photos as JSON (see public/js/lightbox.js).
const lightboxGalleryJson = JSON.stringify(
  images.map((image) => ({
    src: image.src,
    title: image.alt || t.galleryAlt,
    alt: image.alt || t.galleryAlt,
  })),
);
---

<Section id={sectionId} class="relative bg-black py-24 sm:py-32 overflow-hidden">
  <!-- Decorative dots in the corners (copied from heinrich source).
       Radial masks only brighten the corners, leaving the center clean. -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: radial-gradient(circle, rgba(255,255,255,0.15) 1px, transparent 1px); background-size: 32px 32px; mask-image: radial-gradient(ellipse 45% 45% at 0% 0%, black 40%, transparent 70%), radial-gradient(ellipse 45% 45% at 100% 0%, black 40%, transparent 70%), radial-gradient(ellipse 45% 45% at 0% 100%, black 40%, transparent 70%), radial-gradient(ellipse 45% 45% at 100% 100%, black 40%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse 45% 45% at 0% 0%, black 40%, transparent 70%), radial-gradient(ellipse 45% 45% at 100% 0%, black 40%, transparent 70%), radial-gradient(ellipse 45% 45% at 0% 100%, black 40%, transparent 70%), radial-gradient(ellipse 45% 45% at 100% 100%, black 40%, transparent 70%);"
    aria-hidden="true"
  />

  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <Heading tag={headingTag} variant="section-title" class="mt-4 text-white">
        {content.heading}
      </Heading>
      <Text variant="body" class="mt-4 text-neutral-400">
        {content.description}
      </Text>
    </div>

    <!-- Main slider: slides move translateX, autoplay every 3.5s.
         The .ui-gallery-slide class (core.css) provides a smooth transformation transition. -->
    <div class="mt-16" data-gallery-studio>
      <div
        id="gallery-studio-stage"
        class="group relative mx-auto max-w-7xl aspect-[16/9] overflow-hidden rounded-sm"
      >
        {images.map((image, index) => (
          <div
            class="ui-gallery-slide absolute inset-0"
            data-index={index}
            style={{ transform: `translateX(${index * 100}%)` }}
          >
            <div
              class="h-full w-full cursor-zoom-in"
              data-lightbox
              data-href={image.src}
              data-title={image.alt || t.galleryAlt}
              data-lightbox-gallery={lightboxGalleryJson}
            >
              <SmartImage
                src={image.src}
                alt={image.alt || t.galleryAlt}
                width={1600}
                height={900}
                class="ui-gallery-slide-img h-full w-full object-cover grayscale"
              />
            </div>
          </div>
        ))}

        <button
          id="gallery-studio-prev"
          type="button"
          class="absolute left-3 top-1/2 z-10 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white/80 backdrop-blur-sm transition-all hover:bg-black/80 hover:text-white"
          aria-label={t.previousLabel}
        >
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="gallery-studio-next"
          type="button"
          class="absolute right-3 top-1/2 z-10 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white/80 backdrop-blur-sm transition-all hover:bg-black/80 hover:text-white"
          aria-label={t.nextLabel}
        >
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- Thumbnails: clickable, active one highlighted with a frame. Scrollbar hidden
           (ui-scrollbar-thin) so it doesn't spoil the dark aesthetic. -->
      <div class="mx-auto mt-4 max-w-7xl overflow-x-auto ui-scrollbar-thin">
        <div class="flex gap-2 px-1">
          {images.map((image, index) => (
            <button
              type="button"
              data-gallery-studio-thumb
              data-index={index}
              class:list={[
                "shrink-0 size-16 overflow-hidden rounded-sm border-2 transition-all duration-300 hover:opacity-80 sm:size-20",
                index === 0 ? "border-neutral-400 opacity-100" : "border-transparent opacity-50",
              ]}
              aria-label={`${t.goToImageLabelPrefix} ${index + 1}`}
            >
              <SmartImage
                src={image.src}
                alt=""
                width={220}
                height={220}
                class="h-full w-full object-cover grayscale pointer-events-none"
              />
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Dot separator (mixer aesthetics, core.css classes). -->
    <div class="ui-divider ui-divider--dark my-20" aria-hidden="true">
      <span class="ui-divider__dot"></span>
    </div>

    <!-- Equipment grid: categories in 3 columns, elements maintain line breaks. -->
    <div class="mt-16 text-center">
      <h3 class="text-lg font-bold tracking-wide text-white uppercase">{t.equipmentHeading}</h3>
      <div class="mt-10 grid gap-8 sm:grid-cols-3">
        {equipmentItems.map((item) => (
          <div class="mx-auto max-w-60 text-center">
            <h4 class="text-xs tracking-[0.2em] text-neutral-500 uppercase">{item.category}</h4>
            <p class="mt-2 text-sm leading-relaxed text-neutral-400 whitespace-pre-line">{item.items}</p>
          </div>
        ))}
      </div>
    </div>
  </Container>
</Section>

<script is:inline>
  // Why: slider autoplay stops after interaction (prev/next/thumb),
  // and then it is restarted so that the user does not have to wait a full cycle.
  // IIFE + guard on stage prevent double binding (is:inline is not
  // deduplicated by Astro, and the block may appear several times on the page).
  (() => {
    function initGalleryStudio() {
      var stage = document.getElementById("gallery-studio-stage");
      if (!stage || stage.dataset.bound === "1") return;
      stage.dataset.bound = "1";

      var slides = stage.querySelectorAll(".ui-gallery-slide");
      var thumbs = document.querySelectorAll("[data-gallery-studio-thumb]");
      if (slides.length === 0) return;

      var current = 0;
      var total = slides.length;
      var timer = null;

      function show(idx) {
        if (idx < 0 || idx >= total || idx === current) return;

        // Slide offset: the slide with index i lands at position (i - idx).
        slides.forEach(function (slide, i) {
          slide.style.transform = "translateX(" + (i - idx) * 100 + "%)";
        });

        // The active thumbnail gets a frame, the rest remain in shadow.
        thumbs.forEach(function (thumb, i) {
          var isActive = i === idx;
          thumb.classList.toggle("border-neutral-400", isActive);
          thumb.classList.toggle("opacity-100", isActive);
          thumb.classList.toggle("border-transparent", !isActive);
          thumb.classList.toggle("opacity-50", !isActive);
        });

        current = idx;
      }

      function advance() {
        show((current + 1) % total);
      }

      // Why: restarting after interaction gives a full autoplay cycle instead
      // trigger the next slide a split second after clicking.
      function restart() {
        if (timer) clearInterval(timer);
        timer = setInterval(advance, 3500);
      }

      var prevBtn = document.getElementById("gallery-studio-prev");
      var nextBtn = document.getElementById("gallery-studio-next");
      if (prevBtn) prevBtn.addEventListener("click", function () { show((current - 1 + total) % total); restart(); });
      if (nextBtn) nextBtn.addEventListener("click", function () { advance(); restart(); });

      thumbs.forEach(function (thumb) {
        thumb.addEventListener("click", function () {
          var idx = parseInt(thumb.getAttribute("data-index"), 10);
          if (!isNaN(idx)) { show(idx); restart(); }
        });
      });

      show(0);
      restart();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initGalleryStudio);
    } else {
      initGalleryStudio();
    }
  })();
</script>
