---
// Why: the block is a visual copy of the player section from the filip-halucha (heinrich)
// project. Particles floating in the background use the ready-made ui-particle-drift keyframe
// from core.css, so the block does not define its own animation, only inline variables.
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import player from "@data/sections/player-embed.json";

interface Props {
  sectionId?: string;
  heading?: string;
  description?: string;
  embedUrl?: string;
/** Background image below the particle layer, editable through JSON and CMS. */
  backgroundImage?: string;
  /** Section heading tag: 'h2' by default, 'h1' when the block is the first section without hero (SEO). */
  headingTag?: string;
}

const {
  sectionId = "realizacje",
  heading = "",
  description = "",
  embedUrl = "",
  backgroundImage = "",
  headingTag = "h2",
} = Astro.props as Props;

const t = player;
const content = {
  heading: heading || t.heading,
  description: description || t.description,
};
const iframeSrc = embedUrl || t.embedUrl;
const bgImage = backgroundImage || t.backgroundImage || "";

// Why: the particles arrange themselves in a cone symmetrically about the central axis, which
// creates a "stream of light" effect instead of an even noise.
interface Particle {
  x: number;
  y: number;
  size: number;
  opacity: number;
  driftDuration: number;
  dx: string;
  dy: string;
  dx2: string;
  dy2: string;
  delay: number;
}

function buildParticles(): Particle[] {
  const particles: Particle[] = [];
  for (let i = 0; i < 30; i++) {
    const y = 3 + Math.random() * 65;
    const coneSpread = 0.12 + (y / 68) * 0.38;
    const offset = Math.random() * coneSpread * 100;
    const size = 1.5 + Math.random() * 2.5;
    const opacity = 0.2 + Math.random() * 0.4;
    const driftDuration = 7.2 + Math.random() * 8 * 0.9;
    const delay = -Math.random() * 8;
    // Mirror pair: left and right sides of the cone, with a slight height spread.
    particles.push(
      {
        x: 50 - offset,
        y,
        size,
        opacity,
        driftDuration,
        dx: (10 - Math.random() * 20) + "px",
        dy: (15 + Math.random() * 30) + "px",
        dx2: (20 - Math.random() * 40) + "px",
        dy2: (30 + Math.random() * 50) + "px",
        delay,
      },
      {
        x: 50 + offset,
        y: y + (Math.random() - 0.5) * 8,
        size: size * (0.7 + Math.random() * 0.6),
        opacity: opacity * (0.7 + Math.random() * 0.6),
        driftDuration: 7.2 + Math.random() * 8 * 0.9,
        dx: (10 - Math.random() * 20) + "px",
        dy: (15 + Math.random() * 30) + "px",
        dx2: (20 - Math.random() * 40) + "px",
        dy2: (30 + Math.random() * 50) + "px",
        delay: -Math.random() * 8,
      },
    );
  }
  return particles;
}

const particles = buildParticles();
---

<Section id={sectionId} class="relative bg-neutral-950 py-28 sm:py-40 overflow-hidden">
  <!-- Why: background from the original heinrich (HeinrichPlayerBlock) - a photo of a spotlight
       with top dimming and "moon fade" at the bottom that fades smoothly
       in white of the next section (CTA). Layer order: gradient -> image -> fade. -->
  <div class="absolute inset-0 z-[1] overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/40 to-transparent h-40 z-[3]"></div>
    {bgImage && (
            <img src={bgImage} alt="" width="1600" height="900" class="h-full w-full object-cover opacity-90" loading="lazy" />
    )}
    <!-- Why: two radial "moons" at the bottom corners + a vertical gradient
         in the background color of the next section (#FAFAFA) - it's a smooth transition between
         dark player section and light CTA section, copy from the original. -->
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse 25% 45% at 18% 100%, rgba(250,250,250,0.4) 0%, transparent 80%), radial-gradient(ellipse 25% 45% at 82% 100%, rgba(250,250,250,0.4) 0%, transparent 80%), linear-gradient(180deg, transparent 50%, rgba(250,250,250,0.25) 75%, #FAFAFA 100%);"
    ></div>
  </div>

  <!-- Drift particles: inline position and dimensions, ui-particle-drift animation
       from core.css reads the --ui-particle-* variables. A negative delay spreads the phases. -->
  <div class="absolute inset-0 z-10 overflow-hidden pointer-events-none" aria-hidden="true">
    {particles.map((particle) => (
      <div
        class="absolute rounded-full bg-white"
        style={{
          left: particle.x + "%",
          top: particle.y + "%",
          width: particle.size + "px",
          height: particle.size + "px",
          opacity: 0,
          "--ui-particle-opacity": particle.opacity,
          "--ui-particle-dx": particle.dx,
          "--ui-particle-dy": particle.dy,
          "--ui-particle-dx2": particle.dx2,
          "--ui-particle-dy2": particle.dy2,
          animation: `ui-particle-drift ${particle.driftDuration}s ease-in-out infinite`,
          animationDelay: particle.delay + "s",
          willChange: "transform, opacity",
        }}
      ></div>
    ))}
  </div>

  <Container class="relative z-20">
    <!-- A bright headline on a dark background, consistent with the visuals of the source. -->
    <div class="mx-auto max-w-2xl text-center">
      <Heading tag={headingTag} variant="section-title" class="mt-4 font-light text-white">
        {content.heading}
      </Heading>
      <Text variant="body" class="mx-auto mt-4 max-w-md text-neutral-400">
        {content.description}
      </Text>
    </div>

    <!-- Embedded player frame: tinted glass + subtle glow. -->
    <div class="relative mx-auto mt-14 max-w-2xl">
      <div
        class="absolute inset-x-0 -bottom-8 h-32 pointer-events-none bg-gradient-to-t from-white/5 to-transparent blur-3xl"
        aria-hidden="true"
      ></div>
      <div class="relative overflow-hidden rounded-sm border border-neutral-800 bg-neutral-900/80 shadow-2xl backdrop-blur-sm">
        <iframe
          src={iframeSrc}
          title={t.iframeTitle}
          width="100%"
          height="352"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          style="border-radius: 0; display: block; background: #111;"
        ></iframe>
      </div>
    </div>
  </Container>
</Section>
