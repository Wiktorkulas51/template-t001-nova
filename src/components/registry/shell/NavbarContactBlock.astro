---
// Dlaczego: NavbarContactBlock to samodzielny blok navbaru z paskiem kontaktowym
// (NavbarLawBlock pattern: navbar as a block in registry). A faithful copy of the layout
// klienta marek-jodlowski (Centered + NavbarMainCentered), ale z danymi i
// tokenami starter-kita (brand-*, ui-*, formatInternalLink).
// Why: data comes in fallback props to the block's JSON
// (navbar-contact.json), contact fields have last fallback in company.json
// starter-kita. Zasada "props || json" z biblioteki.
// Why: The main bar is repeated explicitly in both headers (main and
// sticky), because the client used the common NavbarMainCentered component for this purpose,
// whose starter-kit version does not have ui-nav-phone. There is repetition
// conscious and easy to maintain.
import Logo from "@components/ui/atoms/Logo.astro";
import Button from "@components/ui/atoms/Button.astro";
import MobileDrawer from "@components/ui/molecules/Navbar/shared/MobileDrawer.astro";
import MenuToggle from "@components/ui/molecules/Navbar/shared/MenuToggle.astro";
import ContactBar from "@components/ui/molecules/Navbar/shared/ContactBar.astro";
import { formatInternalLink } from "@utils/url";
import navbarContactData from "@data/sections/navbar-contact.json";
import companyData from "@data/global/company.json";

interface MenuItem {
	label: string;
	href: string;
}

interface Props {
	menu?: MenuItem[];
	cta?: { label: string; href: string; hoverText?: string };
	phone?: string;
	email?: string;
	city?: string;
	hours?: string;
	socials?: { facebook?: string };
	class?: string;
}

const {
	menu = navbarContactData.menu,
	cta = navbarContactData.cta,
	phone = navbarContactData.phone || companyData.phone,
	email = navbarContactData.email || companyData.email,
	city = navbarContactData.city || companyData.city,
	hours = navbarContactData.hours || companyData.hours,
	socials = navbarContactData.socials,
	class: className,
} = Astro.props;

// Why: fallback chain for Facebook, props first, then JSON
// block, at the end of company.json. We treat an empty string as no link.
const facebookUrl =
	socials?.facebook || navbarContactData.socials?.facebook || companyData.socials?.facebook || "";

// Why: phone label ("Call now") read from JSON (SSOT for CMS),
// so that the content is not hardcoded in the component.
const phoneLabel = navbarContactData.phoneLabel || "Zadzwoń teraz";

// Dlaczego: numer telefonu bez spacji w href (tel: nie lubi spacji).
const phoneHref = `tel:${(phone || "").replace(/\s/g, "")}`;
---

<header
	data-site-header
	transition:animate="none"
	class:list={[
		"ui-navcontact relative z-[1000] w-full overflow-hidden bg-white transition-all duration-300",
		"nav-transparent",
		className,
	]}
>
	<ContactBar city={city} email={email} hours={hours} facebookUrl={facebookUrl} />

	<div class="ui-container ui-nav-main relative flex items-center justify-between lg:justify-center">
		<a
			href={formatInternalLink("/")}
			class="relative z-[1010] flex items-center transition-colors duration-300 lg:absolute lg:left-[var(--spacing-container-px)] lg:top-1/2 lg:-translate-y-1/2"
		>
			<Logo variant="inherit" density="compact" />
		</a>

		<nav
			class="hidden items-center gap-6 lg:flex lg:flex-1 lg:justify-center lg:gap-8 xl:gap-10 lg:-translate-x-8"
			aria-label="Nawigacja główna"
		>
			{menu.map((item) => (
				<a
					href={formatInternalLink(item.href)}
					class="ui-nav-bar-link flex items-center text-inherit opacity-75 hover:text-brand-accent hover:opacity-100"
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="relative z-[1010] flex items-center gap-3 lg:gap-4 lg:absolute lg:right-[var(--spacing-container-px)] lg:top-1/2 lg:-translate-y-1/2">
			<a href={phoneHref} class="ui-nav-phone hidden xl:flex">
				<span class="ui-nav-phone-label">{phoneLabel}</span>
				<span>{phone}</span>
			</a>
			<Button href={cta.href} variant="primary" hoverText={cta.hoverText} class="ui-nav-cta hidden sm:flex">
				{cta.label}
			</Button>
			<MenuToggle />
		</div>
	</div>
</header>

<!-- Why: the second header entering from the top on a scroll (sticky). Hidden
     przez translateY(-100%) w style inline, JS w tym komponencie pokazuje go
     po przekroczeniu progu. -->
<header
	data-sticky-header
	transition:animate="none"
	class="ui-navcontact fixed top-0 left-0 z-[999] w-full bg-white transition-all duration-[400ms]"
	style="transform: translateY(-100%)"
>
	<div class="ui-container ui-nav-main relative flex items-center justify-between lg:justify-center">
		<a
			href={formatInternalLink("/")}
			class="relative z-[1010] flex items-center transition-colors duration-300 lg:absolute lg:left-[var(--spacing-container-px)] lg:top-1/2 lg:-translate-y-1/2"
		>
			<Logo variant="inherit" density="compact" />
		</a>

		<nav
			class="hidden items-center gap-6 lg:flex lg:flex-1 lg:justify-center lg:gap-8 xl:gap-10 lg:-translate-x-8"
			aria-label="Nawigacja główna"
		>
			{menu.map((item) => (
				<a
					href={formatInternalLink(item.href)}
					class="ui-nav-bar-link flex items-center text-inherit opacity-75 hover:text-brand-accent hover:opacity-100"
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="relative z-[1010] flex items-center gap-3 lg:gap-4 lg:absolute lg:right-[var(--spacing-container-px)] lg:top-1/2 lg:-translate-y-1/2">
			<a href={phoneHref} class="ui-nav-phone hidden xl:flex">
				<span class="ui-nav-phone-label">{phoneLabel}</span>
				<span>{phone}</span>
			</a>
			<Button href={cta.href} variant="primary" hoverText={cta.hoverText} class="ui-nav-cta hidden sm:flex">
				{cta.label}
			</Button>
			<MenuToggle />
		</div>
	</div>
</header>

<MobileDrawer />

<script is:inline>
	// Why: sticky header enters after exceeding the 200px threshold (under the bar
	// contact and hero). Scroll is handled by requestAnimationFrame,
	// so as not to have to do work on every scroll event (performance).
	// Drawer and is-scrolled supports global navbar.js with Layout.astro.
	(function () {
		var stickyHeader = document.querySelector('[data-sticky-header]');
		if (!stickyHeader) return;

		var rafId = 0;
		function onScroll() {
			if (rafId) return;
			rafId = requestAnimationFrame(function () {
				var scrolled = window.pageYOffset > 200;
				stickyHeader.style.transform = scrolled
					? 'translateY(0)'
					: 'translateY(-100%)';
				rafId = 0;
			});
		}

		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	})();
</script>

<style>
	/* Why: shadow under navbars by color-mix to react to the theme
    (brand-dark instead of hardcoded rgba). The same for both headers.*/
	.ui-navcontact {
		box-shadow: 0 8px 30px -12px color-mix(in oklab, var(--color-brand-dark) 18%, transparent);
	}

	/* Why: nav-transparent in starter kit gives white text (overlay on
    hero). This block has a solid bg-white background, so we're bringing back the dark text,
    just like theme Marek-Jodlowski did for the client. Rules are scoped,
    so they don't spoil other navbars.*/
	.nav-transparent:not(.is-scrolled) {
		color: var(--color-brand-dark);
	}

	.nav-transparent:not(.is-scrolled) a:not(.bg-brand-primary) {
		color: var(--color-brand-dark);
	}

	/* Why: minimum height of the main bar, consistent with the client's layout.*/
	.ui-nav-main {
		min-height: 5rem;
	}

	/* Why: the phone in the main bar is a couplet (label + number),
    arranged in a column. min-width/min-height 0 because global link styles
    they provide a minimum of 44px (touch target), what matters here is the layout.*/
	a.ui-nav-phone {
		display: inline-flex;
		min-width: 0;
		min-height: 0;
		padding: 0;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.125rem;
		color: var(--color-brand-dark);
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.15;
		transition: color 300ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	a.ui-nav-phone:hover {
		color: var(--color-brand-primary);
	}

	/* Dlaczego: na hover numer dostaje akcent, a etykieta wraca do ciemnego,
    opposite to that in the resting state (interaction emphasis).*/
	a.ui-nav-phone:hover .ui-nav-phone-label {
		color: var(--color-brand-dark);
	}

	.ui-nav-phone-label {
		color: var(--color-brand-primary);
		font-size: 0.625rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
</style>
