---
// Dlaczego: FooterContactBlock to rozbudowana stopka z panelem kontaktowym
// (visual pattern from the project by Marek Jodlowski). Panel with four groups
// (Contact, Hours, Location, Quote) displays the most important company data
// immediately at the bottom of the page, and the grid of links leads to subpages and documents.
// The values ​​from JSON are GENERAL starter-kit data, zero customer data.
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import footerJson from "@data/sections/footer-contact.json";
import companyData from "@data/global/company.json";
import { formatInternalLink } from "@utils/url";

const company = companyData;

export interface FooterContact {
	email?: string;
	phone?: string;
	hours?: string;
	saturday?: string;
	city?: string;
	region?: string;
	pricing?: string[];
	social?: {
		facebook?: string;
		googleMaps?: string;
	};
	quickLinks?: { label: string; href: string }[];
}

export interface Props {
	// Why: the footer does not have a section ID (it appears on every subpage),
	// that's why we use class instead of sectionId for PageBuilder variants.
	class?: string;
	// Why: prop reserved for language variants (HeroTomRos pattern).
	// Currently, the content in JSON is in Polish, so lang does not change the rendering.
	lang?: "pl" | "en";
	description?: string;
	contact?: FooterContact;
	legal?: { label: string; href: string }[];
}

const {
	class: className = "",
	lang = "pl",
	description,
	contact: contactProps,
	legal: legalProps,
} = Astro.props as Props;

// Why: data priority: props (CMS/PageBuilder) overwrite JSON,
// JSON nadpisuje dane globalne firmy. Ten sam wzorzec co HeroTomRos.
const contact = contactProps ?? footerJson.contact ?? {};
const contactEmail = contact.email ?? company.email ?? "";
const contactPhone = contact.phone ?? company.phone ?? "";
const contactHours = contact.hours ?? "Pon - Pt: 08:00 - 16:00";
const contactSaturday = contact.saturday ?? "Soboty: Do ustalenia";
const contactCity = contact.city ?? company.city ?? "";
const contactRegion = contact.region ?? "";
const contactPricing = contact.pricing ?? ["Darmowa wycena", "Profesjonalne doradztwo"];
const socialFacebook = contact.social?.facebook || company.socials?.facebook || "#";
const socialGoogleMaps = contact.social?.googleMaps || "#";
const quickLinks = contact.quickLinks ?? [];
const legalLinks = legalProps ?? footerJson.legal ?? [];
const footerDescription = description ?? footerJson.description ?? company.fullName;

// Why: we read group and navigation labels from JSON (labels) for content
// were editable by CMS (SSOT) and not hardcoded in the component.
const labels = footerJson.labels ?? {};
---

<footer class:list={["border-t-2 border-brand-dark/10 bg-brand-light text-brand-dark rounded-t-[1.75rem]", className]}>
	<style>
		/* Why: The footer grid is built from one column on mobile
     and three from 48, identical to the original (Marek Jodlowski).
		   Surowe CSS, bo Tailwind grid-cols-3 nie daje breakpointa 48rem. */
		.footer-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		@media (min-width: 48rem) {
			.footer-grid {
				grid-template-columns: 1fr 1fr 1fr;
			}
		}

		/* Why: Group labels (Contact, Hours, etc.) do not break
		   w dwie linie, tak jak w oryginalnym core.css klienta. */
		.footer-contact-label {
			display: inline-block;
			white-space: nowrap;
		}

		/* Why: The description column is limited in width to accommodate long text
     it did not extend to the entire footer (max-width 23rem from the original).*/
		.footer-about-column {
			max-width: 23rem;
		}

		/* Note: The original client core.css also contained rules
		   .footer-contact-panel a { min-height: 0 !important; }
     fixing the global link style of this project. Starter kit
     there is no such global link style, so the hack is unnecessary
		   i celowo go nie kopiujemy. */
	</style>
	<div class="ui-container py-8 sm:py-10">
		<!-- Why: The contact panel is a white card with four groups
       (2 columns for sm, 4 for lg). We build the shadow from the brand-dark token
		     przez color-mix, bo rgba(13,35,66,0.18) jest twardym kolorem
       from the client's project, and here brand-dark changes with design token.-->
		<div class="footer-contact-panel grid gap-8 rounded-[1.75rem] border border-brand-dark/10 bg-white p-8 text-brand-dark shadow-[0_24px_48px_-24px_color-mix(in_oklab,var(--color-brand-dark)_18%,transparent)] sm:grid-cols-2 lg:grid-cols-4 lg:gap-6 lg:p-10">
			<!-- Grupa 1: Kontakt (email + telefon jako linki). -->
			<div class="group flex gap-3">
				<span class="flex shrink-0 items-center justify-center">
					<Icon name="phone" size={20} class="flex size-14 items-center justify-center rounded-[1rem] bg-brand-dark/10 text-brand-dark shadow-[0_0.5rem_1rem_color-mix(in_oklab,var(--color-brand-dark)_12%,transparent)] transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.08]" />
				</span>
				<div class="space-y-1">
					<span class="footer-contact-label inline-block whitespace-nowrap text-sm font-bold uppercase tracking-[0.08em] text-brand-dark">{labels.contact}</span>
					<a href={`mailto:${contactEmail}`} class="block text-sm text-brand-dark/70 transition-colors hover:text-brand-primary">{contactEmail}</a>
					<a href={`tel:${contactPhone.replace(/\s/g, "")}`} class="block text-sm text-brand-dark/70 transition-colors hover:text-brand-primary">{contactPhone}</a>
				</div>
			</div>

			<!-- Group 2: Working hours (week + Saturdays).-->
			<div class="group flex gap-3">
				<span class="flex shrink-0 items-center justify-center">
					<Icon name="clock" size={20} class="flex size-14 items-center justify-center rounded-[1rem] bg-brand-dark/10 text-brand-dark shadow-[0_0.5rem_1rem_color-mix(in_oklab,var(--color-brand-dark)_12%,transparent)] transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.08]" />
				</span>
				<div class="space-y-1">
					<span class="footer-contact-label inline-block whitespace-nowrap text-sm font-bold uppercase tracking-[0.08em] text-brand-dark">{labels.hours}</span>
					<Text variant="body" class="text-sm text-brand-dark/70">{contactHours}</Text>
					<Text variant="body" class="text-sm text-brand-dark/70">{contactSaturday}</Text>
				</div>
			</div>

			<!-- Grupa 3: Lokalizacja (miasto + region). -->
			<div class="group flex gap-3">
				<span class="flex shrink-0 items-center justify-center">
					<Icon name="map-pin" size={20} class="flex size-14 items-center justify-center rounded-[1rem] bg-brand-dark/10 text-brand-dark shadow-[0_0.5rem_1rem_color-mix(in_oklab,var(--color-brand-dark)_12%,transparent)] transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.08]" />
				</span>
				<div class="space-y-1">
					<span class="footer-contact-label inline-block whitespace-nowrap text-sm font-bold uppercase tracking-[0.08em] text-brand-dark">{labels.location}</span>
					<Text variant="body" class="text-sm text-brand-dark/70">{contactCity}</Text>
					<Text variant="body" class="text-sm text-brand-dark/70">{contactRegion}</Text>
				</div>
			</div>

			<!-- Group 4: Quotation (list of points encouraging contact).-->
			<div class="group flex gap-3">
				<span class="flex shrink-0 items-center justify-center">
					<Icon name="chat-circle" size={20} class="flex size-14 items-center justify-center rounded-[1rem] bg-brand-dark/10 text-brand-dark shadow-[0_0.5rem_1rem_color-mix(in_oklab,var(--color-brand-dark)_12%,transparent)] transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.08]" />
				</span>
				<div class="space-y-1">
					<span class="footer-contact-label inline-block whitespace-nowrap text-sm font-bold uppercase tracking-[0.08em] text-brand-dark">{labels.pricing}</span>
					{contactPricing.map((item) => (
						<Text variant="body" class="text-sm text-brand-dark/70">{item}</Text>
					))}
				</div>
			</div>
		</div>

		<!-- Why: Links section below the panel, separated by a thin line.
		     border-outline z klienta zamieniamy na border-brand-dark/10,
		     czyli globalny token linii starter-kita. -->
		<div class="mt-8 border-t border-brand-dark/10 px-8 pt-8 sm:pt-10 lg:px-10">
			<div class="footer-grid">
				<!-- The social links use project tokens so every theme keeps sufficient contrast. -->
				<div class="footer-about-column space-y-4 flex flex-col items-center text-center sm:items-start sm:text-left">
					<Text variant="body" class="text-brand-dark/60">
						{footerDescription}
					</Text>
					<div class="flex items-center gap-3">
						<a
							href={socialFacebook}
							target="_blank"
							rel="noopener"
							class="flex size-9 items-center justify-center rounded-xl border border-brand-dark/10 text-brand-dark/50 transition-all duration-300 hover:border-brand-primary/30 hover:bg-brand-primary/10 hover:text-brand-primary"
							aria-label="Facebook"
						>
							<Icon name="facebook-logo" size={18} />
						</a>
						<a
							href={socialGoogleMaps}
							target="_blank"
							rel="noopener"
							class="flex size-9 items-center justify-center rounded-xl border border-brand-dark/10 text-brand-dark/50 transition-all duration-300 hover:border-brand-primary/30 hover:bg-brand-primary/10 hover:text-brand-primary"
							aria-label="Google Maps"
						>
							<Icon name="map-pin" size={18} />
						</a>
					</div>
				</div>

				<!-- Kolumna 2: szybkie linki nawigacyjne. formatInternalLink
				     dodaje trailing slash, zgodnie z zasadami starter-kita. -->
				<nav aria-label="Szybkie linki" class="justify-self-center text-center sm:justify-self-center">
					<span class="mb-3 block text-sm font-semibold uppercase tracking-[0.12em] text-brand-dark/45">{labels.quickLinks}</span>
					<ul class="flex flex-col items-center gap-2">
						{quickLinks.map((item) => (
							<li>
								<a
									href={formatInternalLink(item.href)}
									class="text-sm text-brand-dark/55 transition-colors hover:text-brand-primary"
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>

				<!-- Kolumna 3: linki prawne (polityka, regulamin, cookies). -->
				<nav aria-label="Linki prawne" class="justify-self-center text-center sm:justify-self-end sm:text-right">
					<span class="mb-3 block text-sm font-semibold uppercase tracking-[0.12em] text-brand-dark/45">{labels.legal}</span>
					<ul class="flex flex-col items-center gap-2 sm:items-end">
						{legalLinks.map((item) => (
							<li>
								<a
									href={formatInternalLink(item.href)}
									class="text-sm text-brand-dark/55 transition-colors hover:text-brand-primary"
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</div>

		<!-- Bottom bar: copyright with the full company name + WebScale attribution.
		     variant="disclaimer" istnieje w Text.astro starter-kita. -->
		<div class="mt-8 border-t border-brand-dark/10 pt-5 sm:flex sm:items-center sm:justify-between sm:gap-6">
			<Text variant="disclaimer" class="not-italic text-brand-dark/45">
				© {`${new Date().getFullYear()} ${company.fullName}`}. {labels.rightsReserved}
			</Text>
			<Text variant="disclaimer" class="not-italic text-brand-dark/45">
				{labels.realization} <a href="https://webscale.pro" target="_blank" rel="noopener" class="text-brand-primary hover:underline">{labels.webscale}</a>
			</Text>
		</div>
	</div>
</footer>
