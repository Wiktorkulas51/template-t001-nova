---
import Icon from '@components/ui/atoms/Icon.astro';

const formDebugUrl = new URL(Astro.url);
formDebugUrl.searchParams.set('formDebug', '1');
---

<aside id="developer-tools-dock" aria-label="Narzędzia developerskie">
  <div class="developer-tools-shell" data-dev-tools>
    <button
      type="button"
      id="developer-tools-trigger"
      class="developer-tools-trigger"
      aria-expanded="false"
      aria-controls="developer-tools-panel"
    >
      <span class="developer-tools-trigger-icon" aria-hidden="true"><Icon name="terminal-window" /></span>
      <span class="developer-tools-trigger-copy">
        <span class="developer-tools-trigger-label">DEV</span>
        <span class="developer-tools-trigger-caption">Tools</span>
      </span>
      <Icon name="caret-up" class="developer-tools-trigger-caret" aria-hidden="true" />
      <span class="sr-only">Otwórz narzędzia developerskie</span>
    </button>

    <div id="developer-tools-panel" class="developer-tools-panel" aria-hidden="true">
      <div class="developer-tools-panel-header">
        <div>
          <p class="developer-tools-eyebrow">Local workspace</p>
          <h2>Developer tools</h2>
        </div>
        <span class="developer-tools-status">DEV</span>
      </div>

      <nav aria-label="Narzędzia developerskie">
        <p class="developer-tools-heading">Testowanie</p>
        <a class="developer-tools-link" href={formDebugUrl.toString()}>
          <span class="developer-tools-link-icon"><Icon name="bug" aria-hidden="true" /></span>
          <span class="developer-tools-link-copy"><strong>Debuguj formularz</strong><small>Stany loading, sukces i błąd</small></span>
          <Icon name="arrow-up-right" class="developer-tools-link-arrow" aria-hidden="true" />
        </a>
        <a class="developer-tools-link" href="/dev/components/thumbnail/toast-feedback/default/">
          <span class="developer-tools-link-icon"><Icon name="chat-circle-dots" aria-hidden="true" /></span>
          <span class="developer-tools-link-copy"><strong>Preview toastu</strong><small>Komunikaty globalne</small></span>
          <Icon name="arrow-up-right" class="developer-tools-link-arrow" aria-hidden="true" />
        </a>
        <a class="developer-tools-link" href="/dev/components/thumbnail/pattern-form-statuses/default/">
          <span class="developer-tools-link-icon"><Icon name="check-circle" aria-hidden="true" /></span>
          <span class="developer-tools-link-copy"><strong>Stany formularza</strong><small>Inline statusy i warianty</small></span>
          <Icon name="arrow-up-right" class="developer-tools-link-arrow" aria-hidden="true" />
        </a>

        <p class="developer-tools-heading developer-tools-heading-spaced">Biblioteki</p>
        <a class="developer-tools-link" href="/dev/components/">
          <span class="developer-tools-link-icon"><Icon name="squares-four" aria-hidden="true" /></span>
          <span class="developer-tools-link-copy"><strong>Biblioteka komponentów</strong><small>Atomy, molekuły i wzorce</small></span>
          <Icon name="arrow-up-right" class="developer-tools-link-arrow" aria-hidden="true" />
        </a>
        <a class="developer-tools-link" href="/dev/components/library/">
          <span class="developer-tools-link-icon"><Icon name="stack" aria-hidden="true" /></span>
          <span class="developer-tools-link-copy"><strong>Biblioteka bloków</strong><small>Gotowe sekcje strony</small></span>
          <Icon name="arrow-up-right" class="developer-tools-link-arrow" aria-hidden="true" />
        </a>
      </nav>
    </div>
  </div>
</aside>

<script is:inline src="/js/developer-tools-dock.js"></script>

<style>
  #developer-tools-dock { position: fixed; inset-inline-start: 1rem; inset-block-end: 1rem; z-index: 1998; font-family: var(--font-sans, sans-serif); }
  .developer-tools-shell { position: relative; }
  .developer-tools-trigger { display: inline-flex; align-items: center; gap: 0.625rem; min-height: 2.75rem; padding: 0.375rem 0.625rem 0.375rem 0.5rem; border: 1px solid color-mix(in oklab, var(--color-brand-light) 18%, transparent); border-radius: 0.875rem; background: color-mix(in oklab, var(--color-brand-dark) 94%, transparent); color: var(--color-brand-light); box-shadow: 0 1rem 2.5rem color-mix(in oklab, var(--color-brand-dark) 22%, transparent); cursor: pointer; transition: background 180ms ease, border-color 180ms ease, transform 180ms ease; }
  .developer-tools-trigger:hover, .developer-tools-trigger:focus-visible, .developer-tools-shell[data-open='true'] .developer-tools-trigger { border-color: color-mix(in oklab, var(--color-brand-primary) 56%, transparent); background: color-mix(in oklab, var(--color-brand-dark) 98%, transparent); outline: none; }
  .developer-tools-trigger:active { transform: translateY(0.0625rem); }
  .developer-tools-trigger-icon { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border-radius: 0.625rem; background: color-mix(in oklab, var(--color-brand-primary) 18%, transparent); color: var(--color-brand-primary); font-size: 1rem; }
  .developer-tools-trigger-copy { display: grid; gap: 0.0625rem; text-align: start; }
  .developer-tools-trigger-label { font: 700 0.6875rem/1 var(--font-sans, sans-serif); letter-spacing: 0.1em; }
  .developer-tools-trigger-caption { color: color-mix(in oklab, var(--color-brand-light) 58%, transparent); font-size: 0.625rem; line-height: 1; }
  .developer-tools-trigger-caret { margin-inline-start: 0.25rem; color: color-mix(in oklab, var(--color-brand-light) 56%, transparent); font-size: 0.75rem; transition: transform 180ms ease; }
  .developer-tools-shell[data-open='true'] .developer-tools-trigger-caret { transform: rotate(180deg); }
  .developer-tools-panel { position: absolute; inset-inline-start: 0; inset-block-end: calc(100% + 0.625rem); width: min(20rem, calc(100vw - 2rem)); padding: 0.75rem; border: 1px solid color-mix(in oklab, var(--color-brand-dark) 12%, transparent); border-radius: 1rem; background: color-mix(in oklab, var(--color-brand-light) 94%, transparent); box-shadow: 0 1.5rem 3rem color-mix(in oklab, var(--color-brand-dark) 18%, transparent); backdrop-filter: blur(1rem); opacity: 0; pointer-events: none; transform: translateY(0.5rem) scale(0.98); transform-origin: bottom left; transition: opacity 180ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1), visibility 180ms ease; visibility: hidden; }
  .developer-tools-shell[data-open='true'] .developer-tools-panel { opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); visibility: visible; }
  .developer-tools-panel-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 0.25rem 0.375rem 0.75rem; }
  .developer-tools-eyebrow, .developer-tools-heading { margin: 0; color: color-mix(in oklab, var(--color-brand-dark) 52%, transparent); font-size: 0.625rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .developer-tools-panel h2 { margin: 0.25rem 0 0; color: var(--color-brand-dark); font-size: 1rem; font-weight: 700; letter-spacing: -0.02em; }
  .developer-tools-status { padding-top: 0.125rem; color: var(--color-brand-primary); font: 700 0.625rem/1 var(--font-sans, sans-serif); letter-spacing: 0.1em; }
  .developer-tools-heading-spaced { margin-top: 0.75rem; }
  .developer-tools-link { display: grid; grid-template-columns: 2rem 1fr auto; align-items: center; gap: 0.625rem; padding: 0.5rem 0.375rem; border-radius: 0.625rem; color: var(--color-brand-dark); text-decoration: none; transition: background 160ms ease, transform 160ms ease; }
  .developer-tools-link:hover, .developer-tools-link:focus-visible { background: color-mix(in oklab, var(--color-brand-primary) 9%, transparent); outline: none; transform: translateX(0.125rem); }
  .developer-tools-link-icon { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border: 1px solid color-mix(in oklab, var(--color-brand-dark) 10%, transparent); border-radius: 0.625rem; background: color-mix(in oklab, var(--color-brand-light) 72%, var(--color-brand-dark)); color: color-mix(in oklab, var(--color-brand-dark) 66%, transparent); font-size: 0.875rem; }
  .developer-tools-link-copy { display: grid; gap: 0.125rem; min-width: 0; }
  .developer-tools-link-copy strong { overflow: hidden; color: var(--color-brand-dark); font-size: 0.75rem; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
  .developer-tools-link-copy small { overflow: hidden; color: color-mix(in oklab, var(--color-brand-dark) 55%, transparent); font-size: 0.625rem; text-overflow: ellipsis; white-space: nowrap; }
  .developer-tools-link-arrow { color: color-mix(in oklab, var(--color-brand-dark) 42%, transparent); font-size: 0.75rem; }
  @media (max-width: 639px) { #developer-tools-dock { inset-inline-start: 0.75rem; inset-block-end: 0.75rem; } .developer-tools-panel { width: min(20rem, calc(100vw - 1.5rem)); } }
  @media (prefers-reduced-motion: reduce) { .developer-tools-trigger, .developer-tools-trigger-caret, .developer-tools-panel, .developer-tools-link { transition: none; } }
</style>
