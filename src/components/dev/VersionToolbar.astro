<div id="vt-bar"><div id="vt-groups"></div></div>

<script>
  import '@styles/version-toolbar.css';
</script>

<script is:inline>
(function() {
  var BAR = 'vt-bar', GRP = 'vt-groups';

  function init() {
    var bar = document.getElementById(BAR);
    var con = document.getElementById(GRP);
    if (!bar || !con) return;

    var show = q('vt');
    if (show !== '1') { bar.style.display = 'none'; return; }
    bar.classList.add('is-visible');

    var groups = document.querySelectorAll('[data-version-group]');
    if (groups.length === 0) { bar.style.display = 'none'; return; }

    bar.style.display = '';
    con.innerHTML = '';
    var state = parseSV();

    groups.forEach(function(g) {
      var name = g.getAttribute('data-version-group');
      var vers = g.querySelectorAll('[data-version]');
      if (vers.length < 2) return;

      var d = document.createElement('div');
      d.className = 'vt-group';

      var lb = document.createElement('span');
      lb.className = 'vt-group-label';
      lb.textContent = name;
      d.appendChild(lb);

      var active = state[name] || vers[0].getAttribute('data-version');

      vers.forEach(function(v) {
        var id = v.getAttribute('data-version');
        v.style.display = (id === active) ? '' : 'none';

        var b = document.createElement('button');
        b.className = 'vt-btn' + (id === active ? ' active' : '');
        b.textContent = v.getAttribute('data-version-label') || id;
        b.setAttribute('data-vt-g', name);
        b.setAttribute('data-vt-v', id);

        b.addEventListener('click', function() {
          vers.forEach(function(x) { x.style.display = 'none'; });
          v.style.display = '';
          d.querySelectorAll('.vt-btn').forEach(function(x) { x.classList.remove('active'); });
          b.classList.add('active');
          state[name] = id;
          writeSV(state);
          document.dispatchEvent(new CustomEvent('vt-change', { detail: { group: name, version: id } }));
        });

        d.appendChild(b);
      });

      con.appendChild(d);
    });

    // CSS toggle groups
    document.querySelectorAll('[data-css-toggle-group]').forEach(function(g) {
      var raw = g.getAttribute('data-css-toggle-presets');
      if (!raw) return;
      var presets;
      try { presets = JSON.parse(raw); } catch(e) { return; }
      if (!Array.isArray(presets) || presets.length < 2) return;

      var sep = document.createElement('span');
      sep.className = 'vt-sep';
      con.appendChild(sep);

      var d = document.createElement('div');
      d.className = 'vt-group';

      var lb = document.createElement('span');
      lb.className = 'vt-group-label';
      lb.textContent = g.getAttribute('data-css-toggle-group');
      d.appendChild(lb);

      presets.forEach(function(p, i) {
        var b = document.createElement('button');
        b.className = 'vt-btn' + (i === 0 ? ' active' : '');
        b.textContent = p.label;
        b.addEventListener('click', function() {
          d.querySelectorAll('.vt-btn').forEach(function(x) { x.classList.remove('active'); });
          b.classList.add('active');
          if (p.props && typeof p.props === 'object') {
            for (var k in p.props) { g.style.setProperty(k, p.props[k]); }
          }
        });
        d.appendChild(b);
      });

      con.appendChild(d);
    });
  }

  function parseSV() {
    var sv = q('sv');
    if (!sv) return {};
    var o = {};
    sv.split(',').forEach(function(p) {
      var parts = p.split(':');
      if (parts.length === 2) o[parts[0]] = parts[1];
    });
    return o;
  }

  function writeSV(s) {
    var pairs = [];
    for (var k in s) pairs.push(k + ':' + s[k]);
    sp('sv', pairs.join(','));
  }

  function q(n) {
    var m = window.location.search.match(new RegExp('[?&]' + n + '=([^&]*)'));
    return m ? decodeURIComponent(m[1].replace(/\+/g, ' ')) : null;
  }

  function sp(n, v) {
    var u = new URL(window.location.href);
    v ? u.searchParams.set(n, v) : u.searchParams.delete(n);
    history.replaceState({}, '', u.toString());
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', init)
    : init();
})();
</script>
