<!--
  FontSwitcherToolbar - A dev-tool for previewing alternative font sets.
  Shared development tool for previewing the bundled font sets.
  Action: radio buttons save the selection to localStorage and set the data-font-set
  to <html>; font sets are defined in src/styles/font-switcher.css.
  font-switcher.css is linked from Layout in the document head, because the
  selected font must be styled before the page body is painted.
-->
<div id="fst" class="fst" aria-label="Przełącznik fontów">
  <button class="fst__trigger" id="fst-trigger" aria-expanded="false" aria-controls="fst-panel">
    <span class="fst__icon">Aa</span>
  </button>
  <div class="fst__panel" id="fst-panel" role="radiogroup" aria-label="Zestaw fontów" hidden>
    <div class="fst__header">Fonty</div>
    <label class="fst__option" data-fst-value="default">
      <input type="radio" name="fst" value="default" checked class="fst__radio" />
      <span class="fst__dot" style="background:#d4a373"></span>
      <span class="fst__info">
        <span class="fst__name">Domyślny</span>
        <span class="fst__preview" style="font-family:Outfit,sans-serif">Outfit</span>
      </span>
    </label>
    <label class="fst__option" data-fst-value="classic">
      <input type="radio" name="fst" value="classic" class="fst__radio" />
      <span class="fst__dot" style="background:#1457b8"></span>
      <span class="fst__info">
        <span class="fst__name">Klasyczny</span>
        <span class="fst__preview" style="font-family:Georgia,serif">Georgia (serif)</span>
        <span class="fst__sep"> + </span>
        <span class="fst__preview" style="font-family:Outfit,sans-serif">Outfit</span>
      </span>
    </label>
    <label class="fst__option" data-fst-value="editorial">
      <input type="radio" name="fst" value="editorial" class="fst__radio" />
      <span class="fst__dot" style="background:#e63946"></span>
      <span class="fst__info">
        <span class="fst__name">Edytorialny</span>
        <span class="fst__preview" style="font-family:Georgia,serif">Georgia (serif)</span>
        <span class="fst__sep"> + </span>
        <span class="fst__preview" style="font-family:Georgia,serif">serif</span>
      </span>
    </label>
    <label class="fst__option" data-fst-value="minimal">
      <input type="radio" name="fst" value="minimal" class="fst__radio" />
      <span class="fst__dot" style="background:#2d3436"></span>
      <span class="fst__info">
        <span class="fst__name">Minimalny</span>
        <span class="fst__preview" style="font-family:system-ui,sans-serif">system-ui</span>
        <span class="fst__sep"> + </span>
        <span class="fst__preview" style="font-family:Outfit,sans-serif">Outfit</span>
      </span>
    </label>
  </div>
</div>

<style>
  /* Keep the development toolbar isolated from template layout styles. */
  .fst {
    position: fixed;
    bottom: 1rem;
    left: calc(50% + 0.375rem);
    right: auto;
    z-index: 99999;
    font-family: ui-monospace, 'SF Mono', monospace;
    font-size: 0.75rem;
    line-height: 1;
  }
  .fst__trigger {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.85);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    margin-left: auto;
  }
  .fst__trigger:hover {
    background: rgba(0,0,0,0.9);
    transform: scale(1.05);
  }
  .fst__icon {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .fst__panel {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    min-width: 220px;
    background: rgba(20,20,20,0.92);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    padding: 0.5rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .fst__header {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.375rem 0.5rem;
    color: rgba(255,255,255,0.35);
  }
  .fst__option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .fst__option:hover {
    background: rgba(255,255,255,0.06);
  }
  .fst__option.is-active {
    background: rgba(255,255,255,0.1);
  }
  .fst__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .fst__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.15s ease;
  }
  .fst__option.is-active .fst__dot {
    opacity: 1;
  }
  .fst__info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .fst__name {
    color: rgba(255,255,255,0.85);
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .fst__preview {
    display: inline;
    color: rgba(255,255,255,0.4);
    font-size: 0.625rem;
    font-weight: 400;
  }
  .fst__sep {
    color: rgba(255,255,255,0.15);
    font-size: 0.625rem;
  }
</style>

<script is:inline>
(function() {
  var STORAGE_KEY = 'fst-active';

  function getStored() {
    try { return localStorage.getItem(STORAGE_KEY); } catch(e) { return null; }
  }

  function setStored(val) {
    try { localStorage.setItem(STORAGE_KEY, val); } catch(e) {}
  }

  // Sets data-font-set to <html> (CSS in font-switcher.css switches variables
  // --font-sans/--font-heading) and highlights the active option in the panel
  function apply(value) {
    document.documentElement.setAttribute('data-font-set', value);
    setStored(value);
    var labels = document.querySelectorAll('.fst__option');
    labels.forEach(function(el) {
      el.classList.toggle('is-active', el.getAttribute('data-fst-value') === value);
    });
    var radios = document.querySelectorAll('.fst__radio');
    radios.forEach(function(radio) {
      radio.checked = radio.value === value;
    });
  }

  // Initialization: priority is given to the value set on the server (data-font-set on html),
  // then localStorage, finally default
  var serverSet = document.documentElement.getAttribute('data-font-set');
  var initial = serverSet || getStored() || 'default';
  apply(initial);

  // Panel visibility toggle (aria-expanded + hidden)
  document.getElementById('fst-trigger').addEventListener('click', function() {
    var panel = document.getElementById('fst-panel');
    var expanded = this.getAttribute('aria-expanded') === 'true';
    panel.hidden = expanded;
    this.setAttribute('aria-expanded', String(!expanded));
  });

  // Clicking on the label selects a set of fonts
  document.getElementById('fst-panel').addEventListener('click', function(e) {
    var label = e.target.closest('.fst__option');
    if (!label) return;
    var value = label.getAttribute('data-fst-value');
    if (!value) return;
    apply(value);
  });
})();
</script>
